---
const {
  items = [],
} = Astro.props;

function formatDate(
  date = ""
) {
  return date.replaceAll(
    "-",
    "/"
  );
}

const sortedItems = [
  ...items,
].sort(
  (a, b) =>
    (
      b.date ||
      ""
    ).localeCompare(
      a.date ||
        ""
    )
);
---

<section
  class="coffee-section"
  data-coffee-section
>
  <div
    class="coffee-scale-shell"
    data-coffee-scale-shell
  >
    <div
      class="coffee-stage"
      data-coffee-stage
    >
      <div
        class="coffee-list"
        data-coffee-list
      >
        {
          sortedItems.map(
            (item) => (
              <article class="coffee-item">
                <time
                  class="coffee-date"
                  datetime={item.date}
                >
                  {formatDate(item.date)}
                </time>

                <span
                  class="coffee-brand"
                  data-coffee-brand
                >
                  {item.brand}
                </span>

                <span
                  class="coffee-name"
                  data-coffee-name
                >
                  {item.coffeeName}
                </span>

                <span class="coffee-notes">
                  {item.notes}
                </span>
              </article>
            )
          )
        }
      </div>
    </div>
  </div>

  <script>
    const coffeeSection =
      document.querySelector<HTMLElement>(
        "[data-coffee-section]"
      );

    const scaleShell =
      document.querySelector<HTMLElement>(
        "[data-coffee-scale-shell]"
      );

    const coffeeStage =
      document.querySelector<HTMLElement>(
        "[data-coffee-stage]"
      );

    const coffeeList =
      document.querySelector<HTMLElement>(
        "[data-coffee-list]"
      );

    /*
     * type: coffeeでは、
     * Layout内の.fade-scrollが
     * 実際の縦スクロール主体。
     */
    const scrollRoot =
      document.querySelector<HTMLElement>(
        "[data-scroll-root]"
      );

    const brandElements = [
      ...document.querySelectorAll<HTMLElement>(
        "[data-coffee-brand]"
      ),
    ];

    const nameElements = [
      ...document.querySelectorAll<HTMLElement>(
        "[data-coffee-name]"
      ),
    ];

    const visualViewport =
      window.visualViewport;

    const ZOOM_ENTER_THRESHOLD =
      1.02;

    const ZOOM_EXIT_THRESHOLD =
      1.005;

    const ZOOM_EXIT_SETTLE_MS =
      180;

    let layoutFrame = 0;
    let measureFrame = 0;
    let applyFrame = 0;

    let zoomFrame = 0;
    let zoomExitTimer = 0;

    let naturalWidth = 0;
    let naturalHeight = 0;

    let fittedWidth = 0;
    let fittedHeight = 0;
    let fittedScale = 1;

    let isZoomed = false;

    /*
     * 現在、上側と下側へ追加している
     * 動的な閲覧領域。
     *
     * 固定値ではなく、
     * コンテンツ全高とズーム倍率から算出する。
     */
    let currentZoomReserve = 0;

    const getViewportWidth =
      () =>
        visualViewport?.width ||
        window.innerWidth;

    const getViewportScale =
      () =>
        visualViewport?.scale ||
        1;

    const getScrollTop =
      () =>
        scrollRoot?.scrollTop ||
        window.scrollY ||
        0;

    const setScrollTop = (
      value: number
    ) => {
      const nextValue =
        Math.max(
          0,
          value
        );

      if (scrollRoot) {
        scrollRoot.scrollTo({
          top: nextValue,
          behavior: "auto",
        });

        return;
      }

      window.scrollTo({
        top: nextValue,
        behavior: "auto",
      });
    };

    const getMaximumWidth =
      (
        elements: HTMLElement[]
      ) =>
        elements.reduce(
          (
            maximum,
            element
          ) =>
            Math.max(
              maximum,
              element.scrollWidth
            ),
          0
        );

    const getAvailableWidth =
      () => {
        if (!coffeeSection) {
          return Math.max(
            1,
            getViewportWidth()
          );
        }

        const sectionStyle =
          window.getComputedStyle(
            coffeeSection
          );

        const paddingLeft =
          Number.parseFloat(
            sectionStyle.paddingLeft
          ) || 0;

        const paddingRight =
          Number.parseFloat(
            sectionStyle.paddingRight
          ) || 0;

        return Math.max(
          1,
          getViewportWidth() -
            paddingLeft -
            paddingRight
        );
      };

    /*
     * 最長Brandと最長Nameを測定し、
     * 全行へ同じ列幅を適用する。
     */
    const applyDynamicColumns =
      () => {
        if (!coffeeList) {
          return;
        }

        coffeeList.style.setProperty(
          "--coffee-brand-column",
          "max-content"
        );

        coffeeList.style.setProperty(
          "--coffee-name-column",
          "max-content"
        );

        const maximumBrandWidth =
          getMaximumWidth(
            brandElements
          );

        const maximumNameWidth =
          getMaximumWidth(
            nameElements
          );

        coffeeList.style.setProperty(
          "--coffee-brand-column",
          `${Math.ceil(
            maximumBrandWidth
          )}px`
        );

        coffeeList.style.setProperty(
          "--coffee-name-column",
          `${Math.ceil(
            maximumNameWidth
          )}px`
        );
      };

    /*
     * 現在のピンチ倍率に必要な
     * 上下それぞれの追加領域を算出する。
     */
    const calculateZoomReserve =
      (
        viewportScale: number
      ) => {
        if (fittedHeight <= 0) {
          return 0;
        }

        const normalizedScale =
          Math.max(
            1,
            viewportScale
          );

        const zoomedHeight =
          fittedHeight *
          normalizedScale;

        const additionalHeight =
          Math.max(
            0,
            zoomedHeight -
              fittedHeight
          );

        return (
          additionalHeight / 2
        );
      };

    const applyZoomGeometry =
      (
        viewportScale: number
      ) => {
        if (
          !coffeeSection ||
          !scaleShell ||
          fittedHeight <= 0
        ) {
          return;
        }

        const nextReserve =
          calculateZoomReserve(
            viewportScale
          );

        const reserveDelta =
          nextReserve -
          currentZoomReserve;

        const totalLayoutHeight =
          fittedHeight +
          nextReserve * 2;

        currentZoomReserve =
          nextReserve;

        scaleShell.style.setProperty(
          "--coffee-zoom-reserve",
          `${nextReserve}px`
        );

        scaleShell.style.height =
          `${fittedHeight}px`;

        coffeeSection.style.setProperty(
          "--coffee-content-layout-height",
          `${totalLayoutHeight}px`
        );

        if (
          Math.abs(
            reserveDelta
          ) > 0.1
        ) {
          setScrollTop(
            getScrollTop() +
            reserveDelta
          );
        }
      };

    const enterZoomMode =
      () => {
        if (
          isZoomed ||
          fittedHeight <= 0
        ) {
          return;
        }

        isZoomed = true;

        window.clearTimeout(
          zoomExitTimer
        );

        zoomExitTimer = 0;

        applyZoomGeometry(
          getViewportScale()
        );
      };

    const updateZoomMode =
      () => {
        zoomFrame = 0;

        if (!isZoomed) {
          return;
        }

        applyZoomGeometry(
          getViewportScale()
        );
      };

    const scheduleZoomUpdate =
      () => {
        if (zoomFrame) {
          cancelAnimationFrame(
            zoomFrame
          );
        }

        zoomFrame =
          requestAnimationFrame(
            updateZoomMode
          );
      };

    const exitZoomMode =
      () => {
        zoomExitTimer = 0;

        if (
          !isZoomed ||
          getViewportScale() >
            ZOOM_EXIT_THRESHOLD
        ) {
          return;
        }

        const previousReserve =
          currentZoomReserve;

        isZoomed = false;
        currentZoomReserve = 0;

        scaleShell?.style.setProperty(
          "--coffee-zoom-reserve",
          "0px"
        );

        if (fittedHeight > 0) {
          scaleShell!.style.height =
            `${fittedHeight}px`;

          coffeeSection?.style.setProperty(
            "--coffee-content-layout-height",
            `${fittedHeight}px`
          );
        }

        if (
          previousReserve > 0
        ) {
          setScrollTop(
            getScrollTop() -
            previousReserve
          );
        }

        scheduleCoffeeFit();
      };

    const scheduleZoomExit =
      () => {
        window.clearTimeout(
          zoomExitTimer
        );

        zoomExitTimer =
          window.setTimeout(
            exitZoomMode,
            ZOOM_EXIT_SETTLE_MS
          );
      };

    /*
     * Phase 3
     *
     * Phase 2で確定した自然寸法を元に、
     * Coffee全体へ一度だけ共通scaleを適用する。
     */
    const applyMeasuredCoffeeFit =
      () => {
        applyFrame = 0;

        if (
          isZoomed ||
          !coffeeSection ||
          !scaleShell ||
          !coffeeStage
        ) {
          return;
        }

        if (
          naturalWidth <= 0 ||
          naturalHeight <= 0
        ) {
          return;
        }

        fittedScale =
          Math.min(
            1,
            getAvailableWidth() /
              naturalWidth
          );

        fittedWidth =
          naturalWidth *
          fittedScale;

        fittedHeight =
          naturalHeight *
          fittedScale;

        /*
         * Coffee全体へ適用するscaleは
         * この一か所だけ。
         */
        coffeeStage.style.setProperty(
          "--coffee-stage-scale",
          String(
            fittedScale
          )
        );

        scaleShell.style.width =
          `${fittedWidth}px`;

        currentZoomReserve = 0;

        scaleShell.style.setProperty(
          "--coffee-zoom-reserve",
          "0px"
        );

        scaleShell.style.height =
          `${fittedHeight}px`;

        coffeeSection.style.setProperty(
          "--coffee-content-layout-height",
          `${fittedHeight}px`
        );
      };

    /*
     * Phase 2
     *
     * Phase 1の列幅変更をブラウザが
     * レイアウトへ反映した次のフレームで、
     * 自然幅・自然高を測定する。
     */
    const measureCoffeeLayout =
      () => {
        measureFrame = 0;

        if (
          isZoomed ||
          !coffeeStage ||
          !coffeeList
        ) {
          return;
        }

        naturalWidth =
          Math.max(
            coffeeStage.scrollWidth,
            coffeeList.scrollWidth
          );

        naturalHeight =
          Math.max(
            coffeeStage.scrollHeight,
            coffeeList.scrollHeight
          );

        if (
          naturalWidth <= 0 ||
          naturalHeight <= 0
        ) {
          return;
        }

        /*
         * 測定とtransform適用も
         * 同一フレームでは行わない。
         */
        applyFrame =
          requestAnimationFrame(
            applyMeasuredCoffeeFit
          );
      };

    /*
     * Phase 1
     *
     * まずCoffee全体を自然倍率へ戻し、
     * Brand / Name列幅を更新する。
     *
     * ここではまだ最終寸法を測らない。
     */
    const prepareCoffeeLayout =
      () => {
        layoutFrame = 0;

        if (
          isZoomed ||
          !coffeeSection ||
          !scaleShell ||
          !coffeeStage ||
          !coffeeList
        ) {
          return;
        }

        coffeeStage.style.setProperty(
          "--coffee-stage-scale",
          "1"
        );

        applyDynamicColumns();

        /*
         * 列幅変更後のレイアウト確定を
         * 1フレーム待ってから測定する。
         */
        measureFrame =
          requestAnimationFrame(
            measureCoffeeLayout
          );
      };

    /*
     * Coffeeフィット処理の入口。
     *
     * 古い予約済み処理をすべて破棄してから、
     * Phase 1を予約する。
     */
    const scheduleCoffeeFit =
      () => {
        if (isZoomed) {
          return;
        }

        if (layoutFrame) {
          cancelAnimationFrame(
            layoutFrame
          );
        }

        if (measureFrame) {
          cancelAnimationFrame(
            measureFrame
          );
        }

        if (applyFrame) {
          cancelAnimationFrame(
            applyFrame
          );
        }

        layoutFrame = 0;
        measureFrame = 0;
        applyFrame = 0;

        layoutFrame =
          requestAnimationFrame(
            prepareCoffeeLayout
          );
      };

    const handleViewportResize =
      () => {
        const viewportScale =
          getViewportScale();

        if (
          viewportScale >
          ZOOM_ENTER_THRESHOLD
        ) {
          enterZoomMode();
          scheduleZoomUpdate();
          return;
        }

        if (isZoomed) {
          scheduleZoomExit();
          return;
        }

        scheduleCoffeeFit();
      };

    const cleanup = () => {
      if (layoutFrame) {
        cancelAnimationFrame(
          layoutFrame
        );
      }

      if (measureFrame) {
        cancelAnimationFrame(
          measureFrame
        );
      }

      if (applyFrame) {
        cancelAnimationFrame(
          applyFrame
        );
      }

      if (zoomFrame) {
        cancelAnimationFrame(
          zoomFrame
        );
      }

      window.clearTimeout(
        zoomExitTimer
      );

      layoutFrame = 0;
      measureFrame = 0;
      applyFrame = 0;
      zoomFrame = 0;
      zoomExitTimer = 0;

      window.removeEventListener(
        "resize",
        handleViewportResize
      );

      window.removeEventListener(
        "orientationchange",
        handleViewportResize
      );

      visualViewport?.removeEventListener(
        "resize",
        handleViewportResize
      );

      document.removeEventListener(
        "astro:before-swap",
        cleanup
      );
    };

    /*
     * 初回も同じ3段階処理だけを使う。
     *
     * 初回専用の別ルートを作らないことで、
     * dev / productionで処理順が
     * 分岐しないようにする。
     */
    scheduleCoffeeFit();

    /*
     * Webフォント確定後も、
     * 同じ3段階処理でもう一度測定する。
     */
    document.fonts?.ready.then(
      scheduleCoffeeFit
    );

    window.addEventListener(
      "resize",
      handleViewportResize
    );

    window.addEventListener(
      "orientationchange",
      handleViewportResize
    );

    visualViewport?.addEventListener(
      "resize",
      handleViewportResize
    );

    document.addEventListener(
      "astro:before-swap",
      cleanup
    );
  </script>
</section>

<style>
  .coffee-section {
    /*
     * すべてのデバイスで共通。
     */
    --coffee-date-column:
      56px;

    --coffee-date-brand-gap:
      30px;

    --coffee-brand-name-gap:
      16px;

    --coffee-row-gap:
      8px;

    --coffee-item-gap:
      36px;

    --coffee-side-padding:
      clamp(
        24px,
        8vw,
        120px
      );

    --coffee-vertical-padding:
      clamp(
        120px,
        12vh,
        140px
      );

    --coffee-content-layout-height:
      0px;

    min-height:
      max(
        100vh,
        calc(
          var(
            --coffee-content-layout-height
          ) +
          var(
            --coffee-vertical-padding
          ) *
          2
        )
      );

    padding:
      var(
        --coffee-vertical-padding
      )
      var(
        --coffee-side-padding
      );

    background:
      #fff;

    color:
      var(
        --coffee-list-color,
        #555
      );

    font-family:
      var(
        --site-font-family
      );

    -webkit-text-size-adjust:
      none;

    text-size-adjust:
      none;
  }

  .coffee-scale-shell {
    --coffee-zoom-reserve:
      0px;

    position:
      relative;

    box-sizing:
      content-box;

    width:
      max-content;

    height:
      auto;

    padding-top:
      var(
        --coffee-zoom-reserve
      );

    padding-bottom:
      var(
        --coffee-zoom-reserve
      );

    margin:
      0
      auto;
  }

  .coffee-stage {
    --coffee-stage-scale:
      1;

    width:
      max-content;

    color:
      var(
        --coffee-list-color,
        #555
      );

    font-family:
      var(
        --site-font-family
      );

    font-size:
      var(
        --coffee-list-size,
        14px
      );

    font-weight:
      400;

    line-height:
      1.8;

    letter-spacing:
      0.08em;

    -webkit-text-size-adjust:
      none;

    text-size-adjust:
      none;

    transform:
      scale(
        var(
          --coffee-stage-scale
        )
      );

    transform-origin:
      top
      left;

    will-change:
      transform;
  }

  .coffee-list {
    --coffee-brand-column:
      180px;

    --coffee-name-column:
      max-content;

    display:
      flex;

    flex-direction:
      column;

    gap:
      var(
        --coffee-item-gap
      );

    width:
      max-content;

    margin:
      0;
  }

  .coffee-item {
    display:
      grid;

    grid-template-columns:
      var(
        --coffee-date-column
      )
      var(
        --coffee-date-brand-gap
      )
      var(
        --coffee-brand-column
      )
      var(
        --coffee-brand-name-gap
      )
      var(
        --coffee-name-column
      );

    row-gap:
      var(
        --coffee-row-gap
      );

    align-items:
      baseline;

    width:
      max-content;

    font:
      inherit;

    color:
      inherit;

    letter-spacing:
      inherit;
  }

  .coffee-date {
    grid-column:
      1;
  }

  .coffee-brand {
    grid-column:
      3;
  }

  .coffee-name {
    grid-column:
      5;
  }

  .coffee-date,
  .coffee-brand,
  .coffee-name,
  .coffee-notes {
    margin:
      0;

    padding:
      0;

    border:
      0;

    color:
      inherit;

    font:
      inherit;

    letter-spacing:
      inherit;

    -webkit-text-size-adjust:
      none;

    text-size-adjust:
      none;
  }

  .coffee-date,
  .coffee-brand,
  .coffee-name {
    white-space:
      nowrap;
  }

  .coffee-notes {
    display:
      block;

    grid-column:
      1 / -1;

    min-width:
      0;

    width:
      100%;

    white-space:
      pre-line;

    overflow-wrap:
      anywhere;
  }
</style>