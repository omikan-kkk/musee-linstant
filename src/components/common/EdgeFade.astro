---
const {
  horizontal = false,
  fixedHorizontal = false,
} = Astro.props;
---

<div
  class:list={[
    "edge-fade",
    horizontal &&
      "has-horizontal",
    fixedHorizontal &&
      "is-fixed-horizontal",
  ]}
  aria-hidden="true"
>
  <span class="edge-fade-top"></span>
  <span class="edge-fade-bottom"></span>

  <span
    class="edge-fade-left"
    data-edge-fade-left
  ></span>

  <span
    class="edge-fade-right"
    data-edge-fade-right
  ></span>
</div>

{
  fixedHorizontal && (
    <script>
      const leftFade =
        document.querySelector<HTMLElement>(
          "[data-edge-fade-left]"
        );

      const rightFade =
        document.querySelector<HTMLElement>(
          "[data-edge-fade-right]"
        );

      const visualViewport =
        window.visualViewport;

      type ZoomPhase =
        | "idle"
        | "zooming"
        | "resetting";

      let zoomPhase: ZoomPhase =
        document.documentElement
          .classList.contains(
            "is-book-zoomed"
          )
          ? "zooming"
          : "idle";

      let syncFrame = 0;

      /*
       * 左右フェードを同じ計算方法で、
       * Visual Viewportの両端へ配置する。
       */
      const syncHorizontalFades =
        () => {
          syncFrame = 0;

          if (
            !visualViewport ||
            zoomPhase !== "zooming"
          ) {
            return;
          }

          const visualLeft =
            visualViewport.offsetLeft;

          const visualRight =
            visualViewport.offsetLeft +
            visualViewport.width;

          leftFade?.style.setProperty(
            "--edge-fade-left-position",
            `${visualLeft}px`
          );

          rightFade?.style.setProperty(
            "--edge-fade-right-position",
            `${visualRight}px`
          );
        };

      const scheduleHorizontalFadeSync =
        () => {
          if (
            zoomPhase !== "zooming"
          ) {
            return;
          }

          if (syncFrame) {
            cancelAnimationFrame(
              syncFrame
            );
          }

          syncFrame =
            requestAnimationFrame(
              syncHorizontalFades
            );
        };

      const resetHorizontalFades =
        () => {
          if (syncFrame) {
            cancelAnimationFrame(
              syncFrame
            );

            syncFrame = 0;
          }

          leftFade?.classList.remove(
            "is-visual-viewport-tracking"
          );

          rightFade?.classList.remove(
            "is-visual-viewport-tracking"
          );

          leftFade?.style.removeProperty(
            "--edge-fade-left-position"
          );

          rightFade?.style.removeProperty(
            "--edge-fade-right-position"
          );

          /*
           * SafariへCSS既定位置への復帰を
           * その場で認識させる。
           */
          leftFade?.getBoundingClientRect();
          rightFade?.getBoundingClientRect();
        };

      const handleZoomPhaseChange =
        (
          event: Event
        ) => {
          const customEvent =
            event as CustomEvent<{
              phase?: ZoomPhase;
            }>;

          const nextPhase =
            customEvent.detail
              ?.phase;

          if (!nextPhase) {
            return;
          }

          zoomPhase =
            nextPhase;

          if (
            nextPhase === "zooming"
          ) {
            leftFade?.classList.add(
              "is-visual-viewport-tracking"
            );

            rightFade?.classList.add(
              "is-visual-viewport-tracking"
            );

            scheduleHorizontalFadeSync();

            return;
          }

          /*
           * resetting開始時点で追従を止め、
           * idle時の通常位置へ戻す。
           */
          resetHorizontalFades();
        };

      const handleViewportChange =
        () => {
          if (
            zoomPhase === "zooming"
          ) {
            scheduleHorizontalFadeSync();
          }
        };

      const cleanupHorizontalFades =
        () => {
          if (syncFrame) {
            cancelAnimationFrame(
              syncFrame
            );
          }

          syncFrame = 0;

          resetHorizontalFades();

          window.removeEventListener(
            "book-zoom-phase-change",
            handleZoomPhaseChange
          );

          window.removeEventListener(
            "resize",
            handleViewportChange
          );

          window.removeEventListener(
            "orientationchange",
            handleViewportChange
          );

          visualViewport?.removeEventListener(
            "resize",
            handleViewportChange
          );

          visualViewport?.removeEventListener(
            "scroll",
            handleViewportChange
          );

          document.removeEventListener(
            "astro:before-swap",
            cleanupHorizontalFades
          );
        };

      if (
        document.documentElement
          .classList.contains(
            "is-book-zoomed"
          )
      ) {
        zoomPhase =
          "zooming";

        leftFade?.classList.add(
          "is-visual-viewport-tracking"
        );

        rightFade?.classList.add(
          "is-visual-viewport-tracking"
        );

        requestAnimationFrame(
          scheduleHorizontalFadeSync
        );
      } else {
        resetHorizontalFades();
      }

      window.addEventListener(
        "book-zoom-phase-change",
        handleZoomPhaseChange
      );

      window.addEventListener(
        "resize",
        handleViewportChange
      );

      window.addEventListener(
        "orientationchange",
        handleViewportChange
      );

      visualViewport?.addEventListener(
        "resize",
        handleViewportChange
      );

      visualViewport?.addEventListener(
        "scroll",
        handleViewportChange
      );

      document.addEventListener(
        "astro:before-swap",
        cleanupHorizontalFades
      );
    </script>
  )
}

<style>
  .edge-fade {
    --edge-fade-size-top:
      80px;

    --edge-fade-size-bottom:
      42px;

    --edge-fade-size-x:
      32px;

    --edge-fade-scrollbar-clearance:
      0px;

    position: sticky;
    top: 0;

    width: 100%;
    height: 100dvh;

    margin-bottom:
      -100dvh;

    overflow: hidden;

    pointer-events: none;

    z-index: 900;
  }

  .edge-fade.is-fixed-horizontal {
    position: fixed;

    top: 0;
    right: 0;
    bottom: 0;
    left: 0;

    width: 100vw;
    height: 100dvh;

    margin: 0;

    overflow: hidden;

    z-index: 1900;

    transform:
      translate3d(
        0,
        0,
        0
      );

    backface-visibility:
      hidden;

    will-change:
      transform;
  }

  .edge-fade span {
    position: absolute;

    pointer-events: none;

    z-index: 1;
  }

  .edge-fade-top {
    top: 0;
    left: 0;
    right: 0;

    height: calc(
      env(
          safe-area-inset-top,
          0px
        ) +
        var(
          --edge-fade-size-top
        )
    );

    background:
      linear-gradient(
        to bottom,
        #fff 0,
        #fff
          env(
            safe-area-inset-top,
            0px
          ),
        rgba(
            255,
            255,
            255,
            0.98
          )
          calc(
            env(
                safe-area-inset-top,
                0px
              ) +
              var(
                  --edge-fade-size-top
                ) *
                0.15
          ),
        rgba(
            255,
            255,
            255,
            0.88
          )
          calc(
            env(
                safe-area-inset-top,
                0px
              ) +
              var(
                  --edge-fade-size-top
                ) *
                0.35
          ),
        rgba(
            255,
            255,
            255,
            0.55
          )
          calc(
            env(
                safe-area-inset-top,
                0px
              ) +
              var(
                  --edge-fade-size-top
                ) *
                0.72
          ),
        rgba(
            255,
            255,
            255,
            0
          )
          calc(
            env(
                safe-area-inset-top,
                0px
              ) +
              var(
                --edge-fade-size-top
              )
          )
      );
  }

  .edge-fade-bottom {
    bottom:
      var(
        --edge-fade-scrollbar-clearance
      );

    left: 0;
    right: 0;

    height: calc(
      env(
          safe-area-inset-bottom,
          0px
        ) +
        var(
          --edge-fade-size-bottom
        )
    );

    background:
      linear-gradient(
        to top,
        #fff 0,
        rgba(
            255,
            255,
            255,
            0.99
          )
          calc(
            env(
                safe-area-inset-bottom,
                0px
              ) +
              var(
                  --edge-fade-size-bottom
                ) *
                0.10
          ),
        rgba(
            255,
            255,
            255,
            0.98
          )
          calc(
            env(
                safe-area-inset-bottom,
                0px
              ) +
              var(
                  --edge-fade-size-bottom
                ) *
                0.20
          ),
        rgba(
            255,
            255,
            255,
            0.95
          )
          calc(
            env(
                safe-area-inset-bottom,
                0px
              ) +
              var(
                  --edge-fade-size-bottom
                ) *
                0.30
          ),
        rgba(
            255,
            255,
            255,
            0.90
          )
          calc(
            env(
                safe-area-inset-bottom,
                0px
              ) +
              var(
                  --edge-fade-size-bottom
                ) *
                0.40
          ),
        rgba(
            255,
            255,
            255,
            0.81
          )
          calc(
            env(
                safe-area-inset-bottom,
                0px
              ) +
              var(
                  --edge-fade-size-bottom
                ) *
                0.50
          ),
        rgba(
            255,
            255,
            255,
            0.67
          )
          calc(
            env(
                safe-area-inset-bottom,
                0px
              ) +
              var(
                  --edge-fade-size-bottom
                ) *
                0.60
          ),
        rgba(
            255,
            255,
            255,
            0.50
          )
          calc(
            env(
                safe-area-inset-bottom,
                0px
              ) +
              var(
                  --edge-fade-size-bottom
                ) *
                0.70
          ),
        rgba(
            255,
            255,
            255,
            0.30
          )
          calc(
            env(
                safe-area-inset-bottom,
                0px
              ) +
              var(
                  --edge-fade-size-bottom
                ) *
                0.80
          ),
        rgba(
            255,
            255,
            255,
            0.05
          )
          calc(
            env(
                safe-area-inset-bottom,
                0px
              ) +
              var(
                  --edge-fade-size-bottom
                ) *
                0.90
          ),
        rgba(
            255,
            255,
            255,
            0
          )
          calc(
            env(
                safe-area-inset-bottom,
                0px
              ) +
              var(
                --edge-fade-size-bottom
              )
          )
      );
  }

  /*
   * type: bookでは上下フェードなし。
   */
  .edge-fade.is-fixed-horizontal
    .edge-fade-top,
  .edge-fade.is-fixed-horizontal
    .edge-fade-bottom {
    display: none;
  }

  .edge-fade-left,
  .edge-fade-right {
    display: none;
  }

  .edge-fade.has-horizontal
    .edge-fade-left {
    display: block;

    top: 0;
    left: 0;

    bottom:
      var(
        --edge-fade-scrollbar-clearance
      );

    width:
      var(
        --edge-fade-size-x
      );

    background:
      linear-gradient(
        to right,
        #fff 0%,
        rgba(
            255,
            255,
            255,
            0.98
          )
          12%,
        rgba(
            255,
            255,
            255,
            0.88
          )
          28%,
        rgba(
            255,
            255,
            255,
            0.55
          )
          58%,
        rgba(
            255,
            255,
            255,
            0
          )
          100%
      );
  }

  .edge-fade.has-horizontal
    .edge-fade-right {
    display: block;

    top: 0;
    right: 0;
    left: auto;

    bottom:
      var(
        --edge-fade-scrollbar-clearance
      );

    width:
      var(
        --edge-fade-size-x
      );

    background:
      linear-gradient(
        to left,
        #fff 0%,
        rgba(
            255,
            255,
            255,
            0.98
          )
          12%,
        rgba(
            255,
            255,
            255,
            0.88
          )
          28%,
        rgba(
            255,
            255,
            255,
            0.55
          )
          58%,
        rgba(
            255,
            255,
            255,
            0
          )
          100%
      );
  }

  /*
   * 拡大中の左フェード。
   *
   * 右フェードと同じく、
   * Visual Viewportの実座標を使う。
   */
  .edge-fade.is-fixed-horizontal
    .edge-fade-left.is-visual-viewport-tracking {
    right: auto;

    left:
      var(
        --edge-fade-left-position,
        0px
      );

    will-change:
      left;
  }

  /*
   * 拡大中の右フェード。
   */
  .edge-fade.is-fixed-horizontal
    .edge-fade-right.is-visual-viewport-tracking {
    right: auto;

    left:
      calc(
        var(
            --edge-fade-right-position,
            100vw
          ) -
        var(
          --edge-fade-size-x
        )
      );

    will-change:
      left;
  }

  @media (
    hover: hover
  ) and (
    pointer: fine
  ) {
    .edge-fade.is-fixed-horizontal {
      --edge-fade-scrollbar-clearance:
        14px;
    }
  }

  @media (
    hover: none
  ) and (
    pointer: coarse
  ) {
    .edge-fade.is-fixed-horizontal {
      --edge-fade-scrollbar-clearance:
        env(
          safe-area-inset-bottom,
          0px
        );
    }
  }
</style>