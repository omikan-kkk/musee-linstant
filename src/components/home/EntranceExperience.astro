---
import { CONTENTS } from "../../data/contents";

const lobbyContent = CONTENTS.find(
  (content) => content.id === "__lobby__"
);

const lobbyImage =
  lobbyContent?.image || "";

const desktopHeightPx =
  lobbyContent?.desktopHeightPx ?? 620;

const desktopHeightVh =
  lobbyContent?.desktopHeightVh ?? 60;

const entranceStyle = [
  `--desktop-height-px: ${desktopHeightPx}px`,
  `--desktop-height-vh: ${desktopHeightVh}vh`,
].join(";");
---

<div
  class="entrance-experience"
  data-entrance-experience
  style={entranceStyle}
>
  <div
    class="entrance-experience__lobby"
    data-lobby
    aria-hidden="true"
  >
    {
      lobbyImage && (
        <img
          class="entrance-experience__lobby-image"
          src={lobbyImage}
          alt=""
          loading="eager"
          decoding="async"
        />
      )
    }
  </div>

  <div
    class="entrance-experience__veil"
    aria-hidden="true"
  ></div>

  <svg
    class="entrance-experience__logo"
    viewBox="0 0 1000 120"
    role="img"
    aria-label="Musée de l'Instant"
  >
    <text
      class="entrance-experience__logo-text"
      x="500"
      y="66"
      text-anchor="middle"
      dominant-baseline="middle"
    >
      Musée de l'Instant
    </text>
  </svg>
</div>

<script>
  const root =
    document.querySelector<HTMLElement>(
      "[data-entrance-experience]"
    );

  if (
    root &&
    root.dataset.initialized !== "true"
  ) {
    root.dataset.initialized = "true";

    const lobby =
      root.querySelector<HTMLElement>(
        "[data-lobby]"
      );

    /*
     * progress:
     *
     * 0 = 入口
     * 1 = ロビー最奥
     */
    const FORWARD_THRESHOLD = 0.42;

    /*
     * 入館方向の操作感度。
     *
     * 入館側は完成済みのため、
     * 現在の数値を維持する。
     */
    const FORWARD_TOUCH_DISTANCE = 345;
    const FORWARD_WHEEL_DISTANCE = 300;

    /*
     * 入館時の自動遷移時間基準。
     */
    const FORWARD_SNAP_DURATION = 620;

    /*
     * 退館時のロゴ遷移時間。
     *
     * 退館方向の入力を一度検知した時点から、
     * 操作量にかかわらず固定500msで
     * 必ず入口まで戻る。
     */
    const BACKWARD_SNAP_DURATION = 500;

    /*
     * 入館画像演出。
     *
     * opacity:
     * 0 → 1
     *
     * scale:
     * 0.85 → 1
     *
     * 700ms
     */
    const LOBBY_ENTER_DURATION = 700;
    const LOBBY_ENTER_SCALE = 0.85;

    /*
     * 退館画像演出。
     *
     * opacity:
     * 1 → 0
     *
     * scale:
     * 1 → 0.75
     *
     * 400ms linear
     */
    const LOBBY_EXIT_DURATION = 400;
    const LOBBY_EXIT_SCALE = 0.75;

    let progress = 0;
    let wheelTarget = 0;

    let touchStartY = 0;
    let touchStartProgress = 0;
    let touchLastY = 0;
    let touchDirection = 0;

    let renderFrame = 0;
    let snapFrame = 0;
    let wheelEndTimer = 0;

    let isTouching = false;
    let isSnapping = false;
    let isLobbyVisible = false;

    let snapTarget: 0 | 1 | null = null;

    const clamp = (
      value: number,
      min = 0,
      max = 1
    ) =>
      Math.min(
        max,
        Math.max(min, value)
      );

    const easeOutQuint = (
      value: number
    ) =>
      1 - Math.pow(1 - value, 5);

    const easeInOutCubic = (
      value: number
    ) =>
      value < 0.5
        ? 4 * value * value * value
        : 1 -
          Math.pow(
            -2 * value + 2,
            3
          ) /
            2;

    const dispatchState = (
      complete: boolean
    ) => {
      window.dispatchEvent(
        new CustomEvent(
          "entrance-state-change",
          {
            detail: {
              complete,
              progress,
            },
          }
        )
      );
    };

    const forceReflow = () => {
      lobby?.getBoundingClientRect();
    };

    /*
     * 入館完了後の画像表示。
     *
     * 一度表示済みになったあとは、
     * 退館画像演出が始まるまで
     * 再実行しない。
     */
    const showLobbyAndHeader = () => {
      if (isLobbyVisible) {
        document.body.classList.add(
          "entrance-is-complete"
        );

        dispatchState(true);
        return;
      }

      isLobbyVisible = true;

      if (!lobby) {
        document.body.classList.add(
          "entrance-is-complete"
        );

        dispatchState(true);
        return;
      }

      lobby.style.transition = "none";
      lobby.style.opacity = "0";
      lobby.style.transform =
        `scale(${LOBBY_ENTER_SCALE})`;

      forceReflow();

      lobby.style.transition = [
        `opacity ${LOBBY_ENTER_DURATION}ms cubic-bezier(0.22, 1, 0.36, 1)`,
        `transform ${LOBBY_ENTER_DURATION}ms cubic-bezier(0.22, 1, 0.36, 1)`,
      ].join(", ");

      lobby.style.opacity = "1";
      lobby.style.transform =
        "scale(1)";

      document.body.classList.add(
        "entrance-is-complete"
      );

      dispatchState(true);
    };

    /*
     * 退館開始直後の画像消失。
     *
     * ロゴの退館遷移とは独立して、
     * 固定400msで消失・縮小する。
     */
    const hideLobbyAndHeader = () => {
      document.body.classList.remove(
        "entrance-is-complete"
      );

      if (!isLobbyVisible) {
        dispatchState(false);
        return;
      }

      isLobbyVisible = false;

      if (lobby) {
        lobby.style.transition = [
          `opacity ${LOBBY_EXIT_DURATION}ms linear`,
          `transform ${LOBBY_EXIT_DURATION}ms linear`,
        ].join(", ");

        lobby.style.opacity = "0";
        lobby.style.transform =
          `scale(${LOBBY_EXIT_SCALE})`;
      }

      dispatchState(false);
    };

    const render = () => {
      const forwardCurve =
        progress * progress;

      const logoScale =
        1 + forwardCurve * 13;

      const logoOpacity = clamp(
        1 -
          (progress - 0.48) /
            0.3
      );

      const veilOpacity =
        progress < 0.58
          ? clamp(
              progress / 0.58
            )
          : clamp(
              1 -
                (progress - 0.58) /
                  0.42
            );

      root.style.setProperty(
        "--logo-scale",
        String(logoScale)
      );

      root.style.setProperty(
        "--logo-opacity",
        String(logoOpacity)
      );

      root.style.setProperty(
        "--veil-opacity",
        String(veilOpacity)
      );

      dispatchState(
        progress >= 1
      );
    };

    const cancelRenderFrame = () => {
      if (renderFrame) {
        cancelAnimationFrame(
          renderFrame
        );
      }

      renderFrame = 0;
    };

    const cancelSnap = () => {
      if (snapFrame) {
        cancelAnimationFrame(
          snapFrame
        );
      }

      snapFrame = 0;
      isSnapping = false;
      snapTarget = null;
    };

    const completeSnap = (
      target: 0 | 1
    ) => {
      progress = target;
      wheelTarget = target;

      isSnapping = false;
      snapTarget = null;
      snapFrame = 0;

      render();

      if (target === 1) {
        showLobbyAndHeader();
      } else {
        hideLobbyAndHeader();
      }
    };

    /*
     * 入館・退館の自動遷移。
     *
     * 入館：
     * 残り距離に応じて尺を調整する。
     *
     * 退館：
     * 開始位置に関係なく固定500ms。
     * 一度開始したらキャンセルしない。
     */
    const snapTo = (
      target: 0 | 1
    ) => {
      if (
        target === 1 &&
        progress >= 1 &&
        isLobbyVisible
      ) {
        wheelTarget = 1;
        return;
      }

      if (
        target === 0 &&
        progress <= 0 &&
        !isLobbyVisible
      ) {
        wheelTarget = 0;
        return;
      }

      if (
        isSnapping &&
        snapTarget === target
      ) {
        return;
      }

      /*
       * 退館遷移がすでに始まっている場合は、
       * 別の入力で中断・反転させない。
       */
      if (
        isSnapping &&
        snapTarget === 0
      ) {
        return;
      }

      cancelRenderFrame();
      cancelSnap();

      if (target === 0) {
        hideLobbyAndHeader();
      }

      isSnapping = true;
      snapTarget = target;

      const startProgress =
        progress;

      const distance =
        target - startProgress;

      const duration =
        target === 0
          ? BACKWARD_SNAP_DURATION
          : Math.max(
              260,
              FORWARD_SNAP_DURATION *
                Math.abs(distance)
            );

      const startTime =
        performance.now();

      const animate = (
        currentTime: number
      ) => {
        const elapsed =
          currentTime - startTime;

        const timeProgress =
          clamp(
            elapsed / duration
          );

        const eased =
          target === 1
            ? easeOutQuint(
                timeProgress
              )
            : easeInOutCubic(
                timeProgress
              );

        progress = clamp(
          startProgress +
            distance * eased
        );

        wheelTarget = progress;

        render();

        if (timeProgress < 1) {
          snapFrame =
            requestAnimationFrame(
              animate
            );

          return;
        }

        completeSnap(target);
      };

      snapFrame =
        requestAnimationFrame(
          animate
        );
    };

    /*
     * 退館方向の入力を一度検知した時点で、
     * 画像とロゴの退館演出を同時に開始する。
     *
     * 以後は指・ホイールを止めても、
     * 必ず500msで入口まで戻る。
     */
    const startExitTransition = () => {
      if (
        progress <= 0 ||
        (
          isSnapping &&
          snapTarget === 0
        )
      ) {
        return;
      }

      isTouching = false;

      window.clearTimeout(
        wheelEndTimer
      );

      cancelRenderFrame();

      /*
       * 入館方向への自動遷移中だった場合だけ、
       * その遷移を中断して退館へ切り替える。
       */
      if (
        isSnapping &&
        snapTarget === 1
      ) {
        cancelSnap();
      }

      snapTo(0);
    };

    /*
     * 入館方向の閾値判定。
     *
     * 退館には閾値を使用しない。
     * 退館方向入力の初回検知で即座に
     * startExitTransition()を実行する。
     */
    const evaluateForwardThreshold = (
      direction: number
    ) => {
      if (
        direction <= 0
      ) {
        return false;
      }

      if (progress >= 1) {
        wheelTarget = 1;
        return false;
      }

      if (
        progress >=
          FORWARD_THRESHOLD
      ) {
        snapTo(1);
        return true;
      }

      return false;
    };

    /*
     * PCホイールによる入館操作。
     *
     * 退館方向はここを通らず、
     * 検知直後に確定退館へ移行する。
     */
    const startWheelInterpolation = () => {
      cancelRenderFrame();

      const animate = () => {
        if (isSnapping) {
          renderFrame = 0;
          return;
        }

        const difference =
          wheelTarget - progress;

        progress +=
          difference * 0.18;

        if (
          Math.abs(difference) <
          0.001
        ) {
          progress =
            wheelTarget;
        }

        progress =
          clamp(progress);

        render();

        if (
          evaluateForwardThreshold(1)
        ) {
          renderFrame = 0;
          return;
        }

        if (
          Math.abs(
            wheelTarget -
              progress
          ) > 0.001
        ) {
          renderFrame =
            requestAnimationFrame(
              animate
            );

          return;
        }

        renderFrame = 0;
      };

      renderFrame =
        requestAnimationFrame(
          animate
        );
    };

    const handleWheel = (
      event: WheelEvent
    ) => {
      event.preventDefault();

      if (
        Math.abs(
          event.deltaY
        ) < 0.5
      ) {
        return;
      }

      const direction =
        Math.sign(
          event.deltaY
        );

      /*
       * 退館方向のホイール入力を
       * 一度でも検知したら即退館する。
       */
      if (direction < 0) {
        startExitTransition();
        return;
      }

      /*
       * 退館確定遷移中は、
       * 入館方向の追加入力も無視する。
       */
      if (
        isSnapping &&
        snapTarget === 0
      ) {
        return;
      }

      if (
        progress >= 1 &&
        isLobbyVisible
      ) {
        wheelTarget = 1;
        return;
      }

      if (isSnapping) {
        return;
      }

      const normalizedDelta =
        Math.min(
          Math.max(
            Math.abs(
              event.deltaY
            ),
            22
          ),
          120
        );

      wheelTarget = clamp(
        wheelTarget +
          normalizedDelta /
            FORWARD_WHEEL_DISTANCE
      );

      startWheelInterpolation();

      window.clearTimeout(
        wheelEndTimer
      );

      wheelEndTimer =
        window.setTimeout(() => {
          evaluateForwardThreshold(1);
        }, 70);
    };
        const handleTouchStart = (
      event: TouchEvent
    ) => {
      if (
        event.touches.length !== 1
      ) {
        return;
      }

      /*
       * 退館確定遷移中は、
       * 新しいタッチ操作を受け付けない。
       */
      if (
        isSnapping &&
        snapTarget === 0
      ) {
        return;
      }

      const touchY =
        event.touches[0].clientY;

      isTouching = true;
      touchStartY = touchY;
      touchLastY = touchY;
      touchStartProgress = progress;
      touchDirection = 0;

      cancelRenderFrame();

      /*
       * 入館方向の自動遷移中に
       * 新しい操作が始まった場合だけ、
       * その入館遷移を中断可能にする。
       *
       * 退館遷移は中断しない。
       */
      if (
        isSnapping &&
        snapTarget === 1
      ) {
        cancelSnap();
      }
    };

    const handleTouchMove = (
      event: TouchEvent
    ) => {
      if (
        !isTouching ||
        event.touches.length !== 1
      ) {
        return;
      }

      event.preventDefault();

      const touchY =
        event.touches[0].clientY;

      const totalDistance =
        touchStartY - touchY;

      const frameDistance =
        touchLastY - touchY;

      touchLastY = touchY;

      if (
        Math.abs(frameDistance) >
        0.5
      ) {
        touchDirection =
          Math.sign(
            frameDistance
          );
      }

      /*
       * 退館方向のスワイプを
       * 一度でも検知したら、
       * その場で確定退館を開始する。
       *
       * 指を止めても、
       * 指を離しても、
       * 必ず500msで入口まで戻る。
       */
      if (
        touchDirection < 0
      ) {
        startExitTransition();
        return;
      }

      /*
       * 入館方向のみ、
       * 指の移動量へprogressを追従させる。
       */
      progress = clamp(
        touchStartProgress +
          totalDistance /
            FORWARD_TOUCH_DISTANCE
      );

      wheelTarget = progress;

      render();

      if (
        evaluateForwardThreshold(
          touchDirection
        )
      ) {
        isTouching = false;
      }
    };

    const handleTouchEnd = () => {
      if (!isTouching) {
        return;
      }

      isTouching = false;

      /*
       * 入館方向の操作だけ、
       * 指を離した時点で閾値を判定する。
       *
       * 退館はすでに初回検知時点で
       * 確定遷移へ入っているため、
       * touchendでは何もしない。
       */
      evaluateForwardThreshold(
        touchDirection
      );
    };

    const handleKeyDown = (
      event: KeyboardEvent
    ) => {
      const forwardKeys = [
        "ArrowDown",
        "PageDown",
        " ",
        "Enter",
      ];

      const backwardKeys = [
        "ArrowUp",
        "PageUp",
        "Escape",
      ];

      const isForward =
        forwardKeys.includes(
          event.key
        );

      const isBackward =
        backwardKeys.includes(
          event.key
        );

      if (
        !isForward &&
        !isBackward
      ) {
        return;
      }

      event.preventDefault();

      /*
       * 退館確定遷移中は、
       * すべてのキー入力を無視する。
       */
      if (
        isSnapping &&
        snapTarget === 0
      ) {
        return;
      }

      if (
        isForward &&
        progress >= 1 &&
        isLobbyVisible
      ) {
        return;
      }

      if (
        isBackward &&
        progress <= 0 &&
        !isLobbyVisible
      ) {
        return;
      }

      if (isForward) {
        snapTo(1);
      } else {
        startExitTransition();
      }
    };

    const cleanup = () => {
      cancelRenderFrame();
      cancelSnap();

      window.clearTimeout(
        wheelEndTimer
      );

      window.removeEventListener(
        "wheel",
        handleWheel
      );

      window.removeEventListener(
        "touchstart",
        handleTouchStart
      );

      window.removeEventListener(
        "touchmove",
        handleTouchMove
      );

      window.removeEventListener(
        "touchend",
        handleTouchEnd
      );

      window.removeEventListener(
        "touchcancel",
        handleTouchEnd
      );

      window.removeEventListener(
        "keydown",
        handleKeyDown
      );

      document.removeEventListener(
        "astro:before-swap",
        cleanup
      );
    };

    /*
     * 初期状態。
     *
     * 画像は非表示。
     * 入口ロゴは表示状態。
     */
    if (lobby) {
      lobby.style.transition = "none";
      lobby.style.opacity = "0";
      lobby.style.transform =
        `scale(${LOBBY_EXIT_SCALE})`;
    }

    render();

    document.body.classList.remove(
      "entrance-is-complete"
    );

    dispatchState(false);

    window.addEventListener(
      "wheel",
      handleWheel,
      {
        passive: false,
      }
    );

    window.addEventListener(
      "touchstart",
      handleTouchStart,
      {
        passive: true,
      }
    );

    window.addEventListener(
      "touchmove",
      handleTouchMove,
      {
        passive: false,
      }
    );

    window.addEventListener(
      "touchend",
      handleTouchEnd,
      {
        passive: true,
      }
    );

    window.addEventListener(
      "touchcancel",
      handleTouchEnd,
      {
        passive: true,
      }
    );

    window.addEventListener(
      "keydown",
      handleKeyDown
    );

    document.addEventListener(
      "astro:before-swap",
      cleanup
    );
  }
</script>

<style>
  .entrance-experience {
    --logo-scale: 1;
    --logo-opacity: 1;
    --veil-opacity: 0;

    --desktop-height-px: 620px;
    --desktop-height-vh: 60vh;

    position: fixed;
    inset: 0;
    z-index: 1;

    width: 100%;
    height: 100svh;

    overflow: hidden;
    overscroll-behavior: none;
    touch-action: none;

    background: #fff;
  }

  .entrance-experience__lobby {
    position: absolute;
    inset: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    opacity: 0;
    transform: scale(0.75);
    transform-origin: center;

    background: #fff;

    will-change:
      opacity,
      transform;

    pointer-events: none;
  }

  .entrance-experience__lobby-image {
    display: block;

    width: auto;
    max-width: 100%;

    height: min(
      var(--desktop-height-vh),
      var(--desktop-height-px)
    );

    max-height: 100svh;

    object-fit: contain;

    pointer-events: none;
    user-select: none;
  }

  .entrance-experience__veil {
    position: absolute;
    inset: 0;

    opacity: calc(
      var(--veil-opacity) * 0.1
    );

    background: #fff;

    pointer-events: none;

    will-change: opacity;
  }

  .entrance-experience__logo {
    position: absolute;
    top: 50%;
    left: 50%;

    width: min(
      680px,
      calc(100vw - 48px)
    );

    height: auto;
    overflow: visible;

    opacity:
      var(
        --logo-opacity
      );

    transform:
      translate(-50%, -50%)
      scale(
        var(--logo-scale)
      );

    transform-origin: center;

    pointer-events: none;
    user-select: none;

    will-change:
      transform,
      opacity;
  }

  .entrance-experience__logo-text {
    fill:
      var(
        --navigation-color
      );

    font-family:
      var(
        --site-font-family
      );

    font-size: 34px;
    font-weight: 400;
    letter-spacing: 0.08em;
  }

  @media (max-width: 1024px) {
    .entrance-experience__lobby-image {
      width: 100%;
      max-width: none;

      height: auto;
      max-height: 100svh;

      object-fit: contain;
    }
  }

  @media (max-width: 640px) {
    .entrance-experience__logo {
      width: calc(
        100vw - 32px
      );
    }

    .entrance-experience__logo-text {
      font-size: 32px;
    }
  }

  @media (
    prefers-reduced-motion:
    reduce
  ) {
    .entrance-experience__lobby {
      transition-duration:
        1ms !important;
    }
  }
</style>