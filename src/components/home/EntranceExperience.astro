---
import { CONTENTS } from "../../data/contents";

const lobbyContent = CONTENTS.find(
  (content) => content.id === "__lobby__"
);

const lobbyImage =
  lobbyContent?.image || "";

const desktopHeightPx =
  lobbyContent?.desktopHeightPx ?? 620;

const desktopHeightVh =
  lobbyContent?.desktopHeightVh ?? 60;

const entranceStyle = [
  `--desktop-height-px: ${desktopHeightPx}px`,
  `--desktop-height-vh: ${desktopHeightVh}vh`,
].join(";");
---

<div
  class="entrance-experience"
  data-entrance-experience
  style={entranceStyle}
>
  <div
    class="entrance-experience__lobby-stage"
    aria-hidden="true"
  >
    {
      lobbyImage && (
        <>
          <div
            class="
              entrance-experience__lobby-layer
              entrance-experience__lobby-layer--approach
            "
          >
            <img
              class="entrance-experience__lobby-image"
              src={lobbyImage}
              alt=""
              loading="eager"
              decoding="async"
            />
          </div>

          <div
            class="
              entrance-experience__lobby-layer
              entrance-experience__lobby-layer--final
            "
          >
            <img
              class="entrance-experience__lobby-image"
              src={lobbyImage}
              alt=""
              loading="eager"
              decoding="async"
            />
          </div>
        </>
      )
    }
  </div>

  <div
    class="entrance-experience__veil"
    aria-hidden="true"
  ></div>

  <svg
    class="entrance-experience__logo"
    viewBox="0 0 1000 120"
    role="img"
    aria-label="Musée de l'Instant"
  >
    <text
      class="entrance-experience__logo-text"
      x="500"
      y="66"
      text-anchor="middle"
      dominant-baseline="middle"
    >
      Musée de l'Instant
    </text>
  </svg>
</div>

<script>
  const root =
    document.querySelector<HTMLElement>(
      "[data-entrance-experience]"
    );

  if (
    root &&
    root.dataset.initialized !== "true"
  ) {
    root.dataset.initialized = "true";

    /*
     * 入口：0
     * ロビー：1
     */
    const FORWARD_THRESHOLD = 0.42;
    const BACKWARD_THRESHOLD = 0.58;

    /*
     * 一度の縦スワイプで、
     * 入館・退館しやすい操作距離。
     */
    const TOUCH_DISTANCE = 230;
    const WHEEL_DISTANCE = 190;

    const FORWARD_SNAP_DURATION = 620;
    const BACKWARD_SNAP_DURATION = 560;

    /*
     * LogoButton / MenuButtonと
     * ロビー画像の本表示を同時に開始する。
     */
    const HEADER_DELAY = 10;

    let progress = 0;
    let wheelTarget = 0;

    let touchStartY = 0;
    let touchStartProgress = 0;
    let touchLastY = 0;
    let touchDirection = 0;

    let renderFrame = 0;
    let snapFrame = 0;
    let wheelEndTimer = 0;
    let headerTimer = 0;

    let isTouching = false;
    let isSnapping = false;
    let snapTarget: 0 | 1 | null = null;

    const clamp = (
      value: number,
      min = 0,
      max = 1
    ) =>
      Math.min(
        max,
        Math.max(min, value)
      );

    const easeOutQuint = (
      value: number
    ) =>
      1 - Math.pow(1 - value, 5);

    const easeInOutCubic = (
      value: number
    ) =>
      value < 0.5
        ? 4 * value * value * value
        : 1 -
          Math.pow(
            -2 * value + 2,
            3
          ) /
            2;

    const dispatchState = (
      complete: boolean
    ) => {
      window.dispatchEvent(
        new CustomEvent(
          "entrance-state-change",
          {
            detail: {
              complete,
              progress,
            },
          }
        )
      );
    };

    const clearHeaderTimer = () => {
      window.clearTimeout(
        headerTimer
      );

      headerTimer = 0;
    };

    const hideHeader = () => {
      clearHeaderTimer();

      /*
       * ロビー画像の本表示を解除する。
       * CSS側の900ms easeでフェードアウトする。
       */
      root.classList.remove(
        "is-lobby-complete"
      );

      document.body.classList.remove(
        "entrance-is-complete"
      );

      dispatchState(false);
    };

    const showHeaderAfterDelay = () => {
      clearHeaderTimer();

      headerTimer =
        window.setTimeout(() => {
          /*
           * ロビー画像・ロゴボタン・
           * メニューボタンの表示開始を揃える。
           */
          root.classList.add(
            "is-lobby-complete"
          );

          document.body.classList.add(
            "entrance-is-complete"
          );

          dispatchState(true);
        }, HEADER_DELAY);
    };

    const render = () => {
      /*
       * 入口ロゴは、奥へ進むほど
       * 加速するように巨大化する。
       */
      const forwardCurve =
        progress * progress;

      const logoScale =
        1 + forwardCurve * 13;

      const logoOpacity = clamp(
        1 -
          (progress - 0.48) /
            0.3
      );

      /*
       * ロビー画像は遠方の小さな状態から始まり、
       * 入館が進むほど近づいて大きくなる。
       *
       * progress 0.18までは遠景のまま、
       * そこから1.0に向けて所定サイズへ近づく。
       */
      const lobbyTravelProgress =
        clamp(
          (progress - 0.18) /
            0.82
        );

      const lobbyTravelCurve =
        easeOutQuint(
          lobbyTravelProgress
        );

      const lobbyScale =
        0.72 +
        lobbyTravelCurve * 0.28;

      /*
       * 接近中は、遠くにロビーが存在することが
       * 分かる程度の薄い像だけを表示する。
       *
       * 入館完了後の鮮明な本表示は、
       * CSS側で900msかけて重ねる。
       */
      const lobbyApproachOpacity =
        clamp(
          (progress - 0.28) /
            0.42
        ) * 0.22;

      /*
       * ロゴを通過する瞬間だけ、
       * ごく薄い白を挟む。
       */
      const veilOpacity =
        progress < 0.58
          ? clamp(
              progress / 0.58
            )
          : clamp(
              1 -
                (progress - 0.58) /
                  0.42
            );

      root.style.setProperty(
        "--logo-scale",
        String(logoScale)
      );

      root.style.setProperty(
        "--logo-opacity",
        String(logoOpacity)
      );

      root.style.setProperty(
        "--lobby-scale",
        String(lobbyScale)
      );

      root.style.setProperty(
        "--lobby-approach-opacity",
        String(
          lobbyApproachOpacity
        )
      );

      root.style.setProperty(
        "--veil-opacity",
        String(veilOpacity)
      );

      dispatchState(
        progress >= 1
      );
    };

    const cancelRenderFrame = () => {
      if (renderFrame) {
        cancelAnimationFrame(
          renderFrame
        );
      }

      renderFrame = 0;
    };

    const cancelSnap = () => {
      if (snapFrame) {
        cancelAnimationFrame(
          snapFrame
        );
      }

      snapFrame = 0;
      isSnapping = false;
      snapTarget = null;
    };

    const completeSnap = (
      target: 0 | 1
    ) => {
      progress = target;
      wheelTarget = target;

      isSnapping = false;
      snapTarget = null;
      snapFrame = 0;

      render();

      if (target === 1) {
        showHeaderAfterDelay();
      } else {
        hideHeader();
      }
    };

    const snapTo = (
      target: 0 | 1
    ) => {
      if (
        isSnapping &&
        snapTarget === target
      ) {
        return;
      }

      cancelRenderFrame();
      cancelSnap();

      /*
       * 退館を始める場合は、
       * 画像とボタン類のフェードアウトを
       * 移動開始と同時に始める。
       */
      if (target === 0) {
        hideHeader();
      }

      isSnapping = true;
      snapTarget = target;

      const startProgress =
        progress;

      const distance =
        target - startProgress;

      const baseDuration =
        target === 1
          ? FORWARD_SNAP_DURATION
          : BACKWARD_SNAP_DURATION;

      const duration = Math.max(
        260,
        baseDuration *
          Math.abs(distance)
      );

      const startTime =
        performance.now();

      const animate = (
        currentTime: number
      ) => {
        const elapsed =
          currentTime - startTime;

        const timeProgress =
          clamp(
            elapsed / duration
          );

        const eased =
          target === 1
            ? easeOutQuint(
                timeProgress
              )
            : easeInOutCubic(
                timeProgress
              );

        progress = clamp(
          startProgress +
            distance * eased
        );

        wheelTarget = progress;

        render();

        if (timeProgress < 1) {
          snapFrame =
            requestAnimationFrame(
              animate
            );

          return;
        }

        completeSnap(target);
      };

      snapFrame =
        requestAnimationFrame(
          animate
        );
    };

    const evaluateThreshold = (
      direction: number
    ) => {
      if (
        direction > 0 &&
        progress >=
          FORWARD_THRESHOLD
      ) {
        snapTo(1);
        return true;
      }

      if (
        direction < 0 &&
        progress <=
          BACKWARD_THRESHOLD
      ) {
        snapTo(0);
        return true;
      }

      return false;
    };

    /*
     * ホイールの段差を直接描画せず、
     * wheelTargetを滑らかに追いかける。
     */
    const startWheelInterpolation = (
      direction: number
    ) => {
      cancelRenderFrame();

      const animate = () => {
        if (isSnapping) {
          renderFrame = 0;
          return;
        }

        const difference =
          wheelTarget - progress;

        progress +=
          difference * 0.18;

        if (
          Math.abs(difference) <
          0.001
        ) {
          progress =
            wheelTarget;
        }

        progress =
          clamp(progress);

        if (progress < 1) {
          hideHeader();
        }

        render();

        if (
          evaluateThreshold(
            direction
          )
        ) {
          renderFrame = 0;
          return;
        }

        if (
          Math.abs(
            wheelTarget -
              progress
          ) > 0.001
        ) {
          renderFrame =
            requestAnimationFrame(
              animate
            );

          return;
        }

        renderFrame = 0;
      };

      renderFrame =
        requestAnimationFrame(
          animate
        );
    };

    const handleWheel = (
      event: WheelEvent
    ) => {
      event.preventDefault();

      if (
        Math.abs(
          event.deltaY
        ) < 0.5
      ) {
        return;
      }

      const direction =
        Math.sign(
          event.deltaY
        );

      if (isSnapping) {
        const isReversing =
          (snapTarget === 1 &&
            direction < 0) ||
          (snapTarget === 0 &&
            direction > 0);

        if (!isReversing) {
          return;
        }

        cancelSnap();
      }

      const normalizedDelta =
        Math.min(
          Math.max(
            Math.abs(
              event.deltaY
            ),
            22
          ),
          120
        );

      wheelTarget = clamp(
        wheelTarget +
          (direction *
            normalizedDelta) /
            WHEEL_DISTANCE
      );

      startWheelInterpolation(
        direction
      );

      window.clearTimeout(
        wheelEndTimer
      );

      wheelEndTimer =
        window.setTimeout(() => {
          evaluateThreshold(
            direction
          );
        }, 70);
    };
        const handleTouchStart = (
      event: TouchEvent
    ) => {
      if (
        event.touches.length !== 1
      ) {
        return;
      }

      const touchY =
        event.touches[0].clientY;

      isTouching = true;
      touchStartY = touchY;
      touchLastY = touchY;
      touchStartProgress = progress;
      touchDirection = 0;

      cancelRenderFrame();

      if (isSnapping) {
        cancelSnap();
      }
    };

    const handleTouchMove = (
      event: TouchEvent
    ) => {
      if (
        !isTouching ||
        event.touches.length !== 1
      ) {
        return;
      }

      event.preventDefault();

      const touchY =
        event.touches[0].clientY;

      const totalDistance =
        touchStartY - touchY;

      const frameDistance =
        touchLastY - touchY;

      touchLastY = touchY;

      if (
        Math.abs(frameDistance) >
        0.5
      ) {
        touchDirection =
          Math.sign(
            frameDistance
          );
      }

      /*
       * 指の移動距離へ直接追従する。
       */
      progress = clamp(
        touchStartProgress +
          totalDistance /
            TOUCH_DISTANCE
      );

      wheelTarget = progress;

      if (progress < 1) {
        hideHeader();
      }

      render();

      /*
       * 閾値へ到達したら、
       * 残りを自動的に進める。
       */
      if (
        evaluateThreshold(
          touchDirection
        )
      ) {
        isTouching = false;
      }
    };

    const handleTouchEnd = () => {
      if (!isTouching) {
        return;
      }

      isTouching = false;

      /*
       * 閾値未満の場合は、
       * 現在位置に留める。
       */
      evaluateThreshold(
        touchDirection
      );
    };

    const handleKeyDown = (
      event: KeyboardEvent
    ) => {
      const forwardKeys = [
        "ArrowDown",
        "PageDown",
        " ",
        "Enter",
      ];

      const backwardKeys = [
        "ArrowUp",
        "PageUp",
        "Escape",
      ];

      const isForward =
        forwardKeys.includes(
          event.key
        );

      const isBackward =
        backwardKeys.includes(
          event.key
        );

      if (
        !isForward &&
        !isBackward
      ) {
        return;
      }

      event.preventDefault();

      if (isForward) {
        snapTo(1);
      } else {
        snapTo(0);
      }
    };

    const cleanup = () => {
      cancelRenderFrame();
      cancelSnap();

      window.clearTimeout(
        wheelEndTimer
      );

      clearHeaderTimer();

      window.removeEventListener(
        "wheel",
        handleWheel
      );

      window.removeEventListener(
        "touchstart",
        handleTouchStart
      );

      window.removeEventListener(
        "touchmove",
        handleTouchMove
      );

      window.removeEventListener(
        "touchend",
        handleTouchEnd
      );

      window.removeEventListener(
        "touchcancel",
        handleTouchEnd
      );

      window.removeEventListener(
        "keydown",
        handleKeyDown
      );

      document.removeEventListener(
        "astro:before-swap",
        cleanup
      );
    };

    render();
    hideHeader();

    window.addEventListener(
      "wheel",
      handleWheel,
      {
        passive: false,
      }
    );

    window.addEventListener(
      "touchstart",
      handleTouchStart,
      {
        passive: true,
      }
    );

    window.addEventListener(
      "touchmove",
      handleTouchMove,
      {
        passive: false,
      }
    );

    window.addEventListener(
      "touchend",
      handleTouchEnd,
      {
        passive: true,
      }
    );

    window.addEventListener(
      "touchcancel",
      handleTouchEnd,
      {
        passive: true,
      }
    );

    window.addEventListener(
      "keydown",
      handleKeyDown
    );

    document.addEventListener(
      "astro:before-swap",
      cleanup
    );
  }
</script>

<style>
  .entrance-experience {
    --logo-scale: 1;
    --logo-opacity: 1;

    --lobby-scale: 0.72;
    --lobby-approach-opacity: 0;

    --veil-opacity: 0;

    --desktop-height-px: 620px;
    --desktop-height-vh: 60vh;

    position: fixed;
    inset: 0;
    z-index: 1;

    width: 100%;
    height: 100svh;

    overflow: hidden;
    overscroll-behavior: none;
    touch-action: none;

    background: #fff;
  }

  .entrance-experience__lobby-stage {
    position: absolute;
    inset: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    background: #fff;

    pointer-events: none;
  }

  .entrance-experience__lobby-layer {
    position: absolute;
    inset: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    transform:
      scale(
        var(--lobby-scale)
      );

    transform-origin: center;

    will-change:
      transform,
      opacity;

    pointer-events: none;
  }

  /*
   * 接近中に見える薄い遠景。
   *
   * スクロール量に応じて小→大へ進み、
   * ロビーへ到着すると役割を終える。
   */
  .entrance-experience__lobby-layer--approach {
    opacity:
      var(
        --lobby-approach-opacity
      );

    transition:
      opacity 180ms linear;
  }

  /*
   * 入館完了後の鮮明なロビー画像。
   *
   * LogoButton / MenuButtonと同じ
   * 900ms easeで表示する。
   */
  .entrance-experience__lobby-layer--final {
    opacity: 0;

    transition:
      opacity 900ms ease;
  }

  .entrance-experience.is-lobby-complete
    .entrance-experience__lobby-layer--approach {
    opacity: 0;
  }

  .entrance-experience.is-lobby-complete
    .entrance-experience__lobby-layer--final {
    opacity: 1;
  }

  .entrance-experience__lobby-image {
    display: block;

    width: auto;
    max-width: 100%;

    height: min(
      var(--desktop-height-vh),
      var(--desktop-height-px)
    );

    max-height: 100svh;

    object-fit: contain;

    pointer-events: none;
    user-select: none;
  }

  .entrance-experience__veil {
    position: absolute;
    inset: 0;

    opacity: calc(
      var(--veil-opacity) * 0.1
    );

    background: #fff;

    pointer-events: none;

    will-change: opacity;
  }

  .entrance-experience__logo {
    position: absolute;
    top: 50%;
    left: 50%;

    width: min(
      680px,
      calc(100vw - 48px)
    );

    height: auto;
    overflow: visible;

    opacity:
      var(
        --logo-opacity
      );

    transform:
      translate(-50%, -50%)
      scale(
        var(--logo-scale)
      );

    transform-origin: center;

    pointer-events: none;
    user-select: none;

    will-change:
      transform,
      opacity;
  }

  .entrance-experience__logo-text {
    fill:
      var(
        --navigation-color
      );

    font-family:
      var(
        --site-font-family
      );

    font-size: 34px;
    font-weight: 400;
    letter-spacing: 0.08em;
  }

  /*
   * タブレット・スマホでは、
   * 横幅100%・高さ自動。
   *
   * 画像の縦横比を維持し、
   * 上下の余白は白背景として残す。
   */
  @media (max-width: 1024px) {
    .entrance-experience__lobby-image {
      width: 100%;
      max-width: none;

      height: auto;
      max-height: 100svh;

      object-fit: contain;
    }
  }

  @media (max-width: 640px) {
    .entrance-experience__logo {
      width: calc(
        100vw - 32px
      );
    }

    .entrance-experience__logo-text {
      font-size: 32px;
    }
  }

  @media (
    prefers-reduced-motion:
    reduce
  ) {
    .entrance-experience__lobby-layer--approach,
    .entrance-experience__lobby-layer--final {
      transition-duration: 1ms;
    }
  }
</style>