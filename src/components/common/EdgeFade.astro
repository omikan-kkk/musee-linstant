---
const {
  horizontal = false,
  fixedHorizontal = false,
} = Astro.props;
---

<div
  class:list={[
    "edge-fade",
    horizontal &&
      "has-horizontal",
    fixedHorizontal &&
      "is-fixed-horizontal",
  ]}
  aria-hidden="true"
>
  <span class="edge-fade-top"></span>
  <span class="edge-fade-bottom"></span>
  <span class="edge-fade-left"></span>
  <span class="edge-fade-right"></span>
</div>

<style>
  .edge-fade {
    --edge-fade-size-top:
      80px;

    --edge-fade-size-bottom:
      42px;

    --edge-fade-size-x:
      32px;

    --edge-fade-scrollbar-clearance:
      0px;

    position: sticky;
    top: 0;

    width: 100%;
    height: 100dvh;

    margin-bottom:
      -100dvh;

    overflow: hidden;

    pointer-events: none;

    z-index: 900;
  }

  /*
   * type:book専用。
   *
   * 横長の文書とは独立し、
   * viewportの四辺へ固定する。
   */
  .edge-fade.is-fixed-horizontal {
    position: fixed;

    top: 0;
    right: 0;
    bottom: 0;
    left: 0;

    width: 100vw;
    height: 100dvh;

    margin: 0;

    overflow: hidden;

    /*
     * 本棚より確実に前、
     * ヘッダーのz-index:2000より後ろ。
     */
    z-index: 1900;

    /*
     * iOS Safariを含め、
     * 固定フェードを独立した合成レイヤーへ置く。
     */
    transform:
      translate3d(
        0,
        0,
        0
      );

    backface-visibility:
      hidden;

    will-change:
      transform;
  }

  .edge-fade span {
    position: absolute;

    pointer-events: none;

    z-index: 1;
  }

  .edge-fade-top {
    top: 0;
    left: 0;
    right: 0;

    height: calc(
      env(
          safe-area-inset-top,
          0px
        ) +
        var(
          --edge-fade-size-top
        )
    );

    background:
      linear-gradient(
        to bottom,
        #fff 0,
        #fff
          env(
            safe-area-inset-top,
            0px
          ),
        rgba(
            255,
            255,
            255,
            0.98
          )
          calc(
            env(
                safe-area-inset-top,
                0px
              ) +
              var(
                  --edge-fade-size-top
                ) *
                0.15
          ),
        rgba(
            255,
            255,
            255,
            0.88
          )
          calc(
            env(
                safe-area-inset-top,
                0px
              ) +
              var(
                  --edge-fade-size-top
                ) *
                0.35
          ),
        rgba(
            255,
            255,
            255,
            0.55
          )
          calc(
            env(
                safe-area-inset-top,
                0px
              ) +
              var(
                  --edge-fade-size-top
                ) *
                0.72
          ),
        rgba(
            255,
            255,
            255,
            0
          )
          calc(
            env(
                safe-area-inset-top,
                0px
              ) +
              var(
                --edge-fade-size-top
              )
          )
      );
  }

  .edge-fade-bottom {
    bottom:
      var(
        --edge-fade-scrollbar-clearance
      );

    left: 0;
    right: 0;

    height: calc(
      env(
          safe-area-inset-bottom,
          0px
        ) +
        var(
          --edge-fade-size-bottom
        )
    );

    background:
      linear-gradient(
        to top,
        #fff 0,
        rgba(
            255,
            255,
            255,
            0.99
          )
          calc(
            env(
                safe-area-inset-bottom,
                0px
              ) +
              var(
                  --edge-fade-size-bottom
                ) *
                0.10
          ),
        rgba(
            255,
            255,
            255,
            0.98
          )
          calc(
            env(
                safe-area-inset-bottom,
                0px
              ) +
              var(
                  --edge-fade-size-bottom
                ) *
                0.20
          ),
        rgba(
            255,
            255,
            255,
            0.95
          )
          calc(
            env(
                safe-area-inset-bottom,
                0px
              ) +
              var(
                  --edge-fade-size-bottom
                ) *
                0.30
          ),
        rgba(
            255,
            255,
            255,
            0.90
          )
          calc(
            env(
                safe-area-inset-bottom,
                0px
              ) +
              var(
                  --edge-fade-size-bottom
                ) *
                0.40
          ),
        rgba(
            255,
            255,
            255,
            0.81
          )
          calc(
            env(
                safe-area-inset-bottom,
                0px
              ) +
              var(
                  --edge-fade-size-bottom
                ) *
                0.50
          ),
        rgba(
            255,
            255,
            255,
            0.67
          )
          calc(
            env(
                safe-area-inset-bottom,
                0px
              ) +
              var(
                  --edge-fade-size-bottom
                ) *
                0.60
          ),
        rgba(
            255,
            255,
            255,
            0.50
          )
          calc(
            env(
                safe-area-inset-bottom,
                0px
              ) +
              var(
                  --edge-fade-size-bottom
                ) *
                0.70
          ),
        rgba(
            255,
            255,
            255,
            0.30
          )
          calc(
            env(
                safe-area-inset-bottom,
                0px
              ) +
              var(
                  --edge-fade-size-bottom
                ) *
                0.80
          ),
        rgba(
            255,
            255,
            255,
            0.05
          )
          calc(
            env(
                safe-area-inset-bottom,
                0px
              ) +
              var(
                  --edge-fade-size-bottom
                ) *
                0.90
          ),
        rgba(
            255,
            255,
            255,
            0
          )
          calc(
            env(
                safe-area-inset-bottom,
                0px
              ) +
              var(
                --edge-fade-size-bottom
              )
          )
      );
  }

  .edge-fade-left,
  .edge-fade-right {
    display: none;
  }

  .edge-fade.has-horizontal
    .edge-fade-left {
    display: block;

    top: 0;
    bottom:
      var(
        --edge-fade-scrollbar-clearance
      );

    left: 0;

    width:
      var(
        --edge-fade-size-x
      );

    background:
      linear-gradient(
        to right,
        #fff 0%,
        rgba(
            255,
            255,
            255,
            0.98
          )
          12%,
        rgba(
            255,
            255,
            255,
            0.88
          )
          28%,
        rgba(
            255,
            255,
            255,
            0.55
          )
          58%,
        rgba(
            255,
            255,
            255,
            0
          )
          100%
      );
  }

  .edge-fade.has-horizontal
    .edge-fade-right {
    display: block;

    top: 0;
    right: 0;

    bottom:
      var(
        --edge-fade-scrollbar-clearance
      );

    width:
      var(
        --edge-fade-size-x
      );

    background:
      linear-gradient(
        to left,
        #fff 0%,
        rgba(
            255,
            255,
            255,
            0.98
          )
          12%,
        rgba(
            255,
            255,
            255,
            0.88
          )
          28%,
        rgba(
            255,
            255,
            255,
            0.55
          )
          58%,
        rgba(
            255,
            255,
            255,
            0
          )
          100%
      );
  }

  /*
   * PCでは横スクロールバーの領域を
   * 左右・下フェードで覆わない。
   *
   * Layout側のバー高さ14pxと揃える。
   */
  @media (
    hover: hover
  ) and (
    pointer: fine
  ) {
    .edge-fade.is-fixed-horizontal {
      --edge-fade-scrollbar-clearance:
        14px;
    }
  }

  /*
   * スマホではSafariが管理する
   * 最下部の表示領域を覆わない。
   */
  @media (
    hover: none
  ) and (
    pointer: coarse
  ) {
    .edge-fade.is-fixed-horizontal {
      --edge-fade-scrollbar-clearance:
        env(
          safe-area-inset-bottom,
          0px
        );
    }
  }
</style>