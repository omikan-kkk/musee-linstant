---
import Layout from "../../layouts/Layout.astro";
import { CATEGORIES } from "../../config/site";
import { CONTENTS } from "../../data/contents";

export function getStaticPaths() {
  return CATEGORIES
    .filter((category) => category.visible)
    .map((category) => ({
      params: { category: category.slug },
      props: { category },
    }));
}

const { category } = Astro.props;

const categoryType = category.type || "gallery";
const isBook = categoryType === "book";
const isCoffee = categoryType === "coffee";

function formatCoffeeDate(date = "") {
  return date.replaceAll("-", "/");
}

const categoryContents = CONTENTS.filter(
  (content) => content.categoryId === category.id
);

const contents = isCoffee
  ? categoryContents.sort((a, b) =>
      (b.date || "").localeCompare(a.date || "")
    )
  : categoryContents.sort((a, b) => a.order - b.order);
---

<Layout title={`${category.title} | Musée de l'Instant CMS`} showHeader={false}>
  <main
    class="admin"
    data-category-id={category.id}
    data-category-type={categoryType}
  >
    <header>
      <a href="/admin">← Categories</a>

      <h1>{category.title}</h1>

      <a
        class="add-button"
        href={`/admin/${category.slug}/new`}
      >
        ＋ Add Content
      </a>

      {isCoffee && (
        <button
          type="button"
          id="manage-brands-button"
          class="manage-brands-button"
          aria-expanded="false"
          aria-controls="brand-management"
        >
          Manage Brands
        </button>
      )}
    </header>

    {isCoffee && (
      <section
        id="brand-management"
        class="brand-management"
        hidden
      >
        <div class="brand-management-header">
          <h2>Brand Management</h2>

          <p>
            Select a Brand to rename every exact match.
          </p>
        </div>

        <div
          id="brand-list"
          class="brand-list"
        ></div>

        <p
          id="brand-list-status"
          class="brand-list-status"
          aria-live="polite"
        ></p>

        <div
          id="brand-rename-editor"
          class="brand-rename-editor"
          hidden
        >
          <div class="brand-current">
            <span class="brand-label">
              Current
            </span>

            <strong id="current-brand"></strong>

            <span
              id="current-brand-count"
              class="brand-count-detail"
            ></span>
          </div>

          <div class="brand-rename-field">
            <label for="rename-brand-input">
              Rename to
            </label>

            <input
              id="rename-brand-input"
              type="text"
              autocomplete="off"
            />
          </div>

          <div class="brand-rename-actions">
            <button
              type="button"
              id="rename-brand-button"
              class="rename-brand-button"
            >
              Rename All
            </button>

            <button
              type="button"
              id="cancel-brand-rename-button"
              class="cancel-brand-rename-button"
            >
              Cancel
            </button>

            <p
              id="brand-rename-status"
              aria-live="polite"
            ></p>
          </div>
        </div>
      </section>
    )}

    <section
      class:list={["content-list", isCoffee && "is-coffee"]}
      id="content-list"
    >
      {contents.map((content) => (
        <div
          class="content-row"
          draggable={!isCoffee}
          data-content-id={content.id}
        >
          {!isCoffee && (
            <span class="drag-handle">☰</span>
          )}

          <a href={`/admin/${category.slug}/${content.id}`}>
            {isBook
              ? `${content.author || "Unknown"} / ${content.title || "Untitled"}`
              : isCoffee
                ? `${formatCoffeeDate(content.date)} / ${content.brand || "Unknown"} / ${content.coffeeName || "Untitled"}`
                : content.title || "Untitled"}
          </a>
        </div>
      ))}
    </section>

    {!isCoffee && (
      <div class="actions">
        <button
          type="button"
          id="save-order-button"
          class="save-order-button"
        >
          Save Order
        </button>

        <p
          id="save-status"
          aria-live="polite"
        ></p>
      </div>
    )}
  </main>

  <script type="module">
    import {
      requireLogin,
      authFetch,
    } from "../../lib/auth";

    requireLogin();

    const admin =
      document.querySelector(".admin");

    const categoryId =
      admin?.getAttribute(
        "data-category-id"
      );

    const categoryType =
      admin?.getAttribute(
        "data-category-type"
      ) || "gallery";

    const list =
      document.querySelector(
        "#content-list"
      );

    const saveButton =
      document.querySelector(
        "#save-order-button"
      );

    const saveStatus =
      document.querySelector(
        "#save-status"
      );

    /*
     * ==================================================
     *
     * Content Order
     *
     * ==================================================
     */

    let draggedRow = null;

    list?.addEventListener(
      "dragstart",
      (event) => {
        const row =
          event.target.closest(
            ".content-row"
          );

        if (
          !row ||
          row.getAttribute(
            "draggable"
          ) !== "true"
        ) {
          return;
        }

        draggedRow = row;

        row.classList.add(
          "is-dragging"
        );
      }
    );

    list?.addEventListener(
      "dragend",
      () => {
        if (draggedRow) {
          draggedRow.classList.remove(
            "is-dragging"
          );
        }

        draggedRow = null;
      }
    );

    list?.addEventListener(
      "dragover",
      (event) => {
        const dragging =
          document.querySelector(
            ".is-dragging"
          );

        if (!dragging) {
          return;
        }

        event.preventDefault();

        const rows = [
          ...list.querySelectorAll(
            ".content-row:not(.is-dragging)"
          ),
        ];

        const nextRow =
          rows.find(
            (row) => {
              const box =
                row.getBoundingClientRect();

              return (
                event.clientY <
                box.top +
                  box.height / 2
              );
            }
          );

        if (nextRow) {
          list.insertBefore(
            dragging,
            nextRow
          );
        } else {
          list.appendChild(
            dragging
          );
        }
      }
    );

    saveButton?.addEventListener(
      "click",
      async () => {
        if (
          !categoryId ||
          !list ||
          !saveStatus
        ) {
          return;
        }

        saveStatus.textContent =
          "Saving...";

        const orderedIds = [
          ...list.querySelectorAll(
            ".content-row"
          ),
        ]
          .map((row) =>
            row.getAttribute(
              "data-content-id"
            )
          )
          .filter(Boolean);

        try {
          const currentRes =
            await authFetch(
              "/contents"
            );

          const currentData =
            await currentRes.json();

          if (!currentData.ok) {
            throw new Error(
              "Could not load contents."
            );
          }

          const nextContents =
            currentData.contents.map(
              (content) => {
                if (
                  content.categoryId !==
                  categoryId
                ) {
                  return content;
                }

                const index =
                  orderedIds.indexOf(
                    content.id
                  );

                if (
                  index === -1
                ) {
                  return content;
                }

                return {
                  ...content,
                  order: index + 1,
                };
              }
            );

          const saveRes =
            await authFetch(
              "/contents",
              {
                method: "POST",
                headers: {
                  "Content-Type":
                    "application/json",
                },
                body: JSON.stringify({
                  contents:
                    nextContents,
                }),
              }
            );

          const saveData =
            await saveRes.json();

          if (!saveData.ok) {
            throw new Error(
              "Could not save order."
            );
          }

          saveStatus.textContent =
            "Order saved";
        } catch (error) {
          console.error(error);

          saveStatus.textContent =
            "Save failed";
        }
      }
    );

    /*
     * ==================================================
     *
     * Brand Management
     *
     * ==================================================
     */

    const manageBrandsButton =
      document.querySelector(
        "#manage-brands-button"
      );

    const brandManagement =
      document.querySelector(
        "#brand-management"
      );

    const brandList =
      document.querySelector(
        "#brand-list"
      );

    const brandListStatus =
      document.querySelector(
        "#brand-list-status"
      );

    const brandRenameEditor =
      document.querySelector(
        "#brand-rename-editor"
      );

    const currentBrandElement =
      document.querySelector(
        "#current-brand"
      );

    const currentBrandCountElement =
      document.querySelector(
        "#current-brand-count"
      );

    const renameBrandInput =
      document.querySelector(
        "#rename-brand-input"
      );

    const renameBrandButton =
      document.querySelector(
        "#rename-brand-button"
      );

    const cancelBrandRenameButton =
      document.querySelector(
        "#cancel-brand-rename-button"
      );

    const brandRenameStatus =
      document.querySelector(
        "#brand-rename-status"
      );

    let selectedBrand = null;

    async function loadContents() {
      const response =
        await authFetch(
          "/contents"
        );

      const data =
        await response.json();

      if (!data.ok) {
        throw new Error(
          "Could not load contents."
        );
      }

      return data.contents;
    }

    async function saveContents(
      contents
    ) {
      const response =
        await authFetch(
          "/contents",
          {
            method: "POST",
            headers: {
              "Content-Type":
                "application/json",
            },
            body: JSON.stringify({
              contents,
            }),
          }
        );

      const data =
        await response.json();

      if (!data.ok) {
        throw new Error(
          "Could not save contents."
        );
      }

      return data;
    }

    function buildBrandEntries(
      contents
    ) {
      const counts =
        new Map();

      for (
        const content of contents
      ) {
        if (
          content.categoryId !==
          categoryId
        ) {
          continue;
        }

        if (
          typeof content.brand !==
          "string"
        ) {
          continue;
        }

        /*
         * 空欄判定にだけ trim を使う。
         *
         * Brandそのものには
         * trim / lowercase / normalize等を
         * 一切適用しない。
         */
        if (
          !content.brand.trim()
        ) {
          continue;
        }

        const brand =
          content.brand;

        counts.set(
          brand,
          (counts.get(brand) || 0) +
            1
        );
      }

      /*
       * 表記そのものは変更せず、
       * 管理しやすいように
       * 一覧だけ文字順に並べる。
       *
       * 大文字小文字等の差異は
       * Map上では完全に別Brand。
       */
      return [
        ...counts.entries(),
      ]
        .map(
          ([brand, count]) => ({
            brand,
            count,
          })
        )
        .sort((a, b) =>
          a.brand.localeCompare(
            b.brand
          )
        );
    }

    function closeRenameEditor() {
      selectedBrand = null;

      if (
        brandRenameEditor
      ) {
        brandRenameEditor.hidden =
          true;
      }

      if (
        currentBrandElement
      ) {
        currentBrandElement.textContent =
          "";
      }

      if (
        currentBrandCountElement
      ) {
        currentBrandCountElement.textContent =
          "";
      }

      if (
        renameBrandInput
      ) {
        renameBrandInput.value =
          "";
      }

      if (
        brandRenameStatus
      ) {
        brandRenameStatus.textContent =
          "";
      }

      brandList
        ?.querySelectorAll(
          ".brand-row.is-selected"
        )
        .forEach((row) => {
          row.classList.remove(
            "is-selected"
          );
        });
    }

    function openRenameEditor(
      brand,
      count,
      row
    ) {
      selectedBrand = brand;

      brandList
        ?.querySelectorAll(
          ".brand-row.is-selected"
        )
        .forEach(
          (brandRow) => {
            brandRow.classList.remove(
              "is-selected"
            );
          }
        );

      row.classList.add(
        "is-selected"
      );

      if (
        currentBrandElement
      ) {
        currentBrandElement.textContent =
          brand;
      }

      if (
        currentBrandCountElement
      ) {
        currentBrandCountElement.textContent =
          `${count} ${
            count === 1
              ? "content"
              : "contents"
          }`;
      }

      if (
        renameBrandInput
      ) {
        renameBrandInput.value =
          brand;
      }

      if (
        brandRenameStatus
      ) {
        brandRenameStatus.textContent =
          "";
      }

      if (
        brandRenameEditor
      ) {
        brandRenameEditor.hidden =
          false;
      }

      renameBrandInput?.focus();

      renameBrandInput?.select();
    }

    function renderBrandList(
      contents
    ) {
      if (
        !brandList ||
        !brandListStatus
      ) {
        return;
      }

      closeRenameEditor();

      brandList.replaceChildren();

      const entries =
        buildBrandEntries(
          contents
        );

      if (
        entries.length === 0
      ) {
        brandListStatus.textContent =
          "No Brands found.";

        return;
      }

      brandListStatus.textContent =
        "";

      for (
        const {
          brand,
          count,
        } of entries
      ) {
        const row =
          document.createElement(
            "button"
          );

        row.type = "button";

        row.className =
          "brand-row";

        const name =
          document.createElement(
            "span"
          );

        name.className =
          "brand-name";

        name.textContent =
          brand;

        const countElement =
          document.createElement(
            "span"
          );

        countElement.className =
          "brand-count";

        countElement.textContent =
          String(count);

        row.append(
          name,
          countElement
        );

        row.addEventListener(
          "click",
          () => {
            openRenameEditor(
              brand,
              count,
              row
            );
          }
        );

        brandList.append(
          row
        );
      }
    }

    async function refreshBrandList() {
      if (
        !brandListStatus
      ) {
        return;
      }

      brandListStatus.textContent =
        "Loading...";

      try {
        const contents =
          await loadContents();

        renderBrandList(
          contents
        );
      } catch (error) {
        console.error(error);

        brandListStatus.textContent =
          "Could not load Brands.";
      }
    }

    function updateCoffeeContentRows(
      contents
    ) {
      if (!list) {
        return;
      }

      const byId =
        new Map(
          contents.map(
            (content) => [
              content.id,
              content,
            ]
          )
        );

      const rows = [
        ...list.querySelectorAll(
          ".content-row"
        ),
      ];

      for (
        const row of rows
      ) {
        const contentId =
          row.getAttribute(
            "data-content-id"
          );

        if (!contentId) {
          continue;
        }

        const content =
          byId.get(
            contentId
          );

        if (!content) {
          continue;
        }

        const link =
          row.querySelector("a");

        if (!link) {
          continue;
        }

        const date =
          (
            content.date ||
            ""
          ).replaceAll(
            "-",
            "/"
          );

        const brand =
          content.brand ||
          "Unknown";

        const coffeeName =
          content.coffeeName ||
          "Untitled";

        link.textContent =
          `${date} / ${brand} / ${coffeeName}`;
      }
    }

    manageBrandsButton?.addEventListener(
      "click",
      async () => {
        if (
          !brandManagement
        ) {
          return;
        }

        const willOpen =
          brandManagement.hidden;

        if (!willOpen) {
          brandManagement.hidden =
            true;

          manageBrandsButton.setAttribute(
            "aria-expanded",
            "false"
          );

          closeRenameEditor();

          return;
        }

        brandManagement.hidden =
          false;

        manageBrandsButton.setAttribute(
          "aria-expanded",
          "true"
        );

        await refreshBrandList();
      }
    );

    cancelBrandRenameButton?.addEventListener(
      "click",
      () => {
        closeRenameEditor();
      }
    );

    renameBrandButton?.addEventListener(
      "click",
      async () => {
        if (
          !selectedBrand ||
          !renameBrandInput ||
          !brandRenameStatus ||
          !renameBrandButton
        ) {
          return;
        }

        /*
         * 保存済みCoffee入力と同様、
         * Rename先については
         * 前後の余分な空白を除去する。
         *
         * 既存Brand側の比較は
         * 完全一致のまま。
         */
        const nextBrand =
          renameBrandInput.value.trim();

        if (!nextBrand) {
          brandRenameStatus.textContent =
            "Brand is required.";

          return;
        }

        if (
          nextBrand ===
          selectedBrand
        ) {
          brandRenameStatus.textContent =
            "No change.";

          return;
        }

        renameBrandButton.disabled =
          true;

        brandRenameStatus.textContent =
          "Checking...";

        try {
          /*
           * Rename直前に
           * 最新のcontentsを再取得する。
           */
          const currentContents =
            await loadContents();

          const exactMatches =
            currentContents.filter(
              (content) =>
                content.categoryId ===
                  categoryId &&
                content.brand ===
                  selectedBrand
            );

          if (
            exactMatches.length ===
            0
          ) {
            brandRenameStatus.textContent =
              "No matching contents found.";

            await refreshBrandList();

            return;
          }

          const confirmed =
            window.confirm(
              `Rename "${selectedBrand}" to "${nextBrand}" in ${exactMatches.length} ${
                exactMatches.length === 1
                  ? "content"
                  : "contents"
              }?`
            );

          if (!confirmed) {
            brandRenameStatus.textContent =
              "";

            return;
          }

          brandRenameStatus.textContent =
            "Saving...";

          const nextContents =
            currentContents.map(
              (content) => {
                if (
                  content.categoryId ===
                    categoryId &&
                  content.brand ===
                    selectedBrand
                ) {
                  return {
                    ...content,
                    brand:
                      nextBrand,
                  };
                }

                return content;
              }
            );

          await saveContents(
            nextContents
          );

          updateCoffeeContentRows(
            nextContents
          );

          renderBrandList(
            nextContents
          );

          brandListStatus.textContent =
            `Renamed ${exactMatches.length} ${
              exactMatches.length === 1
                ? "content"
                : "contents"
            }.`;
        } catch (error) {
          console.error(error);

          brandRenameStatus.textContent =
            "Rename failed";
        } finally {
          renameBrandButton.disabled =
            false;
        }
      }
    );

    renameBrandInput?.addEventListener(
      "keydown",
      (event) => {
        if (
          event.key === "Enter"
        ) {
          event.preventDefault();

          renameBrandButton?.click();
        }

        if (
          event.key === "Escape"
        ) {
          closeRenameEditor();
        }
      }
    );
  </script>
</Layout>

<style>
.admin{
  max-width:720px;
  margin:120px auto;
  padding:24px;
  font-family:"Helvetica Neue", Helvetica, Arial, sans-serif;
}

header{
  display:flex;
  flex-direction:column;
  gap:20px;
  margin-bottom:48px;
}

header a{
  text-decoration:none;
  color:#777;
  font-size:12px;
}

h1{
  margin:0;
  font-size:24px;
  font-weight:400;
}

.add-button{
  align-self:flex-start;
  color:#111;
}

.manage-brands-button{
  align-self:flex-start;
  border:0;
  background:transparent;
  color:#999;
  padding:0;
  font:inherit;
  font-size:12px;
  cursor:pointer;
}

.manage-brands-button:hover,
.manage-brands-button:focus{
  color:#111;
}

.brand-management{
  margin-bottom:56px;
  padding:24px;
  border:1px solid #e5e5e5;
}

.brand-management[hidden]{
  display:none;
}

.brand-management-header{
  margin-bottom:28px;
}

.brand-management-header h2{
  margin:0 0 8px;
  font-size:16px;
  font-weight:400;
}

.brand-management-header p{
  margin:0;
  color:#999;
  font-size:11px;
  line-height:1.6;
}

.brand-list{
  display:flex;
  flex-direction:column;
}

.brand-row{
  display:grid;
  grid-template-columns:minmax(0,1fr) auto;
  align-items:center;
  gap:24px;

  width:100%;
  border:0;
  border-top:1px solid #eee;
  background:transparent;

  padding:13px 0;

  color:#111;
  text-align:left;
  font:inherit;

  cursor:pointer;
}

.brand-row:last-child{
  border-bottom:1px solid #eee;
}

.brand-row:hover,
.brand-row:focus,
.brand-row.is-selected{
  background:#fafafa;
  outline:none;
}

.brand-name{
  min-width:0;
  font-size:14px;
  line-height:1.5;
  overflow-wrap:anywhere;
}

.brand-count{
  color:#999;
  font-size:11px;
  font-variant-numeric:tabular-nums;
}

.brand-list-status{
  margin:16px 0 0;
  color:#999;
  font-size:11px;
}

.brand-rename-editor{
  margin-top:32px;
  padding-top:28px;
  border-top:1px solid #ddd;
}

.brand-rename-editor[hidden]{
  display:none;
}

.brand-current{
  display:flex;
  flex-direction:column;
  gap:8px;
  margin-bottom:24px;
}

.brand-label{
  color:#999;
  font-size:10px;
  letter-spacing:.12em;
  text-transform:uppercase;
}

.brand-current strong{
  font-size:16px;
  font-weight:400;
  overflow-wrap:anywhere;
}

.brand-count-detail{
  color:#999;
  font-size:11px;
}

.brand-rename-field{
  display:flex;
  flex-direction:column;
  gap:10px;
}

.brand-rename-field label{
  color:#777;
  font-size:11px;
  letter-spacing:.12em;
}

.brand-rename-field input{
  width:100%;
  box-sizing:border-box;
  border:1px solid #ddd;
  background:#fff;
  color:#111;
  padding:12px;
  font:inherit;
  font-size:14px;
  line-height:1.8;
}

.brand-rename-actions{
  display:flex;
  align-items:center;
  gap:16px;
  flex-wrap:wrap;
  margin-top:18px;
}

.rename-brand-button{
  border:none;
  background:#111;
  color:#fff;
  padding:12px 18px;
  cursor:pointer;
  font-size:12px;
}

.rename-brand-button:disabled{
  opacity:.5;
  cursor:not-allowed;
}

.cancel-brand-rename-button{
  border:0;
  background:transparent;
  color:#999;
  padding:12px 0;
  cursor:pointer;
  font-size:12px;
}

#brand-rename-status{
  margin:0;
  color:#777;
  font-size:12px;
}

.content-list{
  display:flex;
