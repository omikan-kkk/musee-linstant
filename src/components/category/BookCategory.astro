---
import EdgeFade from "../common/EdgeFade.astro";

const { items = [] } = Astro.props;

const grouped = Object.values(
  items.reduce((groups, item) => {
    const author =
      item.author || "Unknown";

    const authorSort =
      item.authorSort || author;

    if (!groups[author]) {
      groups[author] = {
        author,
        authorSort,
        authorFontSizeOverride:
          item.authorFontSizeOverride ||
          false,
        authorFontSize:
          item.authorFontSize || null,
        books: [],
      };
    }

    groups[author].books.push(
      item
    );

    return groups;
  }, {})
);

grouped.sort((a, b) =>
  a.authorSort.localeCompare(
    b.authorSort,
    "ja"
  )
);

grouped.forEach((group) => {
  group.books.sort((a, b) =>
    (
      a.titleSort ||
      a.title
    ).localeCompare(
      b.titleSort ||
        b.title,
      "ja"
    )
  );
});
---

<section class="book-section">
  <div
    class="book-scroll"
    id="book-scroll"
    data-book-scroll
  >
    <!--
      左右フェードは、
      実際に横スクロールする
      .book-scrollの子要素として配置する。

      スクロールバー自体は
      .book-scrollが描画するため、
      フェードより外側に残る。
    -->
    <EdgeFade
      horizontalOnly={true}
    />

    <div class="bookshelf">
      {
        grouped.map((group) => (
          <div class="author-group">
            <div class="author-column">
              <p
                class="author"
                style={
                  group.authorFontSizeOverride &&
                  group.authorFontSize
                    ? `font-size:${group.authorFontSize}px;`
                    : undefined
                }
              >
                {group.author}
              </p>
            </div>

            <div class="book-list">
              {
                group.books.map(
                  (book) => (
                    <div class="book-column">
                      <p
                        class="book"
                        data-book-item
                        style={
                          book.titleFontSizeOverride &&
                          book.titleFontSize
                            ? `font-size:${book.titleFontSize}px;`
                            : undefined
                        }
                      >
                        {book.title}
                      </p>
                    </div>
                  )
                )
              }
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <script>
    const scrollArea =
      document.querySelector<HTMLElement>(
        "[data-book-scroll]"
      );

    const books = [
      ...document.querySelectorAll<HTMLElement>(
        "[data-book-item]"
      ),
    ];

    let wheelFrame = 0;
    let pendingWheelDelta = 0;

    /*
     * 初回表示時に、
     * ランダムな本を画面中央付近へ配置する。
     */
    const centerRandomBook = () => {
      if (
        !scrollArea ||
        books.length === 0
      ) {
        return;
      }

      const randomBook =
        books[
          Math.floor(
            Math.random() *
              books.length
          )
        ];

      const scrollBox =
        scrollArea.getBoundingClientRect();

      const bookBox =
        randomBook.getBoundingClientRect();

      const bookCenter =
        bookBox.left -
        scrollBox.left +
        scrollArea.scrollLeft +
        bookBox.width / 2;

      const targetScroll =
        bookCenter -
        scrollArea.clientWidth / 2;

      const maxScrollLeft =
        Math.max(
          0,
          scrollArea.scrollWidth -
            scrollArea.clientWidth
        );

      scrollArea.scrollLeft =
        Math.min(
          maxScrollLeft,
          Math.max(
            0,
            targetScroll
          )
        );
    };

    /*
     * 同じフレーム内に届いたwheel入力をまとめて、
     * 横スクロールへ反映する。
     */
    const applyWheelScroll = () => {
      if (!scrollArea) {
        wheelFrame = 0;
        pendingWheelDelta = 0;
        return;
      }

      scrollArea.scrollLeft +=
        pendingWheelDelta;

      pendingWheelDelta = 0;
      wheelFrame = 0;
    };

    /*
     * PCの通常ホイール操作を、
     * type: bookページの横移動へ変換する。
     *
     * スマホのtouch操作には干渉しない。
     */
    const handleWheel = (
      event: WheelEvent
    ) => {
      if (
        !scrollArea ||
        event.ctrlKey
      ) {
        return;
      }

      /*
       * 横入力が強いトラックパッドではdeltaX、
       * 通常のマウスホイールではdeltaYを使う。
       *
       * Shiftキーは不要。
       */
      const horizontalDelta =
        Math.abs(event.deltaX) >
        Math.abs(event.deltaY)
          ? event.deltaX
          : event.deltaY;

      if (
        Math.abs(
          horizontalDelta
        ) < 0.5
      ) {
        return;
      }

      const maxScrollLeft =
        Math.max(
          0,
          scrollArea.scrollWidth -
            scrollArea.clientWidth
        );

      const isAtStart =
        scrollArea.scrollLeft <= 0;

      const isAtEnd =
        scrollArea.scrollLeft >=
        maxScrollLeft - 1;

      const isMovingBackward =
        horizontalDelta < 0;

      const isMovingForward =
        horizontalDelta > 0;

      /*
       * 横方向の端に達していても、
       * bookページ全体を縦へ動かさない。
       */
      if (
        (
          isAtStart &&
          isMovingBackward
        ) ||
        (
          isAtEnd &&
          isMovingForward
        )
      ) {
        event.preventDefault();
        return;
      }

      event.preventDefault();

      pendingWheelDelta +=
        horizontalDelta;

      if (!wheelFrame) {
        wheelFrame =
          requestAnimationFrame(
            applyWheelScroll
          );
      }
    };

    const cleanup = () => {
      if (wheelFrame) {
        cancelAnimationFrame(
          wheelFrame
        );
      }

      wheelFrame = 0;
      pendingWheelDelta = 0;

      scrollArea?.removeEventListener(
        "wheel",
        handleWheel
      );

      document.removeEventListener(
        "astro:before-swap",
        cleanup
      );
    };

    requestAnimationFrame(
      centerRandomBook
    );

    scrollArea?.addEventListener(
      "wheel",
      handleWheel,
      {
        passive: false,
      }
    );

    document.addEventListener(
      "astro:before-swap",
      cleanup
    );
  </script>
</section>

<style>
  .book-section {
    --author-height: 115px;
    --author-gap: 10px;
    --book-column-width: calc(
      var(--book-list-size, 13px) *
        1.8
    );

    width: 100%;
    min-height: 100vh;

    background: #fff;

    color:
      var(
        --book-list-color,
        #111
      );

    font-family:
      var(
        --site-font-family
      );
  }

  /*
   * 実際に横スクロールする要素。
   *
   * flexにはせず、
   * 縦スクロール版と同じ通常のブロックフローで、
   * stickyフェードとコンテンツを重ねる。
   */
  .book-scroll {
    position: relative;

    width: 100vw;
    height: 100vh;
    min-height: 100vh;

    overflow-x: auto;
    overflow-y: hidden;

    -webkit-overflow-scrolling:
      touch;

    overscroll-behavior-x:
      contain;

    /*
     * ネイティブ横スクロールバーを
     * 非表示にしない。
     */
    scrollbar-width: auto;
  }

  /*
   * 横方向用EdgeFadeは、
   * height:100dvhと
   * margin-bottom:-100dvhによって、
   * 本棚の上に重なる。
   *
   * 本棚自体の横幅計算には影響させない。
   */
  .bookshelf {
    display: flex;
    flex-direction: row-reverse;
    align-items: flex-start;

    gap: 72px;

    width: max-content;
    min-width: max-content;
    min-height: 100%;

    padding:
      155px
      50vw;
  }

  .author-group {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .author-column,
  .book-column {
    display: flex;
    align-items: flex-start;
    justify-content: center;

    width:
      var(
        --book-column-width
      );
  }

  .author,
  .book {
    margin: 0;

    writing-mode: vertical-rl;
    text-orientation: mixed;

    font-family:
      var(
        --site-font-family
      );

    font-size:
      var(
        --book-list-size,
        13px
      );

    color:
      var(
        --book-list-color,
        #111
      );

    line-height: 1.8;
    letter-spacing: 0.08em;
  }

  .author-column {
    height:
      var(
        --author-height
      );

    margin:
      0
      0
      var(
        --author-gap
      )
      0;
  }

  .author {
    white-space: nowrap;
  }

  .book-list {
    display: flex;
    flex-direction: row-reverse;
    align-items: flex-start;

    gap: 45px;
  }

  .book {
    white-space: nowrap;
  }
</style>