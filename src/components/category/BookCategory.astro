---
const {
  items = [],
} = Astro.props;

const grouped = Object.values(
  items.reduce(
    (groups, item) => {
      const author =
        item.author ||
        "Unknown";

      const authorSort =
        item.authorSort ||
        author;

      if (!groups[author]) {
        groups[author] = {
          author,
          authorSort,
          authorFontSizeOverride:
            item.authorFontSizeOverride ||
            false,
          authorFontSize:
            item.authorFontSize ||
            null,
          books: [],
        };
      }

      groups[author].books.push(
        item
      );

      return groups;
    },
    {}
  )
);

grouped.sort(
  (a, b) =>
    a.authorSort.localeCompare(
      b.authorSort,
      "ja"
    )
);

grouped.forEach((group) => {
  group.books.sort(
    (a, b) =>
      (
        a.titleSort ||
        a.title
      ).localeCompare(
        b.titleSort ||
          b.title,
        "ja"
      )
  );
});
---

<section
  class="book-section"
  data-book-section
>
  <div
    class="book-scale-shell"
    data-book-scale-shell
  >
    <div
      class="book-stage"
      data-book-stage
    >
      <div
        class="bookshelf"
        data-bookshelf
      >
        {
          grouped.map(
            (group) => (
              <div class="author-group">
                <div class="author-column">
                  <p
                    class="author"
                    style={
                      group.authorFontSizeOverride &&
                      group.authorFontSize
                        ? `font-size:${group.authorFontSize}px;`
                        : undefined
                    }
                  >
                    {group.author}
                  </p>
                </div>

                <div class="book-list">
                  {
                    group.books.map(
                      (book) => (
                        <div class="book-column">
                          <p
                            class="book"
                            data-book-item
                            style={
                              book.titleFontSizeOverride &&
                              book.titleFontSize
                                ? `font-size:${book.titleFontSize}px;`
                                : undefined
                            }
                          >
                            {book.title}
                          </p>
                        </div>
                      )
                    )
                  }
                </div>
              </div>
            )
          )
        }
      </div>
    </div>
  </div>

  <script>
    const bookSection =
      document.querySelector<HTMLElement>(
        "[data-book-section]"
      );

    const scaleShell =
      document.querySelector<HTMLElement>(
        "[data-book-scale-shell]"
      );

    const bookStage =
      document.querySelector<HTMLElement>(
        "[data-book-stage]"
      );

    const bookshelf =
      document.querySelector<HTMLElement>(
        "[data-bookshelf]"
      );

    const books = [
      ...document.querySelectorAll<HTMLElement>(
        "[data-book-item]"
      ),
    ];

    const visualViewport =
      window.visualViewport;

    const landscapeMedia =
      window.matchMedia(
        "(orientation: landscape)"
      );

    const ZOOM_ENTER_THRESHOLD =
      1.02;

    const ZOOM_EXIT_THRESHOLD =
      1.005;

    const ZOOM_RESET_SETTLE_MS =
      240;

    const ORIENTATION_SETTLE_MS =
      260;

    type ZoomPhase =
      | "idle"
      | "zooming"
      | "resetting";

    let zoomPhase: ZoomPhase =
      "idle";

    let currentScale = 1;

    /*
     * visualViewport.scaleの変化だけでなく、
     * 実際に二本指操作が行われているかも見る。
     *
     * これにより画面回転時の一時的なscale変化を
     * ピンチ拡大と誤認しない。
     */
    let pinchGestureActive =
      false;

    let wheelFrame = 0;
    let pendingWheelDelta = 0;

    let layoutFrame = 0;
    let initialPositionFrame = 0;
    let resetFrame = 0;

    let resetTimer = 0;
    let orientationTimer = 0;

    let initialPositionComplete =
      false;

    const getDocumentScrollLeft =
      () =>
        window.scrollX ||
        document.documentElement
          .scrollLeft ||
        document.body.scrollLeft ||
        0;

    const getDocumentScrollWidth =
      () =>
        Math.max(
          document.documentElement
            .scrollWidth,
          document.body.scrollWidth
        );

    const getViewportWidth =
      () =>
        visualViewport?.width ||
        window.innerWidth;

    const getViewportHeight =
      () =>
        visualViewport?.height ||
        window.innerHeight;

    const getViewportScale =
      () =>
        visualViewport?.scale ||
        1;

    const clamp = (
      value: number,
      minimum: number,
      maximum: number
    ) =>
      Math.min(
        maximum,
        Math.max(
          minimum,
          value
        )
      );

    const setDocumentScroll = (
      left: number,
      top: number
    ) => {
      window.scrollTo({
        left,
        top,
        behavior: "auto",
      });
    };

    const setDocumentScrollLeft = (
      value: number
    ) => {
      setDocumentScroll(
        value,
        zoomPhase === "zooming"
          ? window.scrollY
          : 0
      );
    };

    const shouldFitLandscape =
      () =>
        navigator.maxTouchPoints >
          0 &&
        landscapeMedia.matches;

    const notifyZoomPhase = (
      phase: ZoomPhase
    ) => {
      window.dispatchEvent(
        new CustomEvent(
          "book-zoom-phase-change",
          {
            detail: {
              phase,
            },
          }
        )
      );
    };

    const applyZoomClasses = (
      zoomed: boolean
    ) => {
      document.documentElement
        .classList.toggle(
          "is-book-zoomed",
          zoomed
        );

      document.body.classList.toggle(
        "is-book-zoomed",
        zoomed
      );
    };

    const setZoomPhase = (
      phase: ZoomPhase
    ) => {
      zoomPhase = phase;

      applyZoomClasses(
        phase !== "idle"
      );

      notifyZoomPhase(
        phase
      );
    };

    const getUnscaledCenter =
      () => {
        const viewportWidth =
          getViewportWidth();

        return (
          (
            getDocumentScrollLeft() +
            viewportWidth / 2
          ) /
          Math.max(
            currentScale,
            0.0001
          )
        );
      };

    const restoreCenter = (
      unscaledCenter: number
    ) => {
      const viewportWidth =
        getViewportWidth();

      const maxScrollLeft =
        Math.max(
          0,
          getDocumentScrollWidth() -
            viewportWidth
        );

      const targetScroll =
        unscaledCenter *
          currentScale -
        viewportWidth / 2;

      setDocumentScrollLeft(
        clamp(
          targetScroll,
          0,
          maxScrollLeft
        )
      );
    };

    const getNaturalSize =
      () => {
        if (
          !bookStage ||
          !bookshelf
        ) {
          return null;
        }

        const width =
          Math.max(
            bookStage.scrollWidth,
            bookshelf.scrollWidth
          );

        const height =
          Math.max(
            bookStage.scrollHeight,
            bookshelf.scrollHeight
          );

        if (
          width <= 0 ||
          height <= 0
        ) {
          return null;
        }

        return {
          width,
          height,
        };
      };

    /*
     * 通常状態では、現在の実描画可能高に
     * 本棚全体が収まる倍率を毎回算出する。
     */
    const applyAdaptiveLayout = (
      preserveCenter = true
    ) => {
      layoutFrame = 0;

      if (
        zoomPhase !== "idle" ||
        !bookSection ||
        !scaleShell ||
        !bookStage ||
        !bookshelf
      ) {
        return;
      }

      const naturalSize =
        getNaturalSize();

      if (!naturalSize) {
        return;
      }

      const unscaledCenter =
        preserveCenter
          ? getUnscaledCenter()
          : 0;

      const availableHeight =
        Math.max(
          1,
          getViewportHeight()
        );

      const nextScale =
        shouldFitLandscape()
          ? Math.min(
              1,
              availableHeight /
                naturalSize.height
            )
          : 1;

      currentScale =
        nextScale;

      bookStage.style.setProperty(
        "--book-stage-scale",
        String(nextScale)
      );

      scaleShell.style.width =
        `${naturalSize.width *
          nextScale}px`;

      scaleShell.style.height =
        `${naturalSize.height *
          nextScale}px`;

      bookSection.style.width =
        `${Math.max(
          getViewportWidth(),
          naturalSize.width *
            nextScale
        )}px`;

      bookSection.style.height =
        `${Math.max(
          getViewportHeight(),
          naturalSize.height *
            nextScale
        )}px`;

      if (
        preserveCenter &&
        initialPositionComplete
      ) {
        requestAnimationFrame(
          () => {
            if (
              zoomPhase === "idle"
            ) {
              restoreCenter(
                unscaledCenter
              );
            }
          }
        );
      }
    };

    const scheduleAdaptiveLayout =
      () => {
        if (
          zoomPhase !== "idle"
        ) {
          return;
        }

        if (layoutFrame) {
          cancelAnimationFrame(
            layoutFrame
          );
        }

        layoutFrame =
          requestAnimationFrame(
            () =>
              applyAdaptiveLayout(
                true
              )
          );
      };

    const cancelReset = () => {
      window.clearTimeout(
        resetTimer
      );

      resetTimer = 0;

      if (resetFrame) {
        cancelAnimationFrame(
          resetFrame
        );

        resetFrame = 0;
      }
    };

    const beginZoom = () => {
      cancelReset();

      if (
        zoomPhase === "zooming"
      ) {
        return;
      }

      setZoomPhase(
        "zooming"
      );
    };

    /*
     * 元倍率へ戻ったあとは、
     * 複数の補正を同時並行で走らせず
     * 数フレームに分けて一度だけ確定する。
     */
    const performAtomicZoomReset =
      () => {
        resetTimer = 0;

        if (
          zoomPhase !== "zooming"
        ) {
          return;
        }

        if (
          getViewportScale() >
          ZOOM_EXIT_THRESHOLD
        ) {
          return;
        }

        const centerBeforeReset =
          getUnscaledCenter();

        setZoomPhase(
          "resetting"
        );

        if (layoutFrame) {
          cancelAnimationFrame(
            layoutFrame
          );

          layoutFrame = 0;
        }

        resetFrame =
          requestAnimationFrame(
            () => {
              const currentLeft =
                getDocumentScrollLeft();

              setDocumentScroll(
                currentLeft,
                0
              );

              resetFrame =
                requestAnimationFrame(
                  () => {
                    zoomPhase =
                      "idle";

                    applyZoomClasses(
                      false
                    );

                    applyAdaptiveLayout(
                      false
                    );

                    resetFrame =
                      requestAnimationFrame(
                        () => {
                          restoreCenter(
                            centerBeforeReset
                          );

                          resetFrame =
                            requestAnimationFrame(
                              () => {
                                resetFrame = 0;

                                notifyZoomPhase(
                                  "idle"
                                );
                              }
                            );
                        }
                      );
                  }
                );
            }
          );
      };

    const scheduleAtomicZoomReset =
      () => {
        window.clearTimeout(
          resetTimer
        );

        resetTimer =
          window.setTimeout(
            performAtomicZoomReset,
            ZOOM_RESET_SETTLE_MS
          );
      };

    /*
     * 二本指操作が行われている場合だけ、
     * scale上昇をピンチズーム開始として扱う。
     */
    const syncZoomState =
      () => {
        const viewportScale =
          getViewportScale();

        if (
          viewportScale >
            ZOOM_ENTER_THRESHOLD &&
          (
            pinchGestureActive ||
            zoomPhase === "zooming"
          )
        ) {
          beginZoom();
          return;
        }

        if (
          zoomPhase === "zooming" &&
          viewportScale <=
            ZOOM_EXIT_THRESHOLD
        ) {
          if (
            !pinchGestureActive
          ) {
            scheduleAtomicZoomReset();
          }

          return;
        }

        if (
          zoomPhase === "zooming"
        ) {
          window.clearTimeout(
            resetTimer
          );

          resetTimer = 0;
          return;
        }

        if (
          zoomPhase === "idle"
        ) {
          scheduleAdaptiveLayout();
        }
      };

    const handleTouchStart = (
      event: TouchEvent
    ) => {
      if (
        event.touches.length >= 2
      ) {
        pinchGestureActive =
          true;

        if (
          getViewportScale() >
          ZOOM_ENTER_THRESHOLD
        ) {
          beginZoom();
        }
      }
    };

    const handleTouchMove = (
      event: TouchEvent
    ) => {
      if (
        event.touches.length >= 2
      ) {
        pinchGestureActive =
          true;

        syncZoomState();
      }
    };

    const handleTouchEnd = (
      event: TouchEvent
    ) => {
      if (
        event.touches.length < 2
      ) {
        pinchGestureActive =
          false;

        syncZoomState();
      }
    };

    /*
     * 端末回転はピンチズームとは別処理にする。
     *
     * 一度通常状態へ戻し、
     * Safariの新しい描画可能高が確定してから
     * 横画面フィットを再計算する。
     */
    const handleOrientationChange =
      () => {
        pinchGestureActive =
          false;

        cancelReset();

        window.clearTimeout(
          orientationTimer
        );

        zoomPhase =
          "idle";

        applyZoomClasses(
          false
        );

        notifyZoomPhase(
          "idle"
        );

        const currentLeft =
          getDocumentScrollLeft();

        setDocumentScroll(
          currentLeft,
          0
        );

        /*
         * まず次フレームで暫定反映する。
         */
        requestAnimationFrame(
          () => {
            scheduleAdaptiveLayout();
          }
        );

        /*
         * iPad／iPhoneで回転後の
         * visualViewport確定を待ち、
         * 最終値でもう一度合わせる。
         */
        orientationTimer =
          window.setTimeout(
            () => {
              orientationTimer = 0;

              applyAdaptiveLayout(
                true
              );
            },
            ORIENTATION_SETTLE_MS
          );
      };

    const centerRandomBook =
      () => {
        initialPositionFrame = 0;

        if (
          books.length === 0
        ) {
          initialPositionComplete =
            true;

          return;
        }

        const randomBook =
          books[
            Math.floor(
              Math.random() *
                books.length
            )
          ];

        const bookBox =
          randomBook.getBoundingClientRect();

        const bookCenter =
          bookBox.left +
          getDocumentScrollLeft() +
          bookBox.width / 2;

        const viewportWidth =
          getViewportWidth();

        const targetScroll =
          bookCenter -
          viewportWidth / 2;

        const maxScrollLeft =
          Math.max(
            0,
            getDocumentScrollWidth() -
              viewportWidth
          );

        setDocumentScrollLeft(
          clamp(
            targetScroll,
            0,
            maxScrollLeft
          )
        );

        initialPositionComplete =
          true;
      };

    const scheduleInitialPosition =
      () => {
        if (
          initialPositionFrame
        ) {
          cancelAnimationFrame(
            initialPositionFrame
          );
        }

        zoomPhase =
          "idle";

        applyZoomClasses(
          false
        );

        notifyZoomPhase(
          "idle"
        );

        scheduleAdaptiveLayout();

        initialPositionFrame =
          requestAnimationFrame(
            () => {
              initialPositionFrame =
                requestAnimationFrame(
                  () => {
                    initialPositionFrame =
                      requestAnimationFrame(
                        centerRandomBook
                      );
                  }
                );
            }
          );
      };

    const applyWheelScroll =
      () => {
        wheelFrame = 0;

        const currentScroll =
          getDocumentScrollLeft();

        const viewportWidth =
          getViewportWidth();

        const maxScrollLeft =
          Math.max(
            0,
            getDocumentScrollWidth() -
              viewportWidth
          );

        setDocumentScrollLeft(
          clamp(
            currentScroll +
              pendingWheelDelta,
            0,
            maxScrollLeft
          )
        );

        pendingWheelDelta = 0;
      };

    const handleWheel = (
      event: WheelEvent
    ) => {
      if (event.ctrlKey) {
        return;
      }

      const horizontalDelta =
        Math.abs(
          event.deltaX
        ) >
        Math.abs(
          event.deltaY
        )
          ? event.deltaX
          : event.deltaY;

      if (
        Math.abs(
          horizontalDelta
        ) < 0.5
      ) {
        return;
      }

      event.preventDefault();

      pendingWheelDelta +=
        horizontalDelta;

      if (!wheelFrame) {
        wheelFrame =
          requestAnimationFrame(
            applyWheelScroll
          );
      }
    };

    const resizeObserver =
      typeof ResizeObserver !==
      "undefined"
        ? new ResizeObserver(
            () => {
              if (
                zoomPhase === "idle"
              ) {
                scheduleAdaptiveLayout();
              }
            }
          )
        : null;

    resizeObserver?.observe(
      bookshelf
    );

    const handleWindowResize =
      () => {
        syncZoomState();
      };

    const handleVisualViewportChange =
      () => {
        syncZoomState();
      };

    const cleanup = () => {
      if (wheelFrame) {
        cancelAnimationFrame(
          wheelFrame
        );
      }

      if (layoutFrame) {
        cancelAnimationFrame(
          layoutFrame
        );
      }

      if (
        initialPositionFrame
      ) {
        cancelAnimationFrame(
          initialPositionFrame
        );
      }

      if (resetFrame) {
        cancelAnimationFrame(
          resetFrame
        );
      }

      window.clearTimeout(
        resetTimer
      );

      window.clearTimeout(
        orientationTimer
      );

      wheelFrame = 0;
      layoutFrame = 0;
      initialPositionFrame = 0;
      resetFrame = 0;
      resetTimer = 0;
      orientationTimer = 0;

      pendingWheelDelta = 0;
      pinchGestureActive = false;

      resizeObserver?.disconnect();

      zoomPhase =
        "idle";

      applyZoomClasses(
        false
      );

      notifyZoomPhase(
        "idle"
      );

      window.removeEventListener(
        "wheel",
        handleWheel
      );

      window.removeEventListener(
        "resize",
        handleWindowResize
      );

      window.removeEventListener(
        "orientationchange",
        handleOrientationChange
      );

      document.removeEventListener(
        "touchstart",
        handleTouchStart
      );

      document.removeEventListener(
        "touchmove",
        handleTouchMove
      );

      document.removeEventListener(
        "touchend",
        handleTouchEnd
      );

      document.removeEventListener(
        "touchcancel",
        handleTouchEnd
      );

      visualViewport?.removeEventListener(
        "resize",
        handleVisualViewportChange
      );

      visualViewport?.removeEventListener(
        "scroll",
        handleVisualViewportChange
      );

      document.removeEventListener(
        "astro:before-swap",
        cleanup
      );
    };

    scheduleInitialPosition();

    window.addEventListener(
      "wheel",
      handleWheel,
      {
        passive: false,
      }
    );

    window.addEventListener(
      "resize",
      handleWindowResize
    );

    window.addEventListener(
      "orientationchange",
      handleOrientationChange
    );

    document.addEventListener(
      "touchstart",
      handleTouchStart,
      {
        passive: true,
      }
    );

    document.addEventListener(
      "touchmove",
      handleTouchMove,
      {
        passive: true,
      }
    );

    document.addEventListener(
      "touchend",
      handleTouchEnd,
      {
        passive: true,
      }
    );

    document.addEventListener(
      "touchcancel",
      handleTouchEnd,
      {
        passive: true,
      }
    );

    visualViewport?.addEventListener(
      "resize",
      handleVisualViewportChange
    );

    visualViewport?.addEventListener(
      "scroll",
      handleVisualViewportChange
    );

    document.addEventListener(
      "astro:before-swap",
      cleanup
    );
  </script>
</section>

<style>
  .book-section {
    --author-height:
      115px;

    --author-gap:
      10px;

    --book-column-width:
      calc(
        var(
            --book-list-size,
            13px
          ) *
          1.8
      );

    width: max-content;
    min-width: 100vw;

    height: 100dvh;
    min-height: 100dvh;

    background: #fff;

    color:
      var(
        --book-list-color,
        #111
      );

    font-family:
      var(
        --site-font-family
      );
  }

  .book-scale-shell {
    position: relative;

    width: max-content;
    height: auto;

    min-width: 100vw;
  }

  .book-stage {
    --book-stage-scale: 1;

    width: max-content;
    height: max-content;

    transform:
      scale(
        var(
          --book-stage-scale
        )
      );

    transform-origin:
      top left;

    will-change:
      transform;
  }

  .bookshelf {
    display: flex;
    flex-direction:
      row-reverse;
    align-items:
      flex-start;

    gap: 72px;

    width: max-content;
    min-width: 100vw;

    padding:
      155px
      50vw;
  }

  .author-group {
    display: flex;
    flex-direction:
      column;
    align-items:
      flex-end;

    flex:
      0
      0
      auto;
  }

  .author-column,
  .book-column {
    display: flex;
    align-items:
      flex-start;
    justify-content:
      center;

    width:
      var(
        --book-column-width
      );

    flex:
      0
      0
      auto;
  }

  .author,
  .book {
    margin: 0;

    writing-mode:
      vertical-rl;

    text-orientation:
      mixed;

    font-family:
      var(
        --site-font-family
      );

    font-size:
      var(
        --book-list-size,
        13px
      );

    color:
      var(
        --book-list-color,
        #111
      );

    line-height: 1.8;
    letter-spacing:
      0.08em;
  }

  .author-column {
    height:
      var(
        --author-height
      );

    margin:
      0
      0
      var(
        --author-gap
      )
      0;
  }

  .author {
    white-space:
      nowrap;
  }

  .book-list {
    display: flex;
    flex-direction:
      row-reverse;
    align-items:
      flex-start;

    gap: 45px;
  }

  .book {
    white-space:
      nowrap;
  }
</style>