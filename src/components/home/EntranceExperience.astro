---
import { CONTENTS } from "../../data/contents";

const lobbyContent = CONTENTS.find(
  (content) => content.id === "__lobby__"
);

const lobbyImage =
  lobbyContent?.image || "";

const desktopHeightPx =
  lobbyContent?.desktopHeightPx ?? 620;

const desktopHeightVh =
  lobbyContent?.desktopHeightVh ?? 60;

const entranceStyle = [
  `--desktop-height-px: ${desktopHeightPx}px`,
  `--desktop-height-vh: ${desktopHeightVh}vh`,
].join(";");
---

<div
  class="entrance-experience"
  data-entrance-experience
  style={entranceStyle}
>
  <div
    class="entrance-experience__lobby"
    data-lobby
    aria-hidden="true"
  >
    {
      lobbyImage && (
        <img
          class="entrance-experience__lobby-image"
          src={lobbyImage}
          alt=""
          loading="eager"
          decoding="async"
        />
      )
    }
  </div>

  <div
    class="entrance-experience__veil"
    data-entrance-veil
    aria-hidden="true"
  ></div>

  <!--
    中央配置と拡大縮小を別要素へ分離。

    将来、内部を外部SVGファイルのimgへ
    変更してもアニメーション処理は共通。
  -->
  <div
    class="entrance-experience__logo-position"
    aria-hidden="true"
  >
    <div
      class="entrance-experience__logo-visual"
      data-logo-visual
    >
      <svg
        class="entrance-experience__logo"
        viewBox="0 0 1000 120"
        role="img"
        aria-label="Musée de l'Instant"
      >
        <text
          class="entrance-experience__logo-text"
          x="500"
          y="66"
          text-anchor="middle"
          dominant-baseline="middle"
        >
          Musée de l'Instant
        </text>
      </svg>
    </div>
  </div>
</div>

<script>
  const root =
    document.querySelector<HTMLElement>(
      "[data-entrance-experience]"
    );

  if (
    root &&
    root.dataset.initialized !== "true"
  ) {
    root.dataset.initialized = "true";

    const lobby =
      root.querySelector<HTMLElement>(
        "[data-lobby]"
      );

    const veil =
      root.querySelector<HTMLElement>(
        "[data-entrance-veil]"
      );

    const logoVisual =
      root.querySelector<HTMLElement>(
        "[data-logo-visual]"
      );

    /*
     * progress:
     *
     * 0 = 入口
     * 1 = ロビー最奥
     */
    const FORWARD_THRESHOLD = 0.20;

    /*
     * 入館側は完成済みなので、
     * 操作感度と自動遷移時間を維持する。
     */
    const FORWARD_TOUCH_DISTANCE = 345;
    const FORWARD_WHEEL_DISTANCE = 300;
    const FORWARD_SNAP_DURATION = 620;

    /*
     * 退館ロゴはJavaScriptで毎フレーム
     * transformを書き換えず、
     * ブラウザのCSS Transitionへ任せる。
     */
    const EXIT_LOGO_DURATION = 500;

    const EXIT_LOGO_EASING =
      "cubic-bezier(0.45, 0, 0.55, 1)";

    /*
     * 入館画像演出。
     */
    const LOBBY_ENTER_DURATION = 700;
    const LOBBY_ENTER_SCALE = 0.85;

    /*
     * 退館画像演出。
     */
    const LOBBY_EXIT_DURATION = 400;
    const LOBBY_EXIT_SCALE = 0.75;

    let progress = 0;
    let wheelTarget = 0;

    let touchStartY = 0;
    let touchStartProgress = 0;
    let touchLastY = 0;
    let touchDirection = 0;

    let renderFrame = 0;
    let snapFrame = 0;
    let exitStartFrame = 0;
    let wheelEndTimer = 0;
    let exitCompleteTimer = 0;

    let isTouching = false;
    let isSnapping = false;
    let isExiting = false;
    let isLobbyVisible = false;

    let snapTarget: 0 | 1 | null = null;

    const clamp = (
      value: number,
      min = 0,
      max = 1
    ) =>
      Math.min(
        max,
        Math.max(min, value)
      );

    const easeOutQuint = (
      value: number
    ) =>
      1 - Math.pow(1 - value, 5);

    const dispatchState = (
      complete: boolean
    ) => {
      window.dispatchEvent(
        new CustomEvent(
          "entrance-state-change",
          {
            detail: {
              complete,
              progress,
            },
          }
        )
      );
    };

    const forceLobbyReflow = () => {
      lobby?.getBoundingClientRect();
    };

    const forceExitReflow = () => {
      logoVisual?.getBoundingClientRect();
      veil?.getBoundingClientRect();
    };

    const getLogoValues = (
      currentProgress: number
    ) => {
      /*
       * 入館時のロゴ計算は従来のまま。
       */
      const forwardCurve =
        currentProgress *
        currentProgress;

      const scale =
        1 + forwardCurve * 13;

      const opacity = clamp(
        1 -
          (currentProgress - 0.48) /
            0.3
      );

      return {
        scale,
        opacity,
      };
    };

    const getVeilOpacity = (
      currentProgress: number
    ) =>
      currentProgress < 0.58
        ? clamp(
            currentProgress /
              0.58
          )
        : clamp(
            1 -
              (currentProgress - 0.58) /
                0.42
          );

    const applyLogoVisual = (
      scale: number,
      opacity: number
    ) => {
      if (!logoVisual) {
        return;
      }

      logoVisual.style.transform =
        `scale(${scale})`;

      logoVisual.style.opacity =
        String(opacity);
    };

    const applyVeilOpacity = (
      opacity: number
    ) => {
      if (!veil) {
        return;
      }

      veil.style.opacity =
        String(opacity * 0.1);
    };

    const clearExitTransitions = () => {
      if (logoVisual) {
        logoVisual.style.transition =
          "none";
      }

      if (veil) {
        veil.style.transition =
          "none";
      }
    };

    const showLobbyAndHeader = () => {
      if (isLobbyVisible) {
        document.body.classList.add(
          "entrance-is-complete"
        );

        dispatchState(true);
        return;
      }

      isLobbyVisible = true;

      if (!lobby) {
        document.body.classList.add(
          "entrance-is-complete"
        );

        dispatchState(true);
        return;
      }

      lobby.style.transition = "none";
      lobby.style.opacity = "0";
      lobby.style.transform =
        `scale(${LOBBY_ENTER_SCALE})`;

      forceLobbyReflow();

      lobby.style.transition = [
        `opacity ${LOBBY_ENTER_DURATION}ms cubic-bezier(0.22, 1, 0.36, 1)`,
        `transform ${LOBBY_ENTER_DURATION}ms cubic-bezier(0.22, 1, 0.36, 1)`,
      ].join(", ");

      lobby.style.opacity = "1";
      lobby.style.transform =
        "scale(1)";

      document.body.classList.add(
        "entrance-is-complete"
      );

      dispatchState(true);
    };

    const hideLobbyAndHeader = () => {
      document.body.classList.remove(
        "entrance-is-complete"
      );

      if (!isLobbyVisible) {
        dispatchState(false);
        return;
      }

      isLobbyVisible = false;

      if (lobby) {
        lobby.style.transition = [
          `opacity ${LOBBY_EXIT_DURATION}ms linear`,
          `transform ${LOBBY_EXIT_DURATION}ms linear`,
        ].join(", ");

        lobby.style.opacity = "0";
        lobby.style.transform =
          `scale(${LOBBY_EXIT_SCALE})`;
      }

      dispatchState(false);
    };

    const render = () => {
      /*
       * 退館中のロゴとveilはCSS Transitionが
       * 管理しているため、ここから上書きしない。
       */
      if (isExiting) {
        dispatchState(false);
        return;
      }

      const logoValues =
        getLogoValues(progress);

      const veilOpacity =
        getVeilOpacity(progress);

      clearExitTransitions();

      applyLogoVisual(
        logoValues.scale,
        logoValues.opacity
      );

      applyVeilOpacity(
        veilOpacity
      );

      dispatchState(
        progress >= 1
      );
    };

    const cancelRenderFrame = () => {
      if (renderFrame) {
        cancelAnimationFrame(
          renderFrame
        );
      }

      renderFrame = 0;
    };

    const cancelSnap = () => {
      if (snapFrame) {
        cancelAnimationFrame(
          snapFrame
        );
      }

      snapFrame = 0;
      isSnapping = false;
      snapTarget = null;
    };

    const cancelExit = () => {
      if (exitStartFrame) {
        cancelAnimationFrame(
          exitStartFrame
        );
      }

      window.clearTimeout(
        exitCompleteTimer
      );

      exitStartFrame = 0;
      exitCompleteTimer = 0;
      isExiting = false;

      clearExitTransitions();
    };

    const completeEntranceSnap = () => {
      progress = 1;
      wheelTarget = 1;

      isSnapping = false;
      snapTarget = null;
      snapFrame = 0;

      render();
      showLobbyAndHeader();
    };

    /*
     * 入館用の自動遷移。

     * 入館側は従来どおり、
     * requestAnimationFrameでprogressを補間する。
     */
    const snapToEntrance = () => {
      if (
        progress >= 1 &&
        isLobbyVisible
      ) {
        wheelTarget = 1;
        return;
      }

      if (
        isSnapping &&
        snapTarget === 1
      ) {
        return;
      }

      if (isExiting) {
        return;
      }

      cancelRenderFrame();
      cancelSnap();

      isSnapping = true;
      snapTarget = 1;

      const startProgress =
        progress;

      const distance =
        1 - startProgress;

      const duration = Math.max(
        260,
        FORWARD_SNAP_DURATION *
          Math.abs(distance)
      );

      const startTime =
        performance.now();

      const animate = (
        currentTime: number
      ) => {
        const elapsed =
          currentTime - startTime;

        const timeProgress =
          clamp(
            elapsed / duration
          );

        const eased =
          easeOutQuint(
            timeProgress
          );

        progress = clamp(
          startProgress +
            distance * eased
        );

        wheelTarget = progress;

        render();

        if (timeProgress < 1) {
          snapFrame =
            requestAnimationFrame(
              animate
            );

          return;
        }

        completeEntranceSnap();
      };

      snapFrame =
        requestAnimationFrame(
          animate
        );
    };

    /*
     * 退館ロゴは、現在の表示状態を固定したあと、
     * transformとopacityの終点を一度だけ設定する。
     *
     * 500ms中にJavaScriptからtransformを
     * 毎フレーム更新しないため、SVG内のtextでも
     * 外部SVG画像でもブラウザ側で滑らかに合成される。
     */
    const startExitTransition = () => {
      if (
        isExiting ||
        progress <= 0
      ) {
        return;
      }

      isTouching = false;

      window.clearTimeout(
        wheelEndTimer
      );

      cancelRenderFrame();
      cancelSnap();
      cancelExit();

      const currentLogo =
        getLogoValues(progress);

      const currentVeilOpacity =
        getVeilOpacity(progress);

      /*
       * まず現在地をtransitionなしで固定。
       */
      clearExitTransitions();

      applyLogoVisual(
        currentLogo.scale,
        currentLogo.opacity
      );

      applyVeilOpacity(
        currentVeilOpacity
      );

      forceExitReflow();

      isExiting = true;

      hideLobbyAndHeader();

      /*
       * 状態値はここで入口へ確定する。
       * 見た目だけが500msかけて追いつく。
       */
      progress = 0;
      wheelTarget = 0;

      dispatchState(false);

      exitStartFrame =
        requestAnimationFrame(() => {
          exitStartFrame = 0;

          if (!isExiting) {
            return;
          }

          if (logoVisual) {
            logoVisual.style.transition = [
              `transform ${EXIT_LOGO_DURATION}ms ${EXIT_LOGO_EASING}`,
              `opacity ${EXIT_LOGO_DURATION}ms ${EXIT_LOGO_EASING}`,
            ].join(", ");

            logoVisual.style.transform =
              "scale(1)";

            logoVisual.style.opacity =
              "1";
          }

          if (veil) {
            veil.style.transition =
              `opacity ${EXIT_LOGO_DURATION}ms ${EXIT_LOGO_EASING}`;

            veil.style.opacity = "0";
          }
        });

      exitCompleteTimer =
        window.setTimeout(() => {
          exitCompleteTimer = 0;
          isExiting = false;

          clearExitTransitions();

          applyLogoVisual(1, 1);
          applyVeilOpacity(0);

          render();
        }, EXIT_LOGO_DURATION + 34);
    };

    const evaluateForwardThreshold = (
      direction: number
    ) => {
      if (
        direction <= 0
      ) {
        return false;
      }

      if (progress >= 1) {
        wheelTarget = 1;
        return false;
      }

      if (
        progress >=
          FORWARD_THRESHOLD
      ) {
        snapToEntrance();
        return true;
      }

      return false;
    };

    const startWheelInterpolation = () => {
      cancelRenderFrame();

      const animate = () => {
        if (
          isSnapping ||
          isExiting
        ) {
          renderFrame = 0;
          return;
        }

        const difference =
          wheelTarget - progress;

        progress +=
          difference * 0.18;

        if (
          Math.abs(difference) <
          0.001
        ) {
          progress =
            wheelTarget;
        }

        progress =
          clamp(progress);

        render();

        if (
          evaluateForwardThreshold(1)
        ) {
          renderFrame = 0;
          return;
        }

        if (
          Math.abs(
            wheelTarget -
              progress
          ) > 0.001
        ) {
          renderFrame =
            requestAnimationFrame(
              animate
            );

          return;
        }

        renderFrame = 0;
      };

      renderFrame =
        requestAnimationFrame(
          animate
        );
    };

    const handleWheel = (
      event: WheelEvent
    ) => {
      event.preventDefault();

      if (
        Math.abs(
          event.deltaY
        ) < 0.5
      ) {
        return;
      }

      const direction =
        Math.sign(
          event.deltaY
        );

      /*
       * 退館方向入力を一度検知したら、
       * 500msの確定退館へ移行する。
       */
      if (direction < 0) {
        startExitTransition();
        return;
      }

      if (isExiting) {
        return;
      }

      if (
        progress >= 1 &&
        isLobbyVisible
      ) {
        wheelTarget = 1;
        return;
      }

      if (isSnapping) {
        return;
      }

      const normalizedDelta =
        Math.min(
          Math.max(
            Math.abs(
              event.deltaY
            ),
            22
          ),
          120
        );

      wheelTarget = clamp(
        wheelTarget +
          normalizedDelta /
            FORWARD_WHEEL_DISTANCE
      );

      startWheelInterpolation();

      window.clearTimeout(
        wheelEndTimer
      );

      wheelEndTimer =
        window.setTimeout(() => {
          evaluateForwardThreshold(1);
        }, 70);
    };
        const handleTouchStart = (
      event: TouchEvent
    ) => {
      if (
        event.touches.length !== 1 ||
        isExiting
      ) {
        return;
      }

      const touchY =
        event.touches[0].clientY;

      isTouching = true;
      touchStartY = touchY;
      touchLastY = touchY;
      touchStartProgress = progress;
      touchDirection = 0;

      cancelRenderFrame();

      /*
       * 入館中の自動遷移だけは、
       * 新しいタッチ操作で中断できる。
       *
       * 退館開始後はisExitingによって
       * 中断されない。
       */
      if (
        isSnapping &&
        snapTarget === 1
      ) {
        cancelSnap();
      }
    };

    const handleTouchMove = (
      event: TouchEvent
    ) => {
      if (
        !isTouching ||
        isExiting ||
        event.touches.length !== 1
      ) {
        return;
      }

      event.preventDefault();

      const touchY =
        event.touches[0].clientY;

      const totalDistance =
        touchStartY - touchY;

      const frameDistance =
        touchLastY - touchY;

      touchLastY = touchY;

      if (
        Math.abs(frameDistance) >
        0.5
      ) {
        touchDirection =
          Math.sign(
            frameDistance
          );
      }

      /*
       * 退館方向の動きを一度検知した時点で、
       * 指との追従を終了し、
       * CSS Transitionへ移行する。
       */
      if (touchDirection < 0) {
        startExitTransition();
        return;
      }

      /*
       * 入館方向のみ、
       * 従来どおり指の移動量へ追従する。
       */
      progress = clamp(
        touchStartProgress +
          totalDistance /
            FORWARD_TOUCH_DISTANCE
      );

      wheelTarget = progress;

      render();

      if (
        evaluateForwardThreshold(
          touchDirection
        )
      ) {
        isTouching = false;
      }
    };

    const handleTouchEnd = () => {
      if (
        !isTouching ||
        isExiting
      ) {
        return;
      }

      isTouching = false;

      /*
       * 入館方向のみ、
       * 指を離した時点で閾値を判定する。
       */
      evaluateForwardThreshold(
        touchDirection
      );
    };

    const handleKeyDown = (
      event: KeyboardEvent
    ) => {
      const forwardKeys = [
        "ArrowDown",
        "PageDown",
        " ",
        "Enter",
      ];

      const backwardKeys = [
        "ArrowUp",
        "PageUp",
        "Escape",
      ];

      const isForward =
        forwardKeys.includes(
          event.key
        );

      const isBackward =
        backwardKeys.includes(
          event.key
        );

      if (
        !isForward &&
        !isBackward
      ) {
        return;
      }

      event.preventDefault();

      /*
       * 退館開始後は、
       * 完了するまで全入力を無視する。
       */
      if (isExiting) {
        return;
      }

      if (
        isForward &&
        progress >= 1 &&
        isLobbyVisible
      ) {
        return;
      }

      if (
        isBackward &&
        progress <= 0 &&
        !isLobbyVisible
      ) {
        return;
      }

      if (isForward) {
        snapToEntrance();
      } else {
        startExitTransition();
      }
    };

    const cleanup = () => {
      cancelRenderFrame();
      cancelSnap();
      cancelExit();

      window.clearTimeout(
        wheelEndTimer
      );

      window.removeEventListener(
        "wheel",
        handleWheel
      );

      window.removeEventListener(
        "touchstart",
        handleTouchStart
      );

      window.removeEventListener(
        "touchmove",
        handleTouchMove
      );

      window.removeEventListener(
        "touchend",
        handleTouchEnd
      );

      window.removeEventListener(
        "touchcancel",
        handleTouchEnd
      );

      window.removeEventListener(
        "keydown",
        handleKeyDown
      );

      document.removeEventListener(
        "astro:before-swap",
        cleanup
      );
    };

    /*
     * 初期状態。
     */
    if (lobby) {
      lobby.style.transition = "none";
      lobby.style.opacity = "0";
      lobby.style.transform =
        `scale(${LOBBY_EXIT_SCALE})`;
    }

    clearExitTransitions();

    applyLogoVisual(1, 1);
    applyVeilOpacity(0);

    render();

    document.body.classList.remove(
      "entrance-is-complete"
    );

    dispatchState(false);

    window.addEventListener(
      "wheel",
      handleWheel,
      {
        passive: false,
      }
    );

    window.addEventListener(
      "touchstart",
      handleTouchStart,
      {
        passive: true,
      }
    );

    window.addEventListener(
      "touchmove",
      handleTouchMove,
      {
        passive: false,
      }
    );

    window.addEventListener(
      "touchend",
      handleTouchEnd,
      {
        passive: true,
      }
    );

    window.addEventListener(
      "touchcancel",
      handleTouchEnd,
      {
        passive: true,
      }
    );

    window.addEventListener(
      "keydown",
      handleKeyDown
    );

    document.addEventListener(
      "astro:before-swap",
      cleanup
    );
  }
</script>

<style>
  .entrance-experience {
    --desktop-height-px: 620px;
    --desktop-height-vh: 60vh;

    position: fixed;
    inset: 0;
    z-index: 1;

    width: 100%;
    height: 100svh;

    overflow: hidden;
    overscroll-behavior: none;
    touch-action: none;

    background: #fff;
  }

  .entrance-experience__lobby {
    position: absolute;
    inset: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    opacity: 0;
    transform: scale(0.75);
    transform-origin: center;

    background: #fff;

    will-change:
      opacity,
      transform;

    pointer-events: none;
  }

  .entrance-experience__lobby-image {
    display: block;

    width: auto;
    max-width: 100%;

    height: min(
      var(--desktop-height-vh),
      var(--desktop-height-px)
    );

    max-height: 100svh;

    object-fit: contain;

    pointer-events: none;
    user-select: none;
  }

  .entrance-experience__veil {
    position: absolute;
    inset: 0;

    opacity: 0;

    background: #fff;

    will-change: opacity;

    pointer-events: none;
  }

  /*
   * 中央配置専用。
   *
   * この要素はアニメーションさせない。
   */
  .entrance-experience__logo-position {
    position: absolute;
    top: 50%;
    left: 50%;

    width: min(
      680px,
      calc(100vw - 48px)
    );

    transform:
      translate(-50%, -50%);

    pointer-events: none;
  }

  /*
   * 拡大縮小と透明度専用。
   *
   * 中身がインラインSVGでも、
   * 外部SVG画像でも同じように動く。
   */
  .entrance-experience__logo-visual {
    width: 100%;

    opacity: 1;
    transform: scale(1);
    transform-origin: center;

    will-change:
      transform,
      opacity;

    backface-visibility: hidden;

    pointer-events: none;
  }

  .entrance-experience__logo {
    display: block;

    width: 100%;
    height: auto;
    overflow: visible;

    pointer-events: none;
    user-select: none;
  }

  .entrance-experience__logo-text {
    fill:
      var(
        --navigation-color
      );

    font-family:
      var(
        --site-font-family
      );

    font-size: 34px;
    font-weight: 400;
    letter-spacing: 0.08em;
  }

  /*
   * 将来、外部SVGファイルへ変更した場合も
   * 以下のクラスを付ければ、
   * 現在と同じアニメーションを使用できる。
   *
   * 例：
   *
   * <img
   *   class="entrance-experience__logo-image"
   *   src="/logo.svg"
   *   alt="Musée de l'Instant"
   * />
   */
  .entrance-experience__logo-image {
    display: block;

    width: 100%;
    height: auto;

    pointer-events: none;
    user-select: none;
  }

  @media (max-width: 1024px) {
    .entrance-experience__lobby-image {
      width: 100%;
      max-width: none;

      height: auto;
      max-height: 100svh;

      object-fit: contain;
    }
