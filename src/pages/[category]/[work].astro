---
import Layout from "../../layouts/Layout.astro";
import { CATEGORIES } from "../../config/site";
import { CONTENTS } from "../../data/contents";

export function getStaticPaths() {
  return CONTENTS
    .filter((item) => item.visible)
    .map((item) => {
      const category =
        CATEGORIES.find(
          (category) =>
            category.id ===
            item.categoryId
        );

      return {
        item,
        category,
      };
    })
    .filter(({ category }) => {
      if (!category) {
        return false;
      }

      return (
        category.type ||
        "gallery"
      ) === "gallery";
    })
    .map(
      ({
        item,
        category,
      }) => ({
        params: {
          category:
            category.slug,
          work: item.id,
        },
        props: {
          item,
        },
      })
    );
}

const {
  item,
} = Astro.props;
---

<Layout
  title={`${item.title} | Musée de l'Instant`}
  showHeader={true}
>
  <main class="work-page">
    <!--
      画像とキャプションを、
      一つの展示ユニットとして扱う。

      スマホではユニット全体を中央へ置き、
      キャプションを画像の直下・右端へ揃える。
    -->
    <div
      class="work-display"
      data-work-display
    >
      {
        item.image && (
          <div class="work-image-area">
            <img
              src={item.image}
              alt={item.title}
              data-work-image
            />
          </div>
        )
      }

      {
        (
          item.title ||
          item.body
        ) && (
          <div
            class="work-caption"
            data-work-caption
          >
            {
              item.title && (
                <p class="work-title">
                  {item.title}
                </p>
              )
            }

            {
              item.body && (
                <p class="work-body">
                  {item.body}
                </p>
              )
            }
          </div>
        )
      }
    </div>
  </main>

  <script>
    const DETAIL_PAGE_CLASS =
      "is-gallery-detail-page";

    const workDisplay =
      document.querySelector<HTMLElement>(
        "[data-work-display]"
      );

    const workImage =
      document.querySelector<HTMLImageElement>(
        "[data-work-image]"
      );

    const workCaption =
      document.querySelector<HTMLElement>(
        "[data-work-caption]"
      );

    let resizeFrame = 0;

    const applyDetailPageState =
      () => {
        document.documentElement
          .classList.add(
            DETAIL_PAGE_CLASS
          );

        document.body.classList.add(
          DETAIL_PAGE_CLASS
        );
      };

    const removeDetailPageState =
      () => {
        document.documentElement
          .classList.remove(
            DETAIL_PAGE_CLASS
          );

        document.body.classList.remove(
          DETAIL_PAGE_CLASS
        );
      };

    /*
     * スマホでは、キャプション幅を
     * 実際に描画された画像幅へ合わせる。
     *
     * これによりキャプションの右端が、
     * 画面右端ではなく画像右端へ揃う。
     */
    const syncMobileCaptionWidth =
      () => {
        if (
          !workDisplay ||
          !workImage ||
          !workCaption
        ) {
          return;
        }

        if (
          !window.matchMedia(
            "(max-width: 640px)"
          ).matches
        ) {
          workDisplay.style
            .removeProperty(
              "--rendered-image-width"
            );

          return;
        }

        const imageWidth =
          workImage.getBoundingClientRect()
            .width;

        if (imageWidth <= 0) {
          return;
        }

        workDisplay.style.setProperty(
          "--rendered-image-width",
          `${imageWidth}px`
        );
      };

    const scheduleCaptionSync =
      () => {
        if (resizeFrame) {
          cancelAnimationFrame(
            resizeFrame
          );
        }

        resizeFrame =
          requestAnimationFrame(
            () => {
              resizeFrame = 0;
              syncMobileCaptionWidth();
            }
          );
      };

    /*
     * この詳細ページにいる間だけ、
     * スマホのページスクロールと
     * pull-to-refreshを抑止する。
     */
    applyDetailPageState();

    if (workImage) {
      if (workImage.complete) {
        scheduleCaptionSync();
      } else {
        workImage.addEventListener(
          "load",
          scheduleCaptionSync,
          {
            once: true,
          }
        );
      }
    }

    window.addEventListener(
      "resize",
      scheduleCaptionSync
    );

    window.addEventListener(
      "orientationchange",
      scheduleCaptionSync
    );

    const cleanup = () => {
      if (resizeFrame) {
        cancelAnimationFrame(
          resizeFrame
        );
      }

      resizeFrame = 0;

      window.removeEventListener(
        "resize",
        scheduleCaptionSync
      );

      window.removeEventListener(
        "orientationchange",
        scheduleCaptionSync
      );

      removeDetailPageState();

      document.removeEventListener(
        "astro:before-swap",
        cleanup
      );
    };

    document.addEventListener(
      "astro:before-swap",
      cleanup
    );
  </script>
</Layout>

<style>
  /*
   * PC版は、これまでの表示を維持する。
   */
  .work-page {
    min-height: 100vh;

    padding:
      120px
      24px;

    display: grid;
    place-items: center;

    background: #fff;
  }

  .work-display {
    width: min(
      100%,
      900px
    );
  }

  .work-image-area {
    display: grid;
    place-items: center;

    width: 100%;
  }

  .work-image-area img {
    display: block;

    width: 100%;
    height: auto;
  }

  .work-caption {
    width: 100%;

    margin:
      24px
      0
      0;

    text-align: right;
  }

  .work-title,
  .work-body {
    margin: 0;

    font-family:
      var(
        --site-font-family
      );

    letter-spacing: 0.08em;
    line-height: 1.8;
    white-space: pre-line;
  }

  .work-title {
    color:
      var(
        --gallery-detail-title-color
      );

    font-size:
      var(
        --gallery-detail-title-size
      );
  }

  .work-body {
    margin-top: 4px;

    color:
      var(
        --gallery-detail-caption-color
      );

    font-size:
      var(
        --gallery-detail-caption-size
      );
  }
    /*
   * スマホ版のみ変更。
   *
   * 縦スクロール抑止と
   * pull-to-refresh対策は維持しつつ、
   * 画像とキャプションを一つの展示ユニットとして扱う。
   */
  @media (max-width: 640px) {
    :global(
      html.is-gallery-detail-page
    ),
    :global(
      body.is-gallery-detail-page
    ) {
      width: 100%;
      height: 100%;

      overflow: hidden;
      overscroll-behavior-y: none;
    }

    :global(
      body.is-gallery-detail-page
    ) {
      position: fixed;
      inset: 0;

      touch-action: auto;
    }

    .work-page {
      width: 100%;
      height: 100dvh;
      min-height: 0;

      padding:
        calc(
          88px +
          env(
            safe-area-inset-top,
            0px
          )
        )
        20px
        calc(
          24px +
          env(
            safe-area-inset-bottom,
            0px
          )
        );

      display: flex;
      align-items: center;
      justify-content: center;

      overflow: hidden;
      overscroll-behavior: none;
    }

    /*
     * 画像とキャプションを、
     * 一つの展示ユニットとして中央へ置く。
     *
     * 高さは内容に合わせ、
     * 画面全体へ引き伸ばさない。
     */
    .work-display {
      display: flex;
      flex-direction: column;
      align-items: center;

      width: 100%;
      max-width: 100%;

      max-height: 100%;
      min-height: 0;
    }

    /*
     * キャプション分の高さを残しつつ、
     * 画像が画面内へ収まるようにする。
     */
    .work-image-area {
      display: flex;
      align-items: center;
      justify-content: center;

      width: 100%;
      min-height: 0;

      flex:
        1
        1
        auto;

      overflow: hidden;
    }

    .work-image-area img {
      display: block;

      width: auto;
      max-width: 100%;

      height: auto;
      max-height: 100%;

      object-fit: contain;

      touch-action: auto;
    }

    /*
     * キャプション幅は、
     * JavaScriptで取得した実描画画像幅へ合わせる。
     *
     * これにより、
     * キャプションの右端が画像右端へ揃う。
     */
    .work-caption {
      width:
        min(
          100%,
          var(
            --rendered-image-width,
            100%
          )
        );

      flex:
        0
        0
        auto;

      margin:
        28px
        0
        0;

      text-align: right;
    }
  }
</style>