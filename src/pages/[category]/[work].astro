---
import Layout from "../../layouts/Layout.astro";
import { CATEGORIES } from "../../config/site";
import { CONTENTS } from "../../data/contents";


export function getStaticPaths() {
  return CONTENTS
    .filter((item) => item.visible)
    .map((item) => {
      const category =
        CATEGORIES.find(
          (category) =>
            category.id ===
            item.categoryId
        );


      return {
        item,
        category,
      };
    })
    .filter(({ category }) => {
      if (!category) {
        return false;
      }


      return (
        category.type ||
        "gallery"
      ) === "gallery";
    })
    .map(
      ({
        item,
        category,
      }) => ({
        params: {
          category:
            category.slug,
          work: item.id,
        },
        props: {
          item,
        },
      })
    );
}


const {
  item,
} = Astro.props;
---


<Layout
  title={`${item.title} | Musée de l'Instant`}
  showHeader={true}
>
  <main class="work-page">
    <div
      class="work-display"
      data-work-display
    >
      {
        item.image && (
          <div class="work-image-area">
            <img
              src={item.image}
              alt={item.title}
              data-work-image
            />
          </div>
        )
      }


      {
        (
          item.title ||
          item.body
        ) && (
          <div
            class="work-caption"
            data-work-caption
          >
            {
              item.title && (
                <p class="work-title">
                  {item.title}
                </p>
              )
            }


            {
              item.body && (
                <p class="work-body">
                  {item.body}
                </p>
              )
            }
          </div>
        )
      }
    </div>
  </main>


  <script>
    const DETAIL_PAGE_CLASS =
      "is-gallery-detail-page";


    const workDisplay =
      document.querySelector<HTMLElement>(
        "[data-work-display]"
      );


    const workImage =
      document.querySelector<HTMLImageElement>(
        "[data-work-image]"
      );


    const workCaption =
      document.querySelector<HTMLElement>(
        "[data-work-caption]"
      );


    let resizeFrame = 0;
    let imageRevealFrame = 0;


    const applyDetailPageState =
      () => {
        document.documentElement
          .classList.add(
            DETAIL_PAGE_CLASS
          );


        document.body.classList.add(
          DETAIL_PAGE_CLASS
        );
      };


    const removeDetailPageState =
      () => {
        document.documentElement
          .classList.remove(
            DETAIL_PAGE_CLASS
          );


        document.body.classList.remove(
          DETAIL_PAGE_CLASS
        );
      };


    /*
     * 詳細画像自身をフェードインする。
     *
     * imgそのもののopacityを変えるため、
     * アスペクト比や実描画サイズに関係なく
     * 画像の位置へ完全に一致する。
     */
    const revealWorkImage =
      () => {
        if (!workImage) {
          return;
        }


        workImage.classList.add(
          "is-work-image-loaded"
        );
      };


    const scheduleImageReveal =
      () => {
        if (imageRevealFrame) {
          cancelAnimationFrame(
            imageRevealFrame
          );
        }


        /*
         * 初期opacity:0を確実に描画してから
         * linearフェードへ入る。
         */
        imageRevealFrame =
          requestAnimationFrame(
            () => {
              imageRevealFrame =
                requestAnimationFrame(
                  () => {
                    imageRevealFrame = 0;

                    revealWorkImage();
                  }
                );
            }
          );
      };


    /*
     * スマホでは、キャプション幅を
     * 実際に描画された画像幅へ合わせる。
     */
    const syncMobileCaptionWidth =
      () => {
        if (
          !workDisplay ||
          !workImage ||
          !workCaption
        ) {
          return;
        }


        if (
          !window.matchMedia(
            "(max-width: 640px)"
          ).matches
        ) {
          workDisplay.style
            .removeProperty(
              "--rendered-image-width"
            );


          return;
        }


        const imageWidth =
          workImage
            .getBoundingClientRect()
            .width;


        if (imageWidth <= 0) {
          return;
        }


        workDisplay.style.setProperty(
          "--rendered-image-width",
          `${imageWidth}px`
        );
      };


    const scheduleCaptionSync =
      () => {
        if (resizeFrame) {
          cancelAnimationFrame(
            resizeFrame
          );
        }


        resizeFrame =
          requestAnimationFrame(
            () => {
              resizeFrame = 0;

              syncMobileCaptionWidth();
            }
          );
      };


    applyDetailPageState();


    if (workImage) {
      if (workImage.complete) {
        scheduleCaptionSync();
        scheduleImageReveal();
      } else {
        workImage.addEventListener(
          "load",
          () => {
            scheduleCaptionSync();
            scheduleImageReveal();
          },
          {
            once: true,
          }
        );
      }
    }


    window.addEventListener(
      "resize",
      scheduleCaptionSync
    );


    window.addEventListener(
      "orientationchange",
      scheduleCaptionSync
    );


    const cleanup = () => {
      if (resizeFrame) {
        cancelAnimationFrame(
          resizeFrame
        );
      }


      if (imageRevealFrame) {
        cancelAnimationFrame(
          imageRevealFrame
        );
      }


      resizeFrame = 0;
      imageRevealFrame = 0;


      window.removeEventListener(
        "resize",
        scheduleCaptionSync
      );


      window.removeEventListener(
        "orientationchange",
        scheduleCaptionSync
      );


      removeDetailPageState();


      document.removeEventListener(
        "astro:before-swap",
        cleanup
      );
    };


    document.addEventListener(
      "astro:before-swap",
      cleanup
    );
  </script>
</Layout>


<style>
  .work-page {
    min-height: 100vh;


    padding:
      120px
      24px;


    display: grid;
    place-items: center;


    background: #fff;
  }


  .work-display {
    width: min(
      100%,
      900px
    );
  }


  .work-image-area {
    display: grid;
    place-items: center;


    width: 100%;
  }


  .work-image-area img {
    display: block;


    width: 100%;
    height: auto;


    /*
     * Gallery詳細画像自身だけを
     * ロード完了後にlinearで出現させる。
     *
     * 共通時間はLayout.astroの
     * --page-enter-duration。
     */
    opacity: 0;

    transition:
      opacity
      var(
        --page-enter-duration
      )
      linear;
  }


  .work-image-area
    img.is-work-image-loaded {
    opacity: 1;
  }


  .work-caption {
    width: 100%;


    margin:
      24px
      0
      0;


    text-align: right;
  }


  .work-title,
  .work-body {
    margin: 0;


    font-family:
      var(
        --site-font-family
      );


    letter-spacing: 0.08em;
    line-height: 1.8;
    white-space: pre-line;
  }


  .work-title {
    color:
      var(
        --gallery-detail-title-color
      );


    font-size:
      var(
        --gallery-detail-title-size
      );
  }


  .work-body {
    margin-top: 4px;


    color:
      var(
        --gallery-detail-caption-color
      );


    font-size:
      var(
        --gallery-detail-caption-size
      );
  }


  @media (max-width: 640px) {
    :global(
      html.is-gallery-detail-page
    ),
    :global(
      body.is-gallery-detail-page
    ) {
      width: 100%;
      height: 100%;


      overflow: hidden;
      overscroll-behavior-y: none;
    }


    :global(
      body.is-gallery-detail-page
    ) {
      position: fixed;
      inset: 0;


      touch-action: auto;
    }


    .work-page {
      width: 100%;
      height: 100dvh;
      min-height: 0;


      padding:
        calc(
          88px +
          env(
            safe-area-inset-top,
            0px
          )
        )
        20px
        calc(
          24px +
          env(
            safe-area-inset-bottom,
            0px
          )
        );


      display: flex;
      align-items: center;
      justify-content: center;


      overflow: hidden;
      overscroll-behavior: none;
    }


    .work-display {
      display: flex;
      flex-direction: column;
      align-items: center;


      width: 100%;
      max-width: 100%;


      max-height: 100%;
      min-height: 0;
    }


    .work-image-area {
      display: flex;
      align-items: center;
      justify-content: center;


      width: 100%;
      min-height: 0;


      flex:
        1
        1
        auto;


      overflow: hidden;
    }


    .work-image-area img {
      display: block;


      width: auto;
      max-width: 100%;


      height: auto;
      max-height: 100%;


      object-fit: contain;


      touch-action: auto;
    }


    .work-caption {
      width:
        min(
          100%,
          var(
            --rendered-image-width,
            100%
          )
        );


      flex:
        0
        0
        auto;


      margin:
        28px
        0
        0;


      text-align: right;
    }
  }
</style>