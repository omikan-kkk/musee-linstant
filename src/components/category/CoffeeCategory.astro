---
const {
  items = [],
} = Astro.props;

function formatDate(
  date = ""
) {
  return date.replaceAll(
    "-",
    "/"
  );
}

const sortedItems = [
  ...items,
].sort(
  (a, b) =>
    (
      b.date ||
      ""
    ).localeCompare(
      a.date ||
        ""
    )
);
---

<section
  class="coffee-section"
  data-coffee-section
>
  <div
    class="coffee-scale-shell"
    data-coffee-scale-shell
  >
    <div
      class="coffee-stage"
      data-coffee-stage
    >
      <div
        class="coffee-list"
        data-coffee-list
      >
        {
          sortedItems.map(
            (item) => (
              <article
                class="coffee-item"
                data-coffee-item
              >
                <time
                  class="coffee-date"
                  datetime={item.date}
                >
                  {formatDate(item.date)}
                </time>

                <span
                  class="coffee-brand"
                  data-coffee-brand
                >
                  {item.brand}
                </span>

                <span
                  class="coffee-name"
                  data-coffee-name
                >
                  {item.coffeeName}
                </span>

                <span class="coffee-notes">
                  {item.notes}
                </span>
              </article>
            )
          )
        }
      </div>
    </div>
  </div>

  <script>
    const coffeeSection =
      document.querySelector<HTMLElement>(
        "[data-coffee-section]"
      );

    const scaleShell =
      document.querySelector<HTMLElement>(
        "[data-coffee-scale-shell]"
      );

    const coffeeStage =
      document.querySelector<HTMLElement>(
        "[data-coffee-stage]"
      );

    const coffeeList =
      document.querySelector<HTMLElement>(
        "[data-coffee-list]"
      );

    /*
     * type: coffeeでは、
     * Layout内の.fade-scrollが
     * 実際の縦スクロール主体。
     */
    const scrollRoot =
      document.querySelector<HTMLElement>(
        "[data-scroll-root]"
      );

    const coffeeItems = [
      ...document.querySelectorAll<HTMLElement>(
        "[data-coffee-item]"
      ),
    ];

    const brandElements = [
      ...document.querySelectorAll<HTMLElement>(
        "[data-coffee-brand]"
      ),
    ];

    const nameElements = [
      ...document.querySelectorAll<HTMLElement>(
        "[data-coffee-name]"
      ),
    ];

    const visualViewport =
      window.visualViewport;

    const ZOOM_ENTER_THRESHOLD =
      1.02;

    const ZOOM_EXIT_THRESHOLD =
      1.005;

    const ZOOM_EXIT_SETTLE_MS =
      180;

    let layoutFrame = 0;
    let initialFrame = 0;
    let zoomFrame = 0;

    let zoomExitTimer = 0;

    let naturalWidth = 0;
    let naturalHeight = 0;

    let fittedWidth = 0;
    let fittedHeight = 0;
    let fittedScale = 1;

    let isZoomed = false;
    let isInitialFitComplete =
      false;

    /*
     * 現在、上側と下側へ追加している
     * 動的な閲覧領域。
     */
    let currentZoomReserve = 0;

    const getViewportScale =
      () =>
        visualViewport?.scale ||
        1;

    const getScrollTop =
      () =>
        scrollRoot?.scrollTop ||
        window.scrollY ||
        0;

    const setScrollTop = (
      value: number
    ) => {
      const nextValue =
        Math.max(
          0,
          value
        );

      if (scrollRoot) {
        scrollRoot.scrollTo({
          top: nextValue,
          behavior: "auto",
        });

        return;
      }

      window.scrollTo({
        top: nextValue,
        behavior: "auto",
      });
    };

    /*
     * 要素の実描画幅をDOMから直接測る。
     *
     * scrollWidthをBrand / Nameの
     * 文字幅判定には使用しない。
     */
    const getMaximumRenderedWidth =
      (
        elements: HTMLElement[]
      ) =>
        elements.reduce(
          (
            maximum,
            element
          ) =>
            Math.max(
              maximum,
              element
                .getBoundingClientRect()
                .width
            ),
          0
        );

    /*
     * CoffeeSectionの実際のcontent幅。
     *
     * viewport幅から想像するのではなく、
     * Layoutを含めて最終的に描画された
     * sectionそのものを基準にする。
     */
    const getAvailableWidth =
      () => {
        if (!coffeeSection) {
          return Math.max(
            1,
            window.innerWidth
          );
        }

        const sectionStyle =
          window.getComputedStyle(
            coffeeSection
          );

        const paddingLeft =
          Number.parseFloat(
            sectionStyle.paddingLeft
          ) || 0;

        const paddingRight =
          Number.parseFloat(
            sectionStyle.paddingRight
          ) || 0;

        return Math.max(
          1,
          coffeeSection.clientWidth -
            paddingLeft -
            paddingRight
        );
      };

    /*
     * 最長Brandと最長Nameを
     * 実DOMから測定し、
     * 全Coffeeへ同じ列幅を適用する。
     */
    const applyDynamicColumns =
      () => {
        if (!coffeeList) {
          return;
        }

        /*
         * 一度、自然な列幅へ戻す。
         */
        coffeeList.style.setProperty(
          "--coffee-brand-column",
          "max-content"
        );

        coffeeList.style.setProperty(
          "--coffee-name-column",
          "max-content"
        );

        /*
         * 上記変更をレイアウトへ反映。
         */
        coffeeList.getBoundingClientRect();

        const maximumBrandWidth =
          getMaximumRenderedWidth(
            brandElements
          );

        const maximumNameWidth =
          getMaximumRenderedWidth(
            nameElements
          );

        coffeeList.style.setProperty(
          "--coffee-brand-column",
          `${Math.ceil(
            maximumBrandWidth
          )}px`
        );

        coffeeList.style.setProperty(
          "--coffee-name-column",
          `${Math.ceil(
            maximumNameWidth
          )}px`
        );

        /*
         * 最終列幅もレイアウトへ反映させてから
         * 1行目を測定する。
         */
        coffeeList.getBoundingClientRect();
      };

    /*
     * 各Coffeeの1行目について、
     *
     * Dateの左端
     * ↓
     * Nameの右端
     *
     * を実際のDOM座標から測定する。
     *
     * 一番長いものだけを
     * Coffee全体のfit基準とする。
     */
    const getLongestFirstRowWidth =
      () =>
        coffeeItems.reduce(
          (
            maximum,
            item
          ) => {
            const date =
              item.querySelector<HTMLElement>(
                ".coffee-date"
              );

            const name =
              item.querySelector<HTMLElement>(
                ".coffee-name"
              );

            if (
              !date ||
              !name
            ) {
              return maximum;
            }

            const dateRect =
              date.getBoundingClientRect();

            const nameRect =
              name.getBoundingClientRect();

            const rowWidth =
              nameRect.right -
              dateRect.left;

            return Math.max(
              maximum,
              rowWidth
            );
          },
          0
        );

    /*
     * 現在のピンチ倍率に必要な
     * 上下それぞれの追加領域。
     */
    const calculateZoomReserve =
      (
        viewportScale: number
      ) => {
        if (fittedHeight <= 0) {
          return 0;
        }

        const normalizedScale =
          Math.max(
            1,
            viewportScale
          );

        const zoomedHeight =
          fittedHeight *
          normalizedScale;

        const additionalHeight =
          Math.max(
            0,
            zoomedHeight -
              fittedHeight
          );

        return (
          additionalHeight / 2
        );
      };

    /*
     * ピンチ拡大時に、
     * Coffeeの上端・下端まで
     * 閲覧可能にするための領域を更新。
     */
    const applyZoomGeometry =
      (
        viewportScale: number
      ) => {
        if (
          !coffeeSection ||
          !scaleShell ||
          fittedHeight <= 0
        ) {
          return;
        }

        const nextReserve =
          calculateZoomReserve(
            viewportScale
          );

        const reserveDelta =
          nextReserve -
          currentZoomReserve;

        const totalLayoutHeight =
          fittedHeight +
          nextReserve * 2;

        currentZoomReserve =
          nextReserve;

        scaleShell.style.setProperty(
          "--coffee-zoom-reserve",
          `${nextReserve}px`
        );

        scaleShell.style.height =
          `${fittedHeight}px`;

        coffeeSection.style.setProperty(
          "--coffee-content-layout-height",
          `${totalLayoutHeight}px`
        );

        if (
          Math.abs(
            reserveDelta
          ) > 0.1
        ) {
          setScrollTop(
            getScrollTop() +
            reserveDelta
          );
        }
      };

    const enterZoomMode =
      () => {
        if (
          isZoomed ||
          fittedHeight <= 0
        ) {
          return;
        }

        isZoomed = true;

        window.clearTimeout(
          zoomExitTimer
        );

        zoomExitTimer = 0;

        applyZoomGeometry(
          getViewportScale()
        );
      };

    const updateZoomMode =
      () => {
        zoomFrame = 0;

        if (!isZoomed) {
          return;
        }

        applyZoomGeometry(
          getViewportScale()
        );
      };

    const scheduleZoomUpdate =
      () => {
        if (zoomFrame) {
          cancelAnimationFrame(
            zoomFrame
          );
        }

        zoomFrame =
          requestAnimationFrame(
            updateZoomMode
          );
      };

    /*
     * 元倍率へ戻ったら、
     * 動的に追加した上下領域を撤去する。
     */
    const exitZoomMode =
      () => {
        zoomExitTimer = 0;

        if (
          !isZoomed ||
          getViewportScale() >
            ZOOM_EXIT_THRESHOLD
        ) {
          return;
        }

        const previousReserve =
          currentZoomReserve;

        isZoomed = false;
        currentZoomReserve = 0;

        scaleShell?.style.setProperty(
          "--coffee-zoom-reserve",
          "0px"
        );

        if (fittedHeight > 0) {
          scaleShell!.style.height =
            `${fittedHeight}px`;

          coffeeSection?.style.setProperty(
            "--coffee-content-layout-height",
            `${fittedHeight}px`
          );
        }

        if (
          previousReserve > 0
        ) {
          setScrollTop(
            getScrollTop() -
            previousReserve
          );
        }

        scheduleCoffeeFit();
      };

    const scheduleZoomExit =
      () => {
        window.clearTimeout(
          zoomExitTimer
        );

        zoomExitTimer =
          window.setTimeout(
            exitZoomMode,
            ZOOM_EXIT_SETTLE_MS
          );
      };

    /*
     * ==================================================
     *
     * Coffee全体のfit
     *
     * ==================================================
     *
     * 縮小率の基準：
     *
     * Coffee全体のscrollWidthではなく、
     * 「実際に最も長い1行目」。
     *
     * 縮小対象：
     *
     * coffee-stage全体。
     *
     * そのため、
     *
     * Date
     * Brand
     * Name
     * Notes
     * 行間
     * 列間
     * Coffee同士の間隔
     *
     * すべてが完全に同率で縮小される。
     */
    const applyCoffeeFit =
      () => {
        layoutFrame = 0;

        if (
          isZoomed ||
          !coffeeSection ||
          !scaleShell ||
          !coffeeStage ||
          !coffeeList
        ) {
          return;
        }

        /*
         * 測定時は必ず自然倍率へ戻す。
         */
        coffeeStage.style.setProperty(
          "--coffee-stage-scale",
          "1"
        );

        /*
         * transform:scale(1)を
         * レイアウト・描画へ確定させる。
         */
        coffeeStage.getBoundingClientRect();

        /*
         * Brand / Nameの共通列幅を確定。
         */
        applyDynamicColumns();

        /*
         * 縮小率の基準は
         * 最も長い1行目そのもの。
         */
        naturalWidth =
          getLongestFirstRowWidth();

        /*
         * 高さはfit率決定には使わない。
         * ピンチ時の上下閲覧領域計算用。
         */
        naturalHeight =
          coffeeStage.scrollHeight;

        if (
          naturalWidth <= 0 ||
          naturalHeight <= 0
        ) {
          return;
        }

        const availableWidth =
          getAvailableWidth();

        fittedScale =
          Math.min(
            1,
            availableWidth /
              naturalWidth
          );

        fittedWidth =
          naturalWidth *
          fittedScale;

        fittedHeight =
          naturalHeight *
          fittedScale;

        /*
         * Coffee全体へ適用するscaleは
         * この一か所だけ。
         */
        coffeeStage.style.setProperty(
          "--coffee-stage-scale",
          String(
            fittedScale
          )
        );

        /*
         * transformはlayout寸法を縮小しないため、
         * shellだけ見た目の縮小後寸法へ合わせる。
         */
        scaleShell.style.width =
          `${fittedWidth}px`;

        scaleShell.style.height =
          `${fittedHeight}px`;

        currentZoomReserve = 0;

        scaleShell.style.setProperty(
          "--coffee-zoom-reserve",
          "0px"
        );

        coffeeSection.style.setProperty(
          "--coffee-content-layout-height",
          `${fittedHeight}px`
        );

        isInitialFitComplete =
          true;
      };

    const scheduleCoffeeFit =
      () => {
        if (
          isZoomed ||
          !isInitialFitComplete
        ) {
          return;
        }

        if (layoutFrame) {
          cancelAnimationFrame(
            layoutFrame
          );
        }

        layoutFrame =
          requestAnimationFrame(
            applyCoffeeFit
          );
      };

    /*
     * ==================================================
     *
     * 初回fit
     *
     * ==================================================
     *
     * devとproduction buildで
     * CSS・フォント・JSの読み込み順が
     * 異なっても、
     *
     * window load
     * ↓
     * fonts.ready
     * ↓
     * requestAnimationFrame × 2
     * ↓
     * applyCoffeeFit
     *
     * の順序で初回計測する。
     */
    const runInitialCoffeeFit =
      async () => {
        if (
          document.fonts
        ) {
          try {
            await document.fonts.ready;
          } catch {
            /*
             * fonts.ready失敗時も、
             * ページ自体の表示は継続する。
             */
          }
        }

        initialFrame =
          requestAnimationFrame(
            () => {
              initialFrame =
                requestAnimationFrame(
                  () => {
                    initialFrame = 0;

                    applyCoffeeFit();
                  }
                );
            }
          );
      };

    const handleWindowLoad =
      () => {
        runInitialCoffeeFit();
      };

    /*
     * ピンチ中はCoffee自身のfit倍率を
     * 変更せず、閲覧領域だけ更新。
     */
    const handleViewportResize =
      () => {
        const viewportScale =
          getViewportScale();

        if (
          viewportScale >
          ZOOM_ENTER_THRESHOLD
        ) {
          enterZoomMode();
          scheduleZoomUpdate();
          return;
        }

        if (isZoomed) {
          scheduleZoomExit();
          return;
        }

        /*
         * 初回fit完了前のresizeでは
         * fit処理を横取りしない。
         */
        if (
          !isInitialFitComplete
        ) {
          return;
        }

        scheduleCoffeeFit();
      };

    const cleanup = () => {
      if (layoutFrame) {
        cancelAnimationFrame(
          layoutFrame
        );
      }

      if (initialFrame) {
        cancelAnimationFrame(
          initialFrame
        );
      }

      if (zoomFrame) {
        cancelAnimationFrame(
          zoomFrame
        );
      }

      window.clearTimeout(
        zoomExitTimer
      );

      layoutFrame = 0;
      initialFrame = 0;
      zoomFrame = 0;
      zoomExitTimer = 0;

      window.removeEventListener(
        "load",
        handleWindowLoad
      );

      window.removeEventListener(
        "resize",
        handleViewportResize
      );

      window.removeEventListener(
        "orientationchange",
        handleViewportResize
      );

      visualViewport?.removeEventListener(
        "resize",
        handleViewportResize
      );

      document.removeEventListener(
        "astro:before-swap",
        cleanup
      );
    };

    /*
     * script実行時点ですでにload済みなら、
     * そのまま初回fitへ。
     *
     * まだload前なら、
     * window loadを待ってから開始する。
     */
    if (
      document.readyState ===
      "complete"
    ) {
      runInitialCoffeeFit();
    } else {
      window.addEventListener(
        "load",
        handleWindowLoad,
        {
          once: true,
        }
      );
    }

    window.addEventListener(
      "resize",
      handleViewportResize
    );

    window.addEventListener(
      "orientationchange",
      handleViewportResize
    );

    visualViewport?.addEventListener(
      "resize",
      handleViewportResize
    );

    document.addEventListener(
      "astro:before-swap",
      cleanup
    );
  </script>
</section>

<style>
  .coffee-section {
    /*
     * 全デバイス共通。
     */

    --coffee-date-column:
      56px;

    /*
     * Date列終端 → Brand開始位置。
     */
    --coffee-date-brand-gap:
      30px;

    /*
     * 最長Brand終端 → Name開始位置。
     */
    --coffee-brand-name-gap:
      16px;

    /*
     * 1行目 → Notes。
     */
    --coffee-row-gap:
      8px;

    /*
     * Coffeeコンテンツ同士。
     */
    --coffee-item-gap:
      36px;

    --coffee-side-padding:
      clamp(
        24px,
        8vw,
        120px
      );

    --coffee-vertical-padding:
      clamp(
        120px,
        12vh,
        140px
      );

    --coffee-content-layout-height:
      0px;

    min-height:
      max(
        100vh,
        calc(
          var(
            --coffee-content-layout-height
          ) +
          var(
            --coffee-vertical-padding
          ) *
          2
        )
      );

    padding:
      var(
        --coffee-vertical-padding
      )
      var(
        --coffee-side-padding
      );

    background:
      #fff;

    color:
      var(
        --coffee-list-color,
        #555
      );

    font-family:
      var(
        --site-font-family
      );

    -webkit-text-size-adjust:
      none;

    text-size-adjust:
      none;
  }

  .coffee-scale-shell {
    --coffee-zoom-reserve:
      0px;

    position:
      relative;

    box-sizing:
      content-box;

    width:
      max-content;

    height:
      auto;

    padding-top:
      var(
        --coffee-zoom-reserve
      );

    padding-bottom:
      var(
        --coffee-zoom-reserve
      );

    margin:
      0
      auto;
  }

  /*
   * Coffee全体を縮小する唯一の場所。
   */
  .coffee-stage {
    --coffee-stage-scale:
      1;

    width:
      max-content;

    color:
      var(
        --coffee-list-color,
        #555
      );

    font-family:
      var(
        --site-font-family
      );

    /*
     * CMSのtype coffee All。
     */
    font-size:
      var(
        --coffee-list-size,
        14px
      );

    font-weight:
      400;

    line-height:
      1.8;

    letter-spacing:
      0.08em;

    -webkit-text-size-adjust:
      none;

    text-size-adjust:
      none;

    transform:
      scale(
        var(
          --coffee-stage-scale
        )
      );

    transform-origin:
      top
      left;

    will-change:
      transform;
  }

  .coffee-list {
    --coffee-brand-column:
      180px;

    --coffee-name-column:
      max-content;

    display:
      flex;

    flex-direction:
      column;

    gap:
      var(
        --coffee-item-gap
      );

    width:
      max-content;

    margin:
      0;
  }

  .coffee-item {
    display:
      grid;

    grid-template-columns:
      var(
        --coffee-date-column
      )
      var(
        --coffee-date-brand-gap
      )
      var(
        --coffee-brand-column
      )
      var(
        --coffee-brand-name-gap
      )
      var(
        --coffee-name-column
      );

    row-gap:
      var(
        --coffee-row-gap
      );

    align-items:
      baseline;

    width:
      max-content;

    font:
      inherit;

    color:
      inherit;

    letter-spacing:
      inherit;
  }

  .coffee-date {
    grid-column:
      1;
  }

  .coffee-brand {
    grid-column:
      3;
  }

  .coffee-name {
    grid-column:
      5;
  }

  /*
   * Date / Brand / Name / Notesは
   * 完全に同じ文字設定を継承する。
   */
  .coffee-date,
  .coffee-brand,
  .coffee-name,
  .coffee-notes {
    margin:
      0;

    padding:
      0;

    border:
      0;

    color:
      inherit;

    font:
      inherit;

    letter-spacing:
      inherit;

    -webkit-text-size-adjust:
      none;

    text-size-adjust:
      none;
  }

  .coffee-date,
  .coffee-brand,
  .coffee-name {
    white-space:
      nowrap;
  }

  .coffee-notes {
    display:
      block;

    grid-column:
      1 / -1;

    min-width:
      0;

    width:
      100%;

    white-space:
      pre-line;

    overflow-wrap:
      anywhere;
  }
</style>