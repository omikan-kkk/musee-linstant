---
import Header from "../components/header/Header.astro";
import EdgeFade from "../components/common/EdgeFade.astro";
import { THEME } from "../config/site";


const {
  title = "Musée de l'Instant",
  showHeader = false,
  showEdgeFade = false,
  edgeFadeHorizontal = false,
  lockVerticalScroll = false,
  documentHorizontalScroll = false,
  enableScrollReveal = false,
} = Astro.props;


const latinFontFamilies = {
  helvetica:
    '"Helvetica Neue", Helvetica, Arial',
  "system-sans":
    '-apple-system, BlinkMacSystemFont, "Segoe UI"',
  georgia:
    'Georgia, "Times New Roman"',
  times:
    '"Times New Roman", Times',
  "system-serif":
    'ui-serif, Georgia, "Times New Roman"',
};


const japaneseFontFamilies = {
  sans:
    '"Hiragino Kaku Gothic ProN", "Yu Gothic", "YuGothic", Meiryo, sans-serif',
  "yu-gothic":
    '"Yu Gothic", "YuGothic", "Hiragino Kaku Gothic ProN", Meiryo, sans-serif',
  "hiragino-sans":
    '"Hiragino Sans", "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif',
  serif:
    '"Hiragino Mincho ProN", "Yu Mincho", "YuMinincho", serif',
  "yu-mincho":
    '"Yu Mincho", "YuMincho", "Hiragino Mincho ProN", serif',
  "hiragino-mincho":
    '"Hiragino Mincho ProN", "Yu Mincho", "YuMinincho", serif',
};


const latinFontFamily =
  latinFontFamilies[
    THEME.fontFamilyLatin
  ] ??
  latinFontFamilies.helvetica;


const japaneseFontFamily =
  japaneseFontFamilies[
    THEME.fontFamilyJapanese
  ] ??
  japaneseFontFamilies.sans;


const siteFontFamily =
  `${latinFontFamily}, ${japaneseFontFamily}`;
---


<!doctype html>
<html
  lang="ja"
  class:list={[
    documentHorizontalScroll &&
      "has-document-horizontal-scroll",
  ]}
>
  <head>
    <meta charset="UTF-8" />


    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />


    <title>{title}</title>
  </head>


  <body
    class:list={[
      showHeader &&
        "has-scrolled",
      showHeader &&
        "force-header",
      showEdgeFade &&
        "has-edge-fade",
      documentHorizontalScroll &&
        "has-document-horizontal-scroll",
      enableScrollReveal &&
        "has-scroll-reveal",
    ]}
    style={`
      --site-font-family:${siteFontFamily};


      --navigation-size:${THEME.fontSizes.navigation}px;
      --gallery-list-title-size:${THEME.fontSizes.galleryListTitle}px;
      --gallery-list-caption-size:${THEME.fontSizes.galleryListCaption}px;
      --gallery-detail-title-size:${THEME.fontSizes.galleryDetailTitle}px;
      --gallery-detail-caption-size:${THEME.fontSizes.galleryDetailCaption}px;
      --book-list-size:${THEME.fontSizes.bookList}px;
      --coffee-list-size:${THEME.fontSizes.coffeeList}px;


      --navigation-color:${THEME.colors.navigation};
      --gallery-list-title-color:${THEME.colors.galleryListTitle};
      --gallery-list-caption-color:${THEME.colors.galleryListCaption};
      --gallery-detail-title-color:${THEME.colors.galleryDetailTitle};
      --gallery-detail-caption-color:${THEME.colors.galleryDetailCaption};
      --book-list-color:${THEME.colors.bookList};
      --coffee-list-color:${THEME.colors.coffeeList};
    `}
  >
    {
      documentHorizontalScroll ? (
        <>
          <div
            class="document-horizontal-content"
            data-document-horizontal-content
          >
            <slot />
          </div>


          <EdgeFade
            horizontal={true}
            fixedHorizontal={true}
          />
        </>
      ) : showEdgeFade ? (
        <div class="fade-viewport">
          <div
            class:list={[
              "fade-scroll",
              lockVerticalScroll &&
                "is-y-locked",
            ]}
            data-scroll-root
          >
            <div class="fade-content">
              <slot />
            </div>
          </div>
        </div>
      ) : (
        <slot />
      )
    }


    <Header />


    {
      enableScrollReveal && (
        <script>
          let scrollRevealObserver:
            IntersectionObserver |
            null =
            null;


          const cleanupScrollReveal =
            () => {
              scrollRevealObserver
                ?.disconnect();


              scrollRevealObserver =
                null;
            };


          const revealTarget =
            (
              target:
                HTMLElement
            ) => {
              if (
                target.classList.contains(
                  "is-scroll-revealed"
                )
              ) {
                return;
              }


              target.classList.add(
                "is-scroll-revealed"
              );


              scrollRevealObserver
                ?.unobserve(
                  target
                );
            };


          const revealTargetWhenReady =
            (
              target:
                HTMLElement
            ) => {
              const image =
                target.querySelector<HTMLImageElement>(
                  "[data-gallery-image]"
                );


              /*
               * Coffeeなど、
               * 画像を持たないReveal対象は
               * そのまま表示する。
               */
              if (!image) {
                revealTarget(
                  target
                );

                return;
              }


              /*
               * Galleryでは画像とキャプションを
               * 1作品として同時にRevealする。
               *
               * 画像がまだロードされていない場合は、
               * 実画像のロード完了を待ってから
               * 作品全体を表示する。
               */
              if (image.complete) {
                revealTarget(
                  target
                );

                return;
              }


              const handleImageReady =
                () => {
                  revealTarget(
                    target
                  );
                };


              image.addEventListener(
                "load",
                handleImageReady,
                {
                  once: true,
                }
              );


              /*
               * 画像取得に失敗した場合でも、
               * テキストまで永久に非表示に
               * ならないようにする。
               */
              image.addEventListener(
                "error",
                handleImageReady,
                {
                  once: true,
                }
              );
            };


          const setupScrollReveal =
            () => {
              cleanupScrollReveal();


              if (
                !document.body
                  .classList.contains(
                    "has-scroll-reveal"
                  )
              ) {
                return;
              }


              const targets = [
                ...document
                  .querySelectorAll<HTMLElement>(
                    "[data-scroll-reveal]"
                  ),
              ];


              if (
                targets.length ===
                0
              ) {
                return;
              }


              /*
               * 動きを減らす設定では
               * アニメーションせず、
               * 最初からすべて表示する。
               */
              if (
                window.matchMedia(
                  "(prefers-reduced-motion: reduce)"
                ).matches
              ) {
                targets.forEach(
                  (
                    target
                  ) => {
                    target.classList.add(
                      "is-scroll-revealed"
                    );
                  }
                );


                return;
              }


              scrollRevealObserver =
                new IntersectionObserver(
                  (
                    entries
                  ) => {
                    entries.forEach(
                      (
                        entry
                      ) => {
                        if (
                          !entry.isIntersecting
                        ) {
                          return;
                        }


                        const target =
                          entry.target as HTMLElement;


                        revealTargetWhenReady(
                          target
                        );
                      }
                    );
                  },
                  {
                    /*
                     * 画面最下端へ触れた瞬間ではなく、
                     * viewport内へ少し入ってから
                     * Revealを開始する。
                     */
                    root: null,


                    rootMargin:
                      "0px 0px -10% 0px",


                    threshold:
                      0.01,
                  }
                );


              targets.forEach(
                (
                  target
                ) => {
                  if (
                    target.classList.contains(
                      "is-scroll-revealed"
                    )
                  ) {
                    return;
                  }


                  scrollRevealObserver
                    ?.observe(
                      target
                    );
                }
              );
            };


          /*
           * CSSのopacity:0が一度描画された後に
           * Observerを開始する。
           *
           * 最初からviewport内にある作品も
           * 自然にフェードインする。
           */
          requestAnimationFrame(
            () => {
              requestAnimationFrame(
                setupScrollReveal
              );
            }
          );


          const handlePageLoad =
            () => {
              requestAnimationFrame(
                () => {
                  requestAnimationFrame(
                    setupScrollReveal
                  );
                }
              );
            };


          const handleBeforeSwap =
            () => {
              cleanupScrollReveal();


              document.removeEventListener(
                "astro:page-load",
                handlePageLoad
              );


              document.removeEventListener(
                "astro:before-swap",
                handleBeforeSwap
              );
            };


          document.addEventListener(
            "astro:page-load",
            handlePageLoad
          );


          document.addEventListener(
            "astro:before-swap",
            handleBeforeSwap
          );
        </script>
      )
    }
  </body>
</html>


<style>
  /*
   * ==================================================
   *
   * PAGE ENTER FADE
   *
   * ==================================================
   *
   * フェード時間の共通設定。
   *
   * ページ白幕
   * Scroll Reveal
   *
   * すべてこの値を使用する。
   *
   * 時間を変更したい場合は
   * この1箇所だけ変更する。
   */
  :global(body) {
    --page-enter-duration:
      1000ms;
  }


  /*
   * ページを開いた瞬間だけ、
   * viewport全体を白い幕で覆う。
   */
  :global(body::after) {
    content: "";

    position: fixed;

    inset: 0;

    z-index: 10000;

    background:
      #fff;

    pointer-events:
      none;

    opacity: 1;

    animation:
      page-enter-curtain
      var(
        --page-enter-duration
      )
      cubic-bezier(
        0.22,
        1,
        0.36,
        1
      )
      forwards;
  }


  /*
   * テキスト等の現在のフェード感は維持。
   */
  @keyframes page-enter-curtain {
    0% {
      opacity: 1;
    }

    18% {
      opacity: 0.96;
    }

    48% {
      opacity: 0.58;
    }

    78% {
      opacity: 0.16;
    }

    100% {
      opacity: 0;
    }
  }


  :global(html),
  :global(body) {
    margin: 0;


    background: #fff;
    color: #111;


    font-family:
      var(
        --site-font-family
      );
  }


  :global(
    body.has-edge-fade
  ) {
    height: 100dvh;
    overflow: hidden;
  }


  :global(*) {
    box-sizing: border-box;
  }


  /*
   * ==================================================
   *
   * SCROLL REVEAL
   *
   * ==================================================
   *
   * Gallery / Coffee一覧専用。
   *
   * 初めてviewport内へ入った時だけ
   * opacity:0 → 1。
   *
   * translate等の移動は一切行わない。
   *
   * 一度Revealされた要素は
   * そのページ滞在中ずっと表示されたまま。
   */
  :global(
    body.has-scroll-reveal
      [data-scroll-reveal]
  ) {
    opacity: 0;


    transition:
      opacity
      var(
        --page-enter-duration
      )
      cubic-bezier(
        0.22,
        1,
        0.36,
        1
      );
  }


  :global(
    body.has-scroll-reveal
      [data-scroll-reveal].is-scroll-revealed
  ) {
    opacity: 1;
  }


  @media (
    prefers-reduced-motion:
      reduce
  ) {
    :global(
      body.has-scroll-reveal
        [data-scroll-reveal]
    ) {
      opacity: 1;


      transition: none;
    }
  }


  /*
   * type: book専用。
   *
   * 通常倍率では横方向だけを
   * 文書スクロールとして利用する。
   */
  :global(
    html.has-document-horizontal-scroll
  ) {
    width: 100%;
    height: 100%;


    overflow-x: auto;
    overflow-y: hidden;


    overscroll-behavior-x:
      contain;


    overscroll-behavior-y:
      none;


    -webkit-overflow-scrolling:
      touch;
  }


  /*
   * Bookページでピンチ拡大されている間だけ、
   * 縦方向の移動を許可する。
   */
  :global(
    html.has-document-horizontal-scroll.is-book-zoomed
  ) {
    overflow-x: auto;
    overflow-y: auto;


    overscroll-behavior-x:
      contain;


    overscroll-behavior-y:
      contain;
  }


  :global(
    html.has-document-horizontal-scroll
  ),
  :global(
    body.has-document-horizontal-scroll
  ) {
    color-scheme:
      only light;


    scrollbar-color:
      rgba(
        110,
        110,
        115,
        0.72
      )
      #fff;


    scrollbar-width:
      auto;
  }


  :global(
    html.has-document-horizontal-scroll::-webkit-scrollbar
  ),
  :global(
    body.has-document-horizontal-scroll::-webkit-scrollbar
  ) {
    width: 14px;
    height: 14px;


    background-color:
      #fff;
  }


  :global(
    html.has-document-horizontal-scroll::-webkit-scrollbar-track
  ),
  :global(
    body.has-document-horizontal-scroll::-webkit-scrollbar-track
  ) {
    background-color:
      #fff;
  }


  :global(
    html.has-document-horizontal-scroll::-webkit-scrollbar-corner
  ),
  :global(
    body.has-document-horizontal-scroll::-webkit-scrollbar-corner
  ) {
    background-color:
      #fff;
  }


  :global(
    html.has-document-horizontal-scroll::-webkit-scrollbar-thumb
  ),
  :global(
    body.has-document-horizontal-scroll::-webkit-scrollbar-thumb
  ) {
    min-width: 42px;


    border:
      3px
      solid
      #fff;


    border-radius:
      999px;


    background-color:
      rgba(
        110,
        110,
        115,
        0.72
      );


    background-clip:
      padding-box;
  }


  :global(
    html.has-document-horizontal-scroll::-webkit-scrollbar-thumb:hover
  ),
  :global(
    body.has-document-horizontal-scroll::-webkit-scrollbar-thumb:hover
  ) {
    background-color:
      rgba(
        80,
        80,
        85,
        0.78
      );


    background-clip:
      padding-box;
  }


  :global(
    body.has-document-horizontal-scroll
  ) {
    position: relative;


    width: auto;
    min-width: 100%;


    height: 100dvh;
    min-height: 100dvh;


    overflow: visible;


    isolation: isolate;


    touch-action:
      pan-x
      pinch-zoom;
  }


  :global(
    body.has-document-horizontal-scroll.is-book-zoomed
  ) {
    height: auto;
    min-height: 100dvh;


    overflow: visible;


    touch-action:
      pan-x
      pan-y
      pinch-zoom;
  }


  :global(
    body.has-edge-fade.has-document-horizontal-scroll
  ) {
    width: auto;
    min-width: 100%;


    height: 100dvh;
    min-height: 100dvh;


    overflow: visible;
  }


  :global(
    body.has-edge-fade.has-document-horizontal-scroll.is-book-zoomed
  ) {
    height: auto;
    min-height: 100dvh;


    overflow: visible;
  }


  .document-horizontal-content {
    position: relative;


    z-index: 0;


    display: block;


    width: max-content;
    min-width: 100vw;


    height: 100dvh;
    min-height: 100dvh;


    overflow: visible;
  }


  :global(
    body.is-book-zoomed
  )
    .document-horizontal-content {
    height: auto;
    min-height: 100dvh;
  }


  /*
   * Gallery / Coffee等の
   * 縦スクロール主体。
   *
   * 以前ここには上下EdgeFadeを
   * 重ねていたが、
   * 今回それだけを撤去する。
   *
   * Coffeeのスクロール位置補正が
   * data-scroll-rootを参照しているため、
   * スクロール構造自体は維持する。
   */
  .fade-viewport {
    position: fixed;
    inset: 0;


    overflow: hidden;


    background: #fff;


    z-index: 0;
  }


  .fade-scroll {
    position: relative;


    width: 100%;
    height: 100dvh;


    overflow-x: hidden;
    overflow-y: auto;


    -webkit-overflow-scrolling:
      touch;


    overscroll-behavior:
      none;
  }


  .fade-scroll.is-y-locked {
    overflow-y: hidden;
  }


  .fade-content {
    position: relative;


    z-index: 0;


    min-height: 100%;
  }
</style>