---
const {
  items = [],
} = Astro.props;

const grouped = Object.values(
  items.reduce(
    (groups, item) => {
      const author =
        item.author ||
        "Unknown";

      const authorSort =
        item.authorSort ||
        author;

      if (!groups[author]) {
        groups[author] = {
          author,
          authorSort,
          authorFontSizeOverride:
            item.authorFontSizeOverride ||
            false,
          authorFontSize:
            item.authorFontSize ||
            null,
          books: [],
        };
      }

      groups[author].books.push(
        item
      );

      return groups;
    },
    {}
  )
);

grouped.sort(
  (a, b) =>
    a.authorSort.localeCompare(
      b.authorSort,
      "ja"
    )
);

grouped.forEach((group) => {
  group.books.sort(
    (a, b) =>
      (
        a.titleSort ||
        a.title
      ).localeCompare(
        b.titleSort ||
          b.title,
        "ja"
      )
  );
});
---

<section
  class="book-section is-initializing"
  data-book-section
>
  <div
    class="book-scale-shell"
    data-book-scale-shell
    style="visibility:hidden;"
  >
    <div
      class="book-stage"
      data-book-stage
    >
      <div
        class="bookshelf"
        data-bookshelf
      >
        {
          grouped.map(
            (group) => (
              <div class="author-group">
                <div class="author-column">
                  <p
                    class="author"
                    style={
                      group.authorFontSizeOverride &&
                      group.authorFontSize
                        ? `font-size:${group.authorFontSize}px;`
                        : undefined
                    }
                  >
                    {group.author}
                  </p>
                </div>

                <div class="book-list">
                  {
                    group.books.map(
                      (book) => (
                        <div class="book-column">
                          <p
                            class="book"
                            data-book-item
                            style={
                              book.titleFontSizeOverride &&
                              book.titleFontSize
                                ? `font-size:${book.titleFontSize}px;`
                                : undefined
                            }
                          >
                            {book.title}
                          </p>
                        </div>
                      )
                    )
                  }
                </div>
              </div>
            )
          )
        }
      </div>
    </div>
  </div>

  <script>
    const bookSection =
      document.querySelector<HTMLElement>(
        "[data-book-section]"
      );

    const scaleShell =
      document.querySelector<HTMLElement>(
        "[data-book-scale-shell]"
      );

    const bookStage =
      document.querySelector<HTMLElement>(
        "[data-book-stage]"
      );

    const bookshelf =
      document.querySelector<HTMLElement>(
        "[data-bookshelf]"
      );

    const books = [
      ...document.querySelectorAll<HTMLElement>(
        "[data-book-item]"
      ),
    ];

    const visualViewport =
      window.visualViewport;

    const landscapeMedia =
      window.matchMedia(
        "(orientation: landscape)"
      );

    const ZOOM_ENTER_THRESHOLD =
      1.02;

    const ZOOM_EXIT_THRESHOLD =
      1.005;

    const ZOOM_RESET_SETTLE_MS =
      240;

    const ORIENTATION_SETTLE_MS =
      260;

    const HORIZONTAL_SCROLL_SETTLE_MS =
      180;

    const VIEWPORT_CHANGE_EPSILON =
      1;

    /*
     * 初期位置確認時に許容する
     * Safariの小数座標誤差。
     */
    const INITIAL_POSITION_EPSILON =
      1;

    /*
     * Safari側の反映が遅れた場合に備える
     * 最大確認フレーム数。
     */
    const INITIAL_POSITION_MAX_ATTEMPTS =
      12;

    type ZoomPhase =
      | "idle"
      | "zooming"
      | "resetting";

    let zoomPhase: ZoomPhase =
      "idle";

    let currentScale = 1;

    let pinchGestureActive =
      false;

    let horizontalGestureActive =
      false;

    let horizontalScrollActive =
      false;

    let pendingAdaptiveLayout =
      false;

    let wheelFrame = 0;
    let pendingWheelDelta = 0;

    let layoutFrame = 0;
    let initialPositionFrame = 0;
    let resetFrame = 0;

    let resetTimer = 0;
    let orientationTimer = 0;
    let horizontalScrollTimer = 0;

    let suppressScrollActivityUntil =
      0;

    let initialPositionComplete =
      false;

    const getDocumentScrollLeft =
      () =>
        window.scrollX ||
        document.documentElement
          .scrollLeft ||
        document.body.scrollLeft ||
        0;

    const getDocumentScrollWidth =
      () =>
        Math.max(
          document.documentElement
            .scrollWidth,
          document.body.scrollWidth
        );

    const getViewportWidth =
      () =>
        visualViewport?.width ||
        window.innerWidth;

    const getViewportHeight =
      () =>
        visualViewport?.height ||
        window.innerHeight;

    const getViewportScale =
      () =>
        visualViewport?.scale ||
        1;

    let lastViewportWidth =
      getViewportWidth();

    let lastViewportHeight =
      getViewportHeight();

    const clamp = (
      value: number,
      minimum: number,
      maximum: number
    ) =>
      Math.min(
        maximum,
        Math.max(
          minimum,
          value
        )
      );

    const setDocumentScroll = (
      left: number,
      top: number
    ) => {
      suppressScrollActivityUntil =
        performance.now() + 120;

      window.scrollTo({
        left,
        top,
        behavior: "auto",
      });
    };

    const setDocumentScrollLeft = (
      value: number
    ) => {
      setDocumentScroll(
        value,
        zoomPhase === "zooming"
          ? window.scrollY
          : 0
      );
    };

    const shouldFitLandscape =
      () =>
        navigator.maxTouchPoints >
          0 &&
        landscapeMedia.matches;

    const notifyZoomPhase = (
      phase: ZoomPhase
    ) => {
      window.dispatchEvent(
        new CustomEvent(
          "book-zoom-phase-change",
          {
            detail: {
              phase,
            },
          }
        )
      );
    };

    const applyZoomClasses = (
      zoomed: boolean
    ) => {
      document.documentElement
        .classList.toggle(
          "is-book-zoomed",
          zoomed
        );

      document.body.classList.toggle(
        "is-book-zoomed",
        zoomed
      );
    };

    const setZoomPhase = (
      phase: ZoomPhase
    ) => {
      zoomPhase = phase;

      applyZoomClasses(
        phase !== "idle"
      );

      notifyZoomPhase(
        phase
      );
    };

    const getUnscaledCenter =
      () => {
        const viewportWidth =
          getViewportWidth();

        return (
          (
            getDocumentScrollLeft() +
            viewportWidth / 2
          ) /
          Math.max(
            currentScale,
            0.0001
          )
        );
      };

    const restoreCenter = (
      unscaledCenter: number
    ) => {
      const viewportWidth =
        getViewportWidth();

      const maxScrollLeft =
        Math.max(
          0,
          getDocumentScrollWidth() -
            viewportWidth
        );

      const targetScroll =
        unscaledCenter *
          currentScale -
        viewportWidth / 2;

      setDocumentScrollLeft(
        clamp(
          targetScroll,
          0,
          maxScrollLeft
        )
      );
    };

    const getNaturalSize =
      () => {
        if (
          !bookStage ||
          !bookshelf
        ) {
          return null;
        }

        const width =
          Math.max(
            bookStage.scrollWidth,
            bookshelf.scrollWidth
          );

        const height =
          Math.max(
            bookStage.scrollHeight,
            bookshelf.scrollHeight
          );

        if (
          width <= 0 ||
          height <= 0
        ) {
          return null;
        }

        return {
          width,
          height,
        };
      };

    const isNativeHorizontalMotionActive =
      () =>
        horizontalGestureActive ||
        horizontalScrollActive;

    const applyAdaptiveLayout = (
      preserveCenter = true
    ) => {
      layoutFrame = 0;

      if (
        zoomPhase !== "idle" ||
        isNativeHorizontalMotionActive() ||
        !bookSection ||
        !scaleShell ||
        !bookStage ||
        !bookshelf
      ) {
        pendingAdaptiveLayout =
          true;

        return;
      }

      const naturalSize =
        getNaturalSize();

      if (!naturalSize) {
        return;
      }

      pendingAdaptiveLayout =
        false;

      const unscaledCenter =
        preserveCenter
          ? getUnscaledCenter()
          : 0;

      const availableHeight =
        Math.max(
          1,
          getViewportHeight()
        );

      const nextScale =
        shouldFitLandscape()
          ? Math.min(
              1,
              availableHeight /
                naturalSize.height
            )
          : 1;

      currentScale =
        nextScale;

      bookStage.style.setProperty(
        "--book-stage-scale",
        String(nextScale)
      );

      scaleShell.style.width =
        `${naturalSize.width *
          nextScale}px`;

      scaleShell.style.height =
        `${naturalSize.height *
          nextScale}px`;

      bookSection.style.width =
        `${Math.max(
          getViewportWidth(),
          naturalSize.width *
            nextScale
        )}px`;

      bookSection.style.height =
        `${Math.max(
          getViewportHeight(),
          naturalSize.height *
            nextScale
        )}px`;

      if (
        preserveCenter &&
        initialPositionComplete
      ) {
        requestAnimationFrame(
          () => {
            if (
              zoomPhase === "idle" &&
              !isNativeHorizontalMotionActive()
            ) {
              restoreCenter(
                unscaledCenter
              );
            } else {
              pendingAdaptiveLayout =
                true;
            }
          }
        );
      }
    };

    const scheduleAdaptiveLayout =
      (
        preserveCenter = true
      ) => {
        if (
          zoomPhase !== "idle" ||
          isNativeHorizontalMotionActive()
        ) {
          pendingAdaptiveLayout =
            true;

          return;
        }

        if (layoutFrame) {
          cancelAnimationFrame(
            layoutFrame
          );
        }

        layoutFrame =
          requestAnimationFrame(
            () =>
              applyAdaptiveLayout(
                preserveCenter
              )
          );
      };

    const finishHorizontalMotion =
      () => {
        horizontalScrollTimer = 0;
        horizontalScrollActive =
          false;

        if (
          pendingAdaptiveLayout &&
          zoomPhase === "idle" &&
          !horizontalGestureActive
        ) {
          scheduleAdaptiveLayout(
            true
          );
        }
      };

    const markHorizontalScrollActivity =
      () => {
        if (
          performance.now() <
          suppressScrollActivityUntil
        ) {
          return;
        }

        horizontalScrollActive =
          true;

        window.clearTimeout(
          horizontalScrollTimer
        );

        horizontalScrollTimer =
          window.setTimeout(
            finishHorizontalMotion,
            HORIZONTAL_SCROLL_SETTLE_MS
          );
      };

    const cancelReset = () => {
      window.clearTimeout(
        resetTimer
      );

      resetTimer = 0;

      if (resetFrame) {
        cancelAnimationFrame(
          resetFrame
        );

        resetFrame = 0;
      }
    };

    const beginZoom = () => {
      cancelReset();

      horizontalGestureActive =
        false;

      horizontalScrollActive =
        false;

      window.clearTimeout(
        horizontalScrollTimer
      );

      horizontalScrollTimer = 0;

      if (
        zoomPhase === "zooming"
      ) {
        return;
      }

      setZoomPhase(
        "zooming"
      );
    };

    const performAtomicZoomReset =
      () => {
        resetTimer = 0;

        if (
          zoomPhase !== "zooming"
        ) {
          return;
        }

        if (
          getViewportScale() >
          ZOOM_EXIT_THRESHOLD
        ) {
          return;
        }

        const centerBeforeReset =
          getUnscaledCenter();

        setZoomPhase(
          "resetting"
        );

        pendingAdaptiveLayout =
          false;

        if (layoutFrame) {
          cancelAnimationFrame(
            layoutFrame
          );

          layoutFrame = 0;
        }

        resetFrame =
          requestAnimationFrame(
            () => {
              const currentLeft =
                getDocumentScrollLeft();

              setDocumentScroll(
                currentLeft,
                0
              );

              resetFrame =
                requestAnimationFrame(
                  () => {
                    zoomPhase =
                      "idle";

                    applyZoomClasses(
                      false
                    );

                    applyAdaptiveLayout(
                      false
                    );

                    resetFrame =
                      requestAnimationFrame(
                        () => {
                          restoreCenter(
                            centerBeforeReset
                          );

                          resetFrame =
                            requestAnimationFrame(
                              () => {
                                resetFrame = 0;

                                lastViewportWidth =
                                  getViewportWidth();

                                lastViewportHeight =
                                  getViewportHeight();

                                notifyZoomPhase(
                                  "idle"
                                );
                              }
                            );
                        }
                      );
                  }
                );
            }
          );
      };

    const scheduleAtomicZoomReset =
      () => {
        window.clearTimeout(
          resetTimer
        );

        resetTimer =
          window.setTimeout(
            performAtomicZoomReset,
            ZOOM_RESET_SETTLE_MS
          );
      };

    const syncZoomState =
      () => {
        const viewportScale =
          getViewportScale();

        if (
          viewportScale >
            ZOOM_ENTER_THRESHOLD &&
          (
            pinchGestureActive ||
            zoomPhase === "zooming"
          )
        ) {
          beginZoom();
          return;
        }

        if (
          zoomPhase === "zooming" &&
          viewportScale <=
            ZOOM_EXIT_THRESHOLD
        ) {
          if (
            !pinchGestureActive
          ) {
            scheduleAtomicZoomReset();
          }

          return;
        }

        if (
          zoomPhase === "zooming"
        ) {
          window.clearTimeout(
            resetTimer
          );

          resetTimer = 0;
        }
      };

    const syncViewportSize =
      () => {
        const nextWidth =
          getViewportWidth();

        const nextHeight =
          getViewportHeight();

        const widthChanged =
          Math.abs(
            nextWidth -
              lastViewportWidth
          ) >
          VIEWPORT_CHANGE_EPSILON;

        const heightChanged =
          Math.abs(
            nextHeight -
              lastViewportHeight
          ) >
          VIEWPORT_CHANGE_EPSILON;

        if (
          !widthChanged &&
          !heightChanged
        ) {
          return;
        }

        lastViewportWidth =
          nextWidth;

        lastViewportHeight =
          nextHeight;

        if (
          zoomPhase === "idle"
        ) {
          scheduleAdaptiveLayout(
            true
          );
        }
      };

    const handleTouchStart = (
      event: TouchEvent
    ) => {
      if (
        event.touches.length >= 2
      ) {
        horizontalGestureActive =
          false;

        pinchGestureActive =
          true;

        if (
          getViewportScale() >
          ZOOM_ENTER_THRESHOLD
        ) {
          beginZoom();
        }

        return;
      }

      if (
        event.touches.length === 1 &&
        zoomPhase === "idle"
      ) {
        horizontalGestureActive =
          true;

        horizontalScrollActive =
          true;

        window.clearTimeout(
          horizontalScrollTimer
        );
      }
    };

    const handleTouchMove = (
      event: TouchEvent
    ) => {
      if (
        event.touches.length >= 2
      ) {
        horizontalGestureActive =
          false;

        pinchGestureActive =
          true;

        syncZoomState();
      }
    };

    const handleTouchEnd = (
      event: TouchEvent
    ) => {
      const wasPinching =
        pinchGestureActive;

      if (
        event.touches.length < 2
      ) {
        pinchGestureActive =
          false;
      }

      if (
        event.touches.length === 0
      ) {
        horizontalGestureActive =
          false;

        window.clearTimeout(
          horizontalScrollTimer
        );

        horizontalScrollTimer =
          window.setTimeout(
            finishHorizontalMotion,
            HORIZONTAL_SCROLL_SETTLE_MS
          );
      }

      if (wasPinching) {
        syncZoomState();
      }
    };

    const handleOrientationChange =
      () => {
        pinchGestureActive =
          false;

        horizontalGestureActive =
          false;

        horizontalScrollActive =
          false;

        pendingAdaptiveLayout =
          false;

        window.clearTimeout(
          horizontalScrollTimer
        );

        horizontalScrollTimer = 0;

        cancelReset();

        window.clearTimeout(
          orientationTimer
        );

        zoomPhase =
          "idle";

        applyZoomClasses(
          false
        );

        notifyZoomPhase(
          "idle"
        );

        const currentLeft =
          getDocumentScrollLeft();

        setDocumentScroll(
          currentLeft,
          0
        );

        requestAnimationFrame(
          () => {
            lastViewportWidth =
              getViewportWidth();

            lastViewportHeight =
              getViewportHeight();

            scheduleAdaptiveLayout();
          }
        );

        orientationTimer =
          window.setTimeout(
            () => {
              orientationTimer = 0;

              lastViewportWidth =
                getViewportWidth();

              lastViewportHeight =
                getViewportHeight();

              applyAdaptiveLayout(
                true
              );
            },
            ORIENTATION_SETTLE_MS
          );
      };

    /*
     * 初期位置の確定後にのみ、
     * 本棚を描画可能な状態へする。
     */
    const revealInitialBookshelf =
      () => {
        initialPositionComplete =
          true;

        if (scaleShell) {
          scaleShell.style.visibility =
            "visible";
        }

        bookSection?.classList.remove(
          "is-initializing"
        );
      };

    /*
     * window.scrollTo()の結果が、
     * Safariの実際のスクロール座標へ
     * 反映されたことを確認する。
     */
    const confirmInitialPosition =
      (
        targetScroll: number,
        attempt = 0
      ) => {
        initialPositionFrame = 0;

        const currentScroll =
          getDocumentScrollLeft();

        const positionIsReady =
          Math.abs(
            currentScroll -
              targetScroll
          ) <=
          INITIAL_POSITION_EPSILON;

        if (
          positionIsReady ||
          attempt >=
            INITIAL_POSITION_MAX_ATTEMPTS
        ) {
          /*
           * 座標確認後、さらに次の描画フレームで
           * visibilityを解除する。
           */
          initialPositionFrame =
            requestAnimationFrame(
              () => {
                initialPositionFrame = 0;

                revealInitialBookshelf();
              }
            );

          return;
        }

        /*
         * Safariがまだ反映していない場合だけ、
         * 同じ目標位置を再指定して次フレームで確認。
         */
        setDocumentScrollLeft(
          targetScroll
        );

        initialPositionFrame =
          requestAnimationFrame(
            () =>
              confirmInitialPosition(
                targetScroll,
                attempt + 1
              )
          );
      };

    const centerRandomBook =
      () => {
        initialPositionFrame = 0;

        if (
          books.length === 0
        ) {
          revealInitialBookshelf();
          return;
        }

        const randomBook =
          books[
            Math.floor(
              Math.random() *
                books.length
            )
          ];

        const bookBox =
          randomBook.getBoundingClientRect();

        const bookCenter =
          bookBox.left +
          getDocumentScrollLeft() +
          bookBox.width / 2;

        const viewportWidth =
          getViewportWidth();

        const targetScroll =
          bookCenter -
          viewportWidth / 2;

        const maxScrollLeft =
          Math.max(
            0,
            getDocumentScrollWidth() -
              viewportWidth
          );

        const clampedTarget =
          clamp(
            targetScroll,
            0,
            maxScrollLeft
          );

        setDocumentScrollLeft(
          clampedTarget
        );

        initialPositionFrame =
          requestAnimationFrame(
            () =>
              confirmInitialPosition(
                clampedTarget
              )
          );
      };

    const scheduleInitialPosition =
      () => {
        if (
          initialPositionFrame
        ) {
          cancelAnimationFrame(
            initialPositionFrame
          );
        }

        zoomPhase =
          "idle";

        applyZoomClasses(
          false
        );

        notifyZoomPhase(
          "idle"
        );

        lastViewportWidth =
          getViewportWidth();

        lastViewportHeight =
          getViewportHeight();

        scheduleAdaptiveLayout();

        initialPositionFrame =
          requestAnimationFrame(
            () => {
              initialPositionFrame =
                requestAnimationFrame(
                  () => {
                    initialPositionFrame =
                      requestAnimationFrame(
                        centerRandomBook
                      );
                  }
                );
            }
          );
      };

    const applyWheelScroll =
      () => {
        wheelFrame = 0;

        const currentScroll =
          getDocumentScrollLeft();

        const viewportWidth =
          getViewportWidth();

        const maxScrollLeft =
          Math.max(
            0,
            getDocumentScrollWidth() -
              viewportWidth
          );

        setDocumentScrollLeft(
          clamp(
            currentScroll +
              pendingWheelDelta,
            0,
            maxScrollLeft
          )
        );

        pendingWheelDelta = 0;
      };

    const handleWheel = (
      event: WheelEvent
    ) => {
      if (event.ctrlKey) {
        return;
      }

      const horizontalDelta =
        Math.abs(
          event.deltaX
        ) >
        Math.abs(
          event.deltaY
        )
          ? event.deltaX
          : event.deltaY;

      if (
        Math.abs(
          horizontalDelta
        ) < 0.5
      ) {
        return;
      }

      event.preventDefault();

      pendingWheelDelta +=
        horizontalDelta;

      if (!wheelFrame) {
        wheelFrame =
          requestAnimationFrame(
            applyWheelScroll
          );
      }
    };

    const resizeObserver =
      typeof ResizeObserver !==
      "undefined"
        ? new ResizeObserver(
            () => {
              if (
                zoomPhase === "idle"
              ) {
                scheduleAdaptiveLayout();
              }
            }
          )
        : null;

    resizeObserver?.observe(
      bookshelf
    );

    const handleWindowResize =
      () => {
        syncZoomState();
        syncViewportSize();
      };

    const handleVisualViewportResize =
      () => {
        syncZoomState();

        if (
          zoomPhase === "idle"
        ) {
          syncViewportSize();
        }
      };

    const handleVisualViewportScroll =
      () => {
        syncZoomState();
      };

    const handleWindowScroll =
      () => {
        if (
          zoomPhase === "idle"
        ) {
          markHorizontalScrollActivity();
        }
      };

    const cleanup = () => {
      if (wheelFrame) {
        cancelAnimationFrame(
          wheelFrame
        );
      }

      if (layoutFrame) {
        cancelAnimationFrame(
          layoutFrame
        );
      }

      if (
        initialPositionFrame
      ) {
        cancelAnimationFrame(
          initialPositionFrame
        );
      }

      if (resetFrame) {
        cancelAnimationFrame(
          resetFrame
        );
      }

      window.clearTimeout(
        resetTimer
      );

      window.clearTimeout(
        orientationTimer
      );

      window.clearTimeout(
        horizontalScrollTimer
      );

      wheelFrame = 0;
      layoutFrame = 0;
      initialPositionFrame = 0;
      resetFrame = 0;

      resetTimer = 0;
      orientationTimer = 0;
      horizontalScrollTimer = 0;

      pendingWheelDelta = 0;

      pinchGestureActive =
        false;

      horizontalGestureActive =
        false;

      horizontalScrollActive =
        false;

      pendingAdaptiveLayout =
        false;

      resizeObserver?.disconnect();

      zoomPhase =
        "idle";

      applyZoomClasses(
        false
      );

      notifyZoomPhase(
        "idle"
      );

      window.removeEventListener(
        "wheel",
        handleWheel
      );

      window.removeEventListener(
        "scroll",
        handleWindowScroll
      );

      window.removeEventListener(
        "resize",
        handleWindowResize
      );

      window.removeEventListener(
        "orientationchange",
        handleOrientationChange
      );

      document.removeEventListener(
        "touchstart",
        handleTouchStart
      );

      document.removeEventListener(
        "touchmove",
        handleTouchMove
      );

      document.removeEventListener(
        "touchend",
        handleTouchEnd
      );

      document.removeEventListener(
        "touchcancel",
        handleTouchEnd
      );

      visualViewport?.removeEventListener(
        "resize",
        handleVisualViewportResize
      );

      visualViewport?.removeEventListener(
        "scroll",
        handleVisualViewportScroll
      );

      document.removeEventListener(
        "astro:before-swap",
        cleanup
      );
    };

    scheduleInitialPosition();

    window.addEventListener(
      "wheel",
      handleWheel,
      {
        passive: false,
      }
    );

    window.addEventListener(
      "scroll",
      handleWindowScroll,
      {
        passive: true,
      }
    );

    window.addEventListener(
      "resize",
