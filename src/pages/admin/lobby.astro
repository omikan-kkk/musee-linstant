---
import Layout from "../../layouts/Layout.astro";
import { CONTENTS } from "../../data/contents";

const LOBBY_CONTENT_ID = "__lobby__";

const lobbyContent = CONTENTS.find(
  (content) => content.id === LOBBY_CONTENT_ID
);

const currentLobbyImage = lobbyContent?.image || "";
const currentDesktopHeightPx =
  lobbyContent?.desktopHeightPx ?? 620;
const currentDesktopHeightVh =
  lobbyContent?.desktopHeightVh ?? 60;
---

<Layout title="Lobby | Musée de l'Instant CMS" showHeader={false}>
  <main class="admin">
    <header>
      <a href="/admin">← CMS</a>
      <h1>Lobby</h1>
    </header>

    <section
      class="editor"
      data-current-image={currentLobbyImage}
      data-current-desktop-height-px={currentDesktopHeightPx}
      data-current-desktop-height-vh={currentDesktopHeightVh}
    >
      <div class="field">
        <label for="image">Lobby Image</label>

        <div
          id="empty-preview"
          class:list={[
            "empty-preview",
            currentLobbyImage && "is-hidden",
          ]}
        >
          No image
        </div>

        <img
          id="image-preview"
          class:list={[
            "image-preview",
            !currentLobbyImage && "is-hidden",
          ]}
          src={currentLobbyImage || undefined}
          alt=""
        />

        <input
          id="image"
          type="file"
          accept="image/*"
        />

        <p class="note">
          One image only. Saving a new image replaces the current image.
        </p>
      </div>

      <div class="settings">
        <div class="number-field">
          <label for="desktop-height-px">
            Desktop Height
          </label>

          <div class="number-input">
            <input
              id="desktop-height-px"
              type="number"
              min="1"
              step="1"
              value={currentDesktopHeightPx}
              inputmode="numeric"
            />

            <span>px</span>
          </div>

          <p class="note">
            Maximum image height on desktop.
          </p>
        </div>

        <div class="number-field">
          <label for="desktop-height-vh">
            Desktop Height
          </label>

          <div class="number-input">
            <input
              id="desktop-height-vh"
              type="number"
              min="1"
              max="100"
              step="1"
              value={currentDesktopHeightVh}
              inputmode="numeric"
            />

            <span>vh</span>
          </div>

          <p class="note">
            Height relative to the browser window.
          </p>
        </div>
      </div>

      <div class="actions">
        <button
          type="button"
          id="save-button"
          class="save-button"
        >
          Save
        </button>

        <button
          type="button"
          id="remove-button"
          class="remove-button"
          disabled={!currentLobbyImage}
        >
          Remove Image
        </button>

        <p id="save-status" aria-live="polite"></p>
      </div>
    </section>
  </main>

  <script type="module">
    import {
      requireLogin,
      authFetch,
    } from "../../lib/auth";

    requireLogin();

    const LOBBY_CONTENT_ID = "__lobby__";
    const LOBBY_CATEGORY_ID = "__site__";

    const editor = document.querySelector(".editor");
    const imageInput = document.querySelector("#image");
    const imagePreview = document.querySelector("#image-preview");
    const emptyPreview = document.querySelector("#empty-preview");
    const desktopHeightPxInput = document.querySelector(
      "#desktop-height-px"
    );
    const desktopHeightVhInput = document.querySelector(
      "#desktop-height-vh"
    );
    const saveButton = document.querySelector("#save-button");
    const removeButton = document.querySelector("#remove-button");
    const saveStatus = document.querySelector("#save-status");

    let selectedImageFile = null;
    let previewObjectUrl = "";

    let savedImagePath =
      editor?.getAttribute("data-current-image") || "";

    let savedDesktopHeightPx = Number(
      editor?.getAttribute(
        "data-current-desktop-height-px"
      ) || 620
    );

    let savedDesktopHeightVh = Number(
      editor?.getAttribute(
        "data-current-desktop-height-vh"
      ) || 60
    );

    async function readJson(response) {
      const data = await response.json().catch(() => null);

      if (!response.ok) {
        throw new Error(
          data?.message ||
            data?.error ||
            "Request failed."
        );
      }

      return data;
    }

    async function loadContents() {
      const response = await authFetch("/contents");
      const data = await readJson(response);

      if (!data?.ok || !Array.isArray(data.contents)) {
        throw new Error("Could not load contents.");
      }

      return data.contents;
    }

    async function saveContents(contents) {
      const response = await authFetch("/contents", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          contents,
        }),
      });

      const data = await readJson(response);

      if (!data?.ok) {
        throw new Error("Could not save contents.");
      }
    }

    async function uploadImage(file) {
      const formData = new FormData();

      formData.append("file", file);
      formData.append(
        "contentId",
        LOBBY_CONTENT_ID
      );

      const response = await authFetch("/upload-image", {
        method: "POST",
        body: formData,
      });

      const data = await readJson(response);

      if (!data?.ok || !data.image) {
        throw new Error("Could not upload image.");
      }

      return data.image;
    }

    function showImage(src, alt = "") {
      if (!imagePreview || !emptyPreview) {
        return;
      }

      imagePreview.src = src;
      imagePreview.alt = alt;
      imagePreview.classList.remove("is-hidden");
      emptyPreview.classList.add("is-hidden");
    }

    function showEmpty() {
      if (!imagePreview || !emptyPreview) {
        return;
      }

      imagePreview.removeAttribute("src");
      imagePreview.alt = "";
      imagePreview.classList.add("is-hidden");
      emptyPreview.classList.remove("is-hidden");
    }

    function resetSelectedFile() {
      selectedImageFile = null;

      if (imageInput) {
        imageInput.value = "";
      }

      if (previewObjectUrl) {
        URL.revokeObjectURL(previewObjectUrl);
        previewObjectUrl = "";
      }
    }

    function getPositiveNumber(input, label) {
      const value = Number(input?.value);

      if (!Number.isFinite(value) || value <= 0) {
        throw new Error(
          `${label} must be greater than 0.`
        );
      }

      return value;
    }

    function getHeightSettings() {
      const desktopHeightPx = Math.round(
        getPositiveNumber(
          desktopHeightPxInput,
          "Desktop Height (px)"
        )
      );

      const desktopHeightVh = getPositiveNumber(
        desktopHeightVhInput,
        "Desktop Height (vh)"
      );

      if (desktopHeightVh > 100) {
        throw new Error(
          "Desktop Height (vh) must be 100 or less."
        );
      }

      return {
        desktopHeightPx,
        desktopHeightVh,
      };
    }

    function createLobbyContent({
      currentContent,
      image,
      desktopHeightPx,
      desktopHeightVh,
    }) {
      return {
        ...currentContent,
        id: LOBBY_CONTENT_ID,
        category: LOBBY_CATEGORY_ID,
        title: "Lobby",
        image,
        desktopHeightPx,
        desktopHeightVh,
      };
    }

    imageInput?.addEventListener("change", () => {
      const file = imageInput.files?.[0];

      if (!file) {
        resetSelectedFile();

        if (savedImagePath) {
          showImage(savedImagePath);
        } else {
          showEmpty();
        }

        return;
      }

      selectedImageFile = file;

      if (previewObjectUrl) {
        URL.revokeObjectURL(previewObjectUrl);
      }

      previewObjectUrl = URL.createObjectURL(file);

      showImage(previewObjectUrl, file.name);

      if (saveStatus) {
        saveStatus.textContent =
          "New image selected. Press Save.";
      }
    });

    saveButton?.addEventListener("click", async () => {
      if (!saveButton || !saveStatus) {
        return;
      }

      saveButton.disabled = true;

      if (removeButton) {
        removeButton.disabled = true;
      }

      saveStatus.textContent = "Saving...";

      try {
        const {
          desktopHeightPx,
          desktopHeightVh,
        } = getHeightSettings();

        const contents = await loadContents();

        let nextImagePath = savedImagePath;

        if (selectedImageFile) {
          nextImagePath = await uploadImage(
            selectedImageFile
          );
        }

        const lobbyContentIndex =
          contents.findIndex(
            (content) =>
              content.id === LOBBY_CONTENT_ID
          );

        const currentContent =
          lobbyContentIndex >= 0
            ? contents[lobbyContentIndex]
            : {};

        const nextLobbyContent =
          createLobbyContent({
            currentContent,
            image: nextImagePath,
            desktopHeightPx,
            desktopHeightVh,
          });

        if (lobbyContentIndex >= 0) {
          contents[lobbyContentIndex] =
            nextLobbyContent;
        } else {
          contents.push(nextLobbyContent);
        }

        await saveContents(contents);

        savedImagePath = nextImagePath;
        savedDesktopHeightPx = desktopHeightPx;
        savedDesktopHeightVh = desktopHeightVh;

        resetSelectedFile();

        if (desktopHeightPxInput) {
          desktopHeightPxInput.value = String(
            savedDesktopHeightPx
          );
        }

        if (desktopHeightVhInput) {
          desktopHeightVhInput.value = String(
            savedDesktopHeightVh
          );
        }

        if (savedImagePath) {
          showImage(savedImagePath);
        } else {
          showEmpty();
        }

        if (removeButton) {
          removeButton.disabled =
            !savedImagePath;
        }

        saveStatus.textContent =
          "Saved successfully.";
      } catch (error) {
        console.error(error);

        saveStatus.textContent =
          error instanceof Error
            ? error.message
            : "Could not save.";

        if (removeButton) {
          removeButton.disabled =
            !savedImagePath;
        }
      } finally {
        saveButton.disabled = false;
      }
    });

    removeButton?.addEventListener(
      "click",
      async () => {
        if (
          !removeButton ||
          !saveButton ||
          !saveStatus
        ) {
          return;
        }

        const shouldRemove = window.confirm(
          "Remove the current lobby image?"
        );

        if (!shouldRemove) {
          return;
        }

        removeButton.disabled = true;
        saveButton.disabled = true;

        saveStatus.textContent =
          "Removing image...";

        try {
          const {
            desktopHeightPx,
            desktopHeightVh,
          } = getHeightSettings();

          const contents = await loadContents();

          const lobbyContentIndex =
            contents.findIndex(
              (content) =>
                content.id ===
                LOBBY_CONTENT_ID
            );

          const currentContent =
            lobbyContentIndex >= 0
              ? contents[lobbyContentIndex]
              : {};

          const nextLobbyContent =
            createLobbyContent({
              currentContent,
              image: "",
              desktopHeightPx,
              desktopHeightVh,
            });

          if (lobbyContentIndex >= 0) {
            contents[lobbyContentIndex] =
              nextLobbyContent;
          } else {
            contents.push(nextLobbyContent);
          }

          await saveContents(contents);

          savedImagePath = "";
          savedDesktopHeightPx = desktopHeightPx;
          savedDesktopHeightVh = desktopHeightVh;

          resetSelectedFile();
          showEmpty();

          saveStatus.textContent =
            "Image removed.";
        } catch (error) {
          console.error(error);

          saveStatus.textContent =
            error instanceof Error
              ? error.message
              : "Could not remove image.";

          removeButton.disabled =
            !savedImagePath;
        } finally {
          saveButton.disabled = false;
        }
      }
    );

    window.addEventListener(
      "beforeunload",
      () => {
        if (previewObjectUrl) {
          URL.revokeObjectURL(
            previewObjectUrl
          );
        }
      }
    );
  </script>
</Layout>

<style>
  :global(html) {
    background: #f5f5f2;
  }

  :global(body) {
    margin: 0;
    background: #f5f5f2;
    color: #111;
    font-family:
      Arial,
      Helvetica,
      sans-serif;
  }

  .admin {
    box-sizing: border-box;
    width: min(100%, 960px);
    min-height: 100vh;
    margin: 0 auto;
    padding:
      48px
      32px
      80px;
  }

  header {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 40px;
  }

  header a {
    color: #555;
    font-size: 14px;
    text-decoration: none;
  }

  header a:hover {
    color: #111;
  }

  h1 {
    margin: 0;
    font-family:
      Georgia,
      "Times New Roman",
      serif;
    font-size:
      clamp(
        32px,
        5vw,
        52px
      );
    font-weight: 400;
    letter-spacing: -0.03em;
  }

  .editor {
    display: grid;
    gap: 32px;
    padding: 32px;
    background: #fff;
    border: 1px solid #ddd;
  }

  .field,
  .number-field {
    display: grid;
    gap: 16px;
  }

  label {
    font-size: 14px;
    font-weight: 700;
  }

  .image-preview,
  .empty-preview {
    box-sizing: border-box;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    border: 1px solid #ddd;
    background: #f8f8f6;
  }

  .image-preview {
    object-fit: contain;
  }

  .empty-preview {
    display: grid;
    place-items: center;
    color: #999;
    font-size: 14px;
  }

  .is-hidden {
    display: none;
  }

  input[type="file"],
  input[type="number"] {
    box-sizing: border-box;
    width: 100%;
    border: 1px solid #ccc;
    background: #fff;
    font: inherit;
    font-size: 14px;
  }

  input[type="file"] {
    padding: 12px;
  }

  input[type="number"] {
    min-width: 0;
    padding: 12px;
    border: 0;
    outline: none;
  }

  input[type="file"]::file-selector-button {
    margin-right: 16px;
    padding: 8px 14px;
    border: 1px solid #bbb;
    background: #f3f3f1;
    cursor: pointer;
  }

  .settings {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: 20px;
    padding-top: 8px;
    border-top: 1px solid #eee;
  }

  .number-input {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    border: 1px solid #ccc;
    background: #fff;
  }

  .number-input:focus-within {
    border-color: #111;
  }

  .number-input span {
    padding: 0 14px;
    color: #666;
    font-size: 13px;
  }

  .note {
    margin: 0;
    color: #777;
    font-size: 13px;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-top: 8px;
    border-top: 1px solid #eee;
  }

  button {
    min-width: 120px;
    padding: 12px 20px;
    border: 1px solid #111;
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }

  button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .save-button {
    background: #111;
    color: #fff;
  }

  .remove-button {
    background: #fff;
    color: #111;
  }

  #save-status {
    flex-basis: 100%;
    min-height: 1.4em;
    margin: 4px 0 0;
    color: #555;
    font-size: 13px;
  }

  @media (max-width: 640px) {
    .admin {
      padding:
        28px
        16px
        56px;
    }

    header {
      align-items: flex-start;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 28px;
    }

    .editor {
      gap: 24px;
      padding: 20px;
    }

    .settings {
      grid-template-columns: 1fr;
    }

    .actions {
      align-items: stretch;
      flex-direction: column;
    }

    button {
      width: 100%;
    }
  }
</style>