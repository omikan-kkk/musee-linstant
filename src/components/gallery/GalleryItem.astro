---
import { THEME } from "../../config/theme";


const {
  image = "",
  title = "",
  body = "",
  href = "",
} = Astro.props;


const hasImage = image !== "";
const hasTitle = title !== "";
const hasBody = body !== "";
---


{href ? (
  <a class="gallery-item" href={href}>
    <div
      class="artwork-frame"
      style={`--artwork-ratio:${THEME.gallery.artworkAspectRatio};`}
    >
      {hasImage && (
        <img
          src={image}
          alt={title}
          loading="lazy"
          data-gallery-image
          style={`max-width:${THEME.gallery.artworkMaxSize};max-height:${THEME.gallery.artworkMaxSize};`}
        />
      )}
    </div>


    {(hasTitle || hasBody) && (
      <div
        class="gallery-caption"
        style={`margin-top:${THEME.gallery.captionMarginTop};`}
      >
        {hasTitle && (
          <p class="gallery-title">
            {title}
          </p>
        )}


        {hasBody && (
          <p class="gallery-body">
            {body}
          </p>
        )}
      </div>
    )}
  </a>
) : (
  <article class="gallery-item">
    <div
      class="artwork-frame"
      style={`--artwork-ratio:${THEME.gallery.artworkAspectRatio};`}
    >
      {hasImage && (
        <img
          src={image}
          alt={title}
          loading="lazy"
          data-gallery-image
          style={`max-width:${THEME.gallery.artworkMaxSize};max-height:${THEME.gallery.artworkMaxSize};`}
        />
      )}
    </div>


    {(hasTitle || hasBody) && (
      <div
        class="gallery-caption"
        style={`margin-top:${THEME.gallery.captionMarginTop};`}
      >
        {hasTitle && (
          <p class="gallery-title">
            {title}
          </p>
        )}


        {hasBody && (
          <p class="gallery-body">
            {body}
          </p>
        )}
      </div>
    )}
  </article>
)}


<script>
  const galleryImages = [
    ...document.querySelectorAll<HTMLImageElement>(
      "[data-gallery-image]"
    ),
  ];


  /*
   * 画像データそのもののロードが完了したら、
   * 画像自身だけをlinearでフェードインする。
   *
   * img要素そのものへopacityを掛けるため、
   * アスペクト比・解像度・表示サイズに関係なく
   * 実画像の位置へ完全に一致する。
   */
  const revealGalleryImage =
    (
      image: HTMLImageElement
    ) => {
      if (
        image.classList.contains(
          "is-gallery-image-loaded"
        )
      ) {
        return;
      }


      image.classList.add(
        "is-gallery-image-loaded"
      );
    };


  galleryImages.forEach(
    (image) => {
      if (image.complete) {
        /*
         * キャッシュ済み画像でも
         * opacity:0の初期状態を
         * 一度描画してからフェードさせる。
         */
        requestAnimationFrame(
          () => {
            requestAnimationFrame(
              () => {
                revealGalleryImage(
                  image
                );
              }
            );
          }
        );

        return;
      }


      image.addEventListener(
        "load",
        () => {
          revealGalleryImage(
            image
          );
        },
        {
          once: true,
        }
      );
    }
  );
</script>


<style>
.gallery-item{
  display:block;
  color:inherit;
  text-decoration:none;
}


.artwork-frame{
  position:relative;
  width:100%;
  height:auto;
  overflow:hidden;
}


.artwork-frame::before{
  content:"";
  display:block;
  width:100%;
  aspect-ratio:var(--artwork-ratio);
}


.artwork-frame img{
  position:absolute;
  top:50%;
  left:50%;

  transform:
    translate(
      -50%,
      -50%
    );

  display:block;

  width:auto;
  height:auto;

  object-fit:contain;

  /*
   * Gallery画像自身だけのフェード。
   *
   * 時間はLayout.astroの
   * --page-enter-durationを共有する。
   */
  opacity:0;

  transition:
    opacity
    var(
      --page-enter-duration
    )
    linear;
}


.artwork-frame img.is-gallery-image-loaded{
  opacity:1;
}


.gallery-caption{
  text-align:right;
}


.gallery-title,
.gallery-body{
  margin:0;
  font-family:var(--site-font-family);
  letter-spacing:.08em;
  line-height:1.8;
  white-space:pre-line;
}


.gallery-title{
  color:var(--gallery-list-title-color);
  font-size:var(--gallery-list-title-size);
}


.gallery-body{
  margin-top:4px;
  color:var(--gallery-list-caption-color);
  font-size:var(--gallery-list-caption-size);
}
</style>