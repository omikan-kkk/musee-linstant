---
const {
  items = [],
} = Astro.props;

const grouped = Object.values(
  items.reduce(
    (groups, item) => {
      const author =
        item.author ||
        "Unknown";

      const authorSort =
        item.authorSort ||
        author;

      if (!groups[author]) {
        groups[author] = {
          author,
          authorSort,
          authorFontSizeOverride:
            item.authorFontSizeOverride ||
            false,
          authorFontSize:
            item.authorFontSize ||
            null,
          books: [],
        };
      }

      groups[author].books.push(
        item
      );

      return groups;
    },
    {}
  )
);

grouped.sort(
  (a, b) =>
    a.authorSort.localeCompare(
      b.authorSort,
      "ja"
    )
);

grouped.forEach((group) => {
  group.books.sort(
    (a, b) =>
      (
        a.titleSort ||
        a.title
      ).localeCompare(
        b.titleSort ||
          b.title,
        "ja"
      )
  );
});
---

<section
  class="book-section"
  data-book-section
>
  <div class="bookshelf">
    {
      grouped.map(
        (group) => (
          <div class="author-group">
            <div class="author-column">
              <p
                class="author"
                style={
                  group.authorFontSizeOverride &&
                  group.authorFontSize
                    ? `font-size:${group.authorFontSize}px;`
                    : undefined
                }
              >
                {group.author}
              </p>
            </div>

            <div class="book-list">
              {
                group.books.map(
                  (book) => (
                    <div class="book-column">
                      <p
                        class="book"
                        data-book-item
                        style={
                          book.titleFontSizeOverride &&
                          book.titleFontSize
                            ? `font-size:${book.titleFontSize}px;`
                            : undefined
                        }
                      >
                        {book.title}
                      </p>
                    </div>
                  )
                )
              }
            </div>
          </div>
        )
      )
    }
  </div>

  <script>
    const books = [
      ...document.querySelectorAll<HTMLElement>(
        "[data-book-item]"
      ),
    ];

    let wheelFrame = 0;
    let pendingWheelDelta = 0;
    let initialPositionFrame = 0;

    const getDocumentScrollLeft =
      () =>
        window.scrollX ||
        document.documentElement
          .scrollLeft ||
        document.body.scrollLeft ||
        0;

    const getDocumentScrollWidth =
      () =>
        Math.max(
          document.documentElement
            .scrollWidth,
          document.body.scrollWidth
        );

    const setDocumentScrollLeft = (
      value: number
    ) => {
      window.scrollTo({
        left: value,
        top: 0,
        behavior: "auto",
      });
    };

    /*
     * 初期表示時に、
     * ランダムな本を画面中央付近へ置く。
     */
    const centerRandomBook = () => {
      initialPositionFrame = 0;

      if (
        books.length === 0
      ) {
        return;
      }

      const randomBook =
        books[
          Math.floor(
            Math.random() *
              books.length
          )
        ];

      const bookBox =
        randomBook.getBoundingClientRect();

      const bookCenter =
        bookBox.left +
        getDocumentScrollLeft() +
        bookBox.width / 2;

      const targetScroll =
        bookCenter -
        window.innerWidth / 2;

      const maxScrollLeft =
        Math.max(
          0,
          getDocumentScrollWidth() -
            window.innerWidth
        );

      setDocumentScrollLeft(
        Math.min(
          maxScrollLeft,
          Math.max(
            0,
            targetScroll
          )
        )
      );
    };

    const scheduleInitialPosition =
      () => {
        if (
          initialPositionFrame
        ) {
          cancelAnimationFrame(
            initialPositionFrame
          );
        }

        initialPositionFrame =
          requestAnimationFrame(
            () => {
              initialPositionFrame =
                requestAnimationFrame(
                  centerRandomBook
                );
            }
          );
      };

    /*
     * PCの縦ホイール入力を、
     * 文書自体の横スクロールへ変換する。
     */
    const applyWheelScroll =
      () => {
        wheelFrame = 0;

        const currentScroll =
          getDocumentScrollLeft();

        const maxScrollLeft =
          Math.max(
            0,
            getDocumentScrollWidth() -
              window.innerWidth
          );

        setDocumentScrollLeft(
          Math.min(
            maxScrollLeft,
            Math.max(
              0,
              currentScroll +
                pendingWheelDelta
            )
          )
        );

        pendingWheelDelta = 0;
      };

    const handleWheel = (
      event: WheelEvent
    ) => {
      if (event.ctrlKey) {
        return;
      }

      const horizontalDelta =
        Math.abs(
          event.deltaX
        ) >
        Math.abs(
          event.deltaY
        )
          ? event.deltaX
          : event.deltaY;

      if (
        Math.abs(
          horizontalDelta
        ) < 0.5
      ) {
        return;
      }

      event.preventDefault();

      pendingWheelDelta +=
        horizontalDelta;

      if (!wheelFrame) {
        wheelFrame =
          requestAnimationFrame(
            applyWheelScroll
          );
      }
    };

    const cleanup = () => {
      if (wheelFrame) {
        cancelAnimationFrame(
          wheelFrame
        );
      }

      if (
        initialPositionFrame
      ) {
        cancelAnimationFrame(
          initialPositionFrame
        );
      }

      wheelFrame = 0;
      initialPositionFrame = 0;
      pendingWheelDelta = 0;

      window.removeEventListener(
        "wheel",
        handleWheel
      );

      window.removeEventListener(
        "resize",
        scheduleInitialPosition
      );

      window.removeEventListener(
        "orientationchange",
        scheduleInitialPosition
      );

      document.removeEventListener(
        "astro:before-swap",
        cleanup
      );
    };

    scheduleInitialPosition();

    window.addEventListener(
      "wheel",
      handleWheel,
      {
        passive: false,
      }
    );

    window.addEventListener(
      "resize",
      scheduleInitialPosition
    );

    window.addEventListener(
      "orientationchange",
      scheduleInitialPosition
    );

    document.addEventListener(
      "astro:before-swap",
      cleanup
    );
  </script>
</section>

<style>
  .book-section {
    --author-height:
      115px;

    --author-gap:
      10px;

    --book-column-width:
      calc(
        var(
            --book-list-size,
            13px
          ) *
          1.8
      );

    width: max-content;
    min-width: 100vw;

    height: 100dvh;
    min-height: 100dvh;

    background: #fff;

    color:
      var(
        --book-list-color,
        #111
      );

    font-family:
      var(
        --site-font-family
      );
  }

  .bookshelf {
    display: flex;
    flex-direction:
      row-reverse;
    align-items:
      flex-start;

    gap: 72px;

    width: max-content;
    min-width: 100vw;
    min-height: 100dvh;

    padding:
      155px
      50vw;
  }

  .author-group {
    display: flex;
    flex-direction:
      column;
    align-items:
      flex-end;

    flex:
      0
      0
      auto;
  }

  .author-column,
  .book-column {
    display: flex;
    align-items:
      flex-start;
    justify-content:
      center;

    width:
      var(
        --book-column-width
      );

    flex:
      0
      0
      auto;
  }

  .author,
  .book {
    margin: 0;

    writing-mode:
      vertical-rl;

    text-orientation:
      mixed;

    font-family:
      var(
        --site-font-family
      );

    font-size:
      var(
        --book-list-size,
        13px
      );

    color:
      var(
        --book-list-color,
        #111
      );

    line-height: 1.8;
    letter-spacing:
      0.08em;
  }

  .author-column {
    height:
      var(
        --author-height
      );

    margin:
      0
      0
      var(
        --author-gap
      )
      0;
  }

  .author {
    white-space:
      nowrap;
  }

  .book-list {
    display: flex;
    flex-direction:
      row-reverse;
    align-items:
      flex-start;

    gap: 45px;
  }

  .book {
    white-space:
      nowrap;
  }
</style>