---
import Layout from "../layouts/Layout.astro";
import EntranceExperience from "../components/home/EntranceExperience.astro";
---

<Layout showEdgeFade={false}>
  <EntranceExperience />

  <main class="home-main">
    <section class="home-placeholder" aria-hidden="true"></section>
  </main>
</Layout>

<style>
  .home-main {
    position: relative;
    width: 100%;
    min-height: 100svh;
    background: transparent;
  }

  .home-placeholder {
    width: 100%;
    min-height: 100svh;
  }
</style>