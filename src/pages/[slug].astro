---
import Layout from "../layouts/Layout.astro";
import GalleryCategory from "../components/category/GalleryCategory.astro";
import BookCategory from "../components/category/BookCategory.astro";
import CoffeeCategory from "../components/category/CoffeeCategory.astro";
import { CATEGORIES } from "../config/site";
import { CONTENTS } from "../data/contents";

export function getStaticPaths() {
  return CATEGORIES
    .filter(
      (category) =>
        category.visible
    )
    .map((category) => ({
      params: {
        slug: category.slug,
      },
      props: {
        category,
      },
    }));
}

const {
  category,
} = Astro.props;

const items = CONTENTS
  .filter(
    (item) =>
      item.categoryId ===
      category.id
  )
  .filter(
    (item) =>
      item.visible
  )
  .sort(
    (a, b) =>
      a.order - b.order
  );

const categoryType =
  category.type || "gallery";

const isBookCategory =
  categoryType === "book";
---

<Layout
  title={`${category.title} | Musée de l'Instant`}
  showHeader={true}
  showEdgeFade={true}
  edgeFadeHorizontal={false}
  lockVerticalScroll={
    isBookCategory
  }
  documentHorizontalScroll={
    isBookCategory
  }
>
  {
    categoryType ===
      "gallery" && (
      <GalleryCategory
        category={category}
        items={items}
      />
    )
  }

  {
    categoryType ===
      "book" && (
      <BookCategory
        items={items}
      />
    )
  }

  {
    categoryType ===
      "coffee" && (
      <CoffeeCategory
        items={items}
      />
    )
  }

  {
    categoryType ===
      "music" && (
      <GalleryCategory
        category={category}
        items={items}
      />
    )
  }
</Layout>