---
import { CONTENTS } from "../../data/contents";

const lobbyContent = CONTENTS.find(
  (content) => content.id === "__lobby__"
);

const lobbyImage =
  lobbyContent?.image || "";

const desktopHeightPx =
  lobbyContent?.desktopHeightPx ?? 620;

const desktopHeightVh =
  lobbyContent?.desktopHeightVh ?? 60;

const entranceStyle = [
  `--desktop-height-px: ${desktopHeightPx}px`,
  `--desktop-height-vh: ${desktopHeightVh}vh`,
].join(";");
---

<div
  class="entrance-experience"
  data-entrance-experience
  style={entranceStyle}
>
  <div
    class="entrance-experience__lobby"
    data-lobby
    aria-hidden="true"
  >
    {
      lobbyImage && (
        <img
          class="entrance-experience__lobby-image"
          src={lobbyImage}
          alt=""
          loading="eager"
          decoding="async"
        />
      )
    }
  </div>

  <div
    class="entrance-experience__veil"
    aria-hidden="true"
  ></div>

  <svg
    class="entrance-experience__logo"
    viewBox="0 0 1000 120"
    role="img"
    aria-label="Musée de l'Instant"
  >
    <text
      class="entrance-experience__logo-text"
      x="500"
      y="66"
      text-anchor="middle"
      dominant-baseline="middle"
    >
      Musée de l'Instant
    </text>
  </svg>
</div>

<script>
  const root =
    document.querySelector<HTMLElement>(
      "[data-entrance-experience]"
    );

  if (
    root &&
    root.dataset.initialized !== "true"
  ) {
    root.dataset.initialized = "true";

    const lobby =
      root.querySelector<HTMLElement>(
        "[data-lobby]"
      );

    /*
     * progress:
     *
     * 0 = 入口
     * 1 = ロビー最奥
     */
    const FORWARD_THRESHOLD = 0.42;
    const BACKWARD_THRESHOLD = 0.58;

    /*
     * 操作感度。
     *
     * 数値が大きいほど、
     * 同じ進行量に必要な操作距離が長くなる。
     */
    const TOUCH_DISTANCE = 345;
    const WHEEL_DISTANCE = 300;

    /*
     * 閾値を超えたあとの自動遷移時間。
     */
    const FORWARD_SNAP_DURATION = 620;
    const BACKWARD_SNAP_DURATION = 560;

    /*
     * 入館画像演出。
     *
     * opacity:
     * 0 → 1
     *
     * scale:
     * 0.95 → 1
     *
     * 500ms
     */
    const LOBBY_ENTER_DURATION = 500;

    /*
     * 退館画像演出。
     *
     * opacity:
     * 1 → 0
     *
     * scale:
     * 1 → 0.75
     *
     * 200ms linear
     */
    const LOBBY_EXIT_DURATION = 200;

    let progress = 0;
    let wheelTarget = 0;

    let touchStartY = 0;
    let touchStartProgress = 0;
    let touchLastY = 0;
    let touchDirection = 0;

    let renderFrame = 0;
    let snapFrame = 0;
    let wheelEndTimer = 0;

    let isTouching = false;
    let isSnapping = false;
    let isLobbyVisible = false;

    let snapTarget: 0 | 1 | null = null;

    const clamp = (
      value: number,
      min = 0,
      max = 1
    ) =>
      Math.min(
        max,
        Math.max(min, value)
      );

    const easeOutQuint = (
      value: number
    ) =>
      1 - Math.pow(1 - value, 5);

    const easeInOutCubic = (
      value: number
    ) =>
      value < 0.5
        ? 4 * value * value * value
        : 1 -
          Math.pow(
            -2 * value + 2,
            3
          ) /
            2;

    const dispatchState = (
      complete: boolean
    ) => {
      window.dispatchEvent(
        new CustomEvent(
          "entrance-state-change",
          {
            detail: {
              complete,
              progress,
            },
          }
        )
      );
    };

    /*
     * 強制的にリフローさせ、
     * JavaScriptで設定した開始状態を
     * ブラウザへ確定させる。
     */
    const forceReflow = () => {
      lobby?.getBoundingClientRect();
    };

    /*
     * 入館完了後の画像表示。
     *
     * 透明な状態で95%へ瞬時に準備し、
     * そこから500msで
     * opacity 0 → 1
     * scale 0.95 → 1
     * へ遷移する。
     */
    const showLobbyAndHeader = () => {
      if (!lobby) {
        document.body.classList.add(
          "entrance-is-complete"
        );

        dispatchState(true);
        return;
      }

      isLobbyVisible = true;

      lobby.style.transition = "none";
      lobby.style.opacity = "0";
      lobby.style.transform =
        "scale(0.95)";

      forceReflow();

      lobby.style.transition = [
        `opacity ${LOBBY_ENTER_DURATION}ms cubic-bezier(0.22, 1, 0.36, 1)`,
        `transform ${LOBBY_ENTER_DURATION}ms cubic-bezier(0.22, 1, 0.36, 1)`,
      ].join(", ");

      lobby.style.opacity = "1";
      lobby.style.transform =
        "scale(1)";

      document.body.classList.add(
        "entrance-is-complete"
      );

      dispatchState(true);
    };

    /*
     * 退館開始直後の画像消失。
     *
     * 画像だけは退館遷移から独立し、
     * 固定200msで消失・縮小する。
     *
     * 入口ロゴへ戻る挙動自体は、
     * progressとユーザー操作へ追従する。
     */
    const hideLobbyAndHeader = () => {
      document.body.classList.remove(
        "entrance-is-complete"
      );

      if (
        !lobby ||
        !isLobbyVisible
      ) {
        dispatchState(false);
        return;
      }

      isLobbyVisible = false;

      lobby.style.transition = [
        `opacity ${LOBBY_EXIT_DURATION}ms linear`,
        `transform ${LOBBY_EXIT_DURATION}ms linear`,
      ].join(", ");

      lobby.style.opacity = "0";
      lobby.style.transform =
        "scale(0.75)";

      dispatchState(false);
    };

    const render = () => {
      /*
       * 入口ロゴは、
       * 奥へ進むほど加速しながら拡大する。
       */
      const forwardCurve =
        progress * progress;

      const logoScale =
        1 + forwardCurve * 13;

      const logoOpacity = clamp(
        1 -
          (progress - 0.48) /
            0.3
      );

      /*
       * ロゴを通過する瞬間だけ、
       * ごく薄い白を挟む。
       */
      const veilOpacity =
        progress < 0.58
          ? clamp(
              progress / 0.58
            )
          : clamp(
              1 -
                (progress - 0.58) /
                  0.42
            );

      root.style.setProperty(
        "--logo-scale",
        String(logoScale)
      );

      root.style.setProperty(
        "--logo-opacity",
        String(logoOpacity)
      );

      root.style.setProperty(
        "--veil-opacity",
        String(veilOpacity)
      );

      dispatchState(
        progress >= 1
      );
    };

    const cancelRenderFrame = () => {
      if (renderFrame) {
        cancelAnimationFrame(
          renderFrame
        );
      }

      renderFrame = 0;
    };

    const cancelSnap = () => {
      if (snapFrame) {
        cancelAnimationFrame(
          snapFrame
        );
      }

      snapFrame = 0;
      isSnapping = false;
      snapTarget = null;
    };

    const completeSnap = (
      target: 0 | 1
    ) => {
      progress = target;
      wheelTarget = target;

      isSnapping = false;
      snapTarget = null;
      snapFrame = 0;

      render();

      if (target === 1) {
        /*
         * ロビー最奥へ完全到達してから、
         * 画像の出現・拡大を開始する。
         */
        showLobbyAndHeader();
      } else {
        hideLobbyAndHeader();
      }
    };

    const snapTo = (
      target: 0 | 1
    ) => {
      if (
        isSnapping &&
        snapTarget === target
      ) {
        return;
      }

      cancelRenderFrame();
      cancelSnap();

      /*
       * 退館時は、
       * 退館遷移の開始と同時に
       * 画像の固定200ms演出を開始する。
       */
      if (target === 0) {
        hideLobbyAndHeader();
      }

      isSnapping = true;
      snapTarget = target;

      const startProgress =
        progress;

      const distance =
        target - startProgress;

      const baseDuration =
        target === 1
          ? FORWARD_SNAP_DURATION
          : BACKWARD_SNAP_DURATION;

      const duration = Math.max(
        260,
        baseDuration *
          Math.abs(distance)
      );

      const startTime =
        performance.now();

      const animate = (
        currentTime: number
      ) => {
        const elapsed =
          currentTime - startTime;

        const timeProgress =
          clamp(
            elapsed / duration
          );

        const eased =
          target === 1
            ? easeOutQuint(
                timeProgress
              )
            : easeInOutCubic(
                timeProgress
              );

        progress = clamp(
          startProgress +
            distance * eased
        );

        wheelTarget = progress;

        render();

        if (timeProgress < 1) {
          snapFrame =
            requestAnimationFrame(
              animate
            );

          return;
        }

        completeSnap(target);
      };

      snapFrame =
        requestAnimationFrame(
          animate
        );
    };

    const evaluateThreshold = (
      direction: number
    ) => {
      if (
        direction > 0 &&
        progress >=
          FORWARD_THRESHOLD
      ) {
        snapTo(1);
        return true;
      }

      if (
        direction < 0 &&
        progress <=
          BACKWARD_THRESHOLD
      ) {
        snapTo(0);
        return true;
      }

      return false;
    };

    /*
     * PCホイール用。
     *
     * wheelTargetへ入力を蓄積し、
     * progressが滑らかに追従する。
     */
    const startWheelInterpolation = (
      direction: number
    ) => {
      cancelRenderFrame();

      const animate = () => {
        if (isSnapping) {
          renderFrame = 0;
          return;
        }

        const difference =
          wheelTarget - progress;

        progress +=
          difference * 0.18;

        if (
          Math.abs(difference) <
          0.001
        ) {
          progress =
            wheelTarget;
        }

        progress =
          clamp(progress);

        /*
         * ロビー最奥から少しでも戻り始めたら、
         * 画像の固定200ms退館演出を開始する。
         */
        if (
          progress < 1 &&
          isLobbyVisible
        ) {
          hideLobbyAndHeader();
        }

        render();

        if (
          evaluateThreshold(
            direction
          )
        ) {
          renderFrame = 0;
          return;
        }

        if (
          Math.abs(
            wheelTarget -
              progress
          ) > 0.001
        ) {
          renderFrame =
            requestAnimationFrame(
              animate
            );

          return;
        }

        renderFrame = 0;
      };

      renderFrame =
        requestAnimationFrame(
          animate
        );
    };

    const handleWheel = (
      event: WheelEvent
    ) => {
      event.preventDefault();

      if (
        Math.abs(
          event.deltaY
        ) < 0.5
      ) {
        return;
      }

      const direction =
        Math.sign(
          event.deltaY
        );

      if (isSnapping) {
        const isReversing =
          (snapTarget === 1 &&
            direction < 0) ||
          (snapTarget === 0 &&
            direction > 0);

        if (!isReversing) {
          return;
        }

        cancelSnap();

        if (direction < 0) {
          hideLobbyAndHeader();
        }
      }

      const normalizedDelta =
        Math.min(
          Math.max(
            Math.abs(
              event.deltaY
            ),
            22
          ),
          120
        );

      wheelTarget = clamp(
        wheelTarget +
          (direction *
            normalizedDelta) /
            WHEEL_DISTANCE
      );

      startWheelInterpolation(
        direction
      );

      window.clearTimeout(
        wheelEndTimer
      );

      wheelEndTimer =
        window.setTimeout(() => {
          evaluateThreshold(
            direction
          );
        }, 70);
    };
        const handleTouchStart = (
      event: TouchEvent
    ) => {
      if (
        event.touches.length !== 1
      ) {
        return;
      }

      const touchY =
        event.touches[0].clientY;

      isTouching = true;
      touchStartY = touchY;
      touchLastY = touchY;
      touchStartProgress = progress;
      touchDirection = 0;

      cancelRenderFrame();

      if (isSnapping) {
        cancelSnap();
      }
    };

    const handleTouchMove = (
      event: TouchEvent
    ) => {
      if (
        !isTouching ||
        event.touches.length !== 1
      ) {
        return;
      }

      event.preventDefault();

      const touchY =
        event.touches[0].clientY;

      const totalDistance =
        touchStartY - touchY;

      const frameDistance =
        touchLastY - touchY;

      touchLastY = touchY;

      if (
        Math.abs(frameDistance) >
        0.5
      ) {
        touchDirection =
          Math.sign(
            frameDistance
          );
      }

      progress = clamp(
        touchStartProgress +
          totalDistance /
            TOUCH_DISTANCE
      );

      wheelTarget = progress;

      /*
       * ロビー最奥から少しでも戻り始めたら、
       * 画像だけ先に固定200msで
       * フェードアウト・縮小する。
       *
       * 入口ロゴへ戻る遷移自体は、
       * 引き続き指の動きとprogressへ追従する。
       */
      if (
        progress < 1 &&
        isLobbyVisible
      ) {
        hideLobbyAndHeader();
      }

      render();

      if (
        evaluateThreshold(
          touchDirection
        )
      ) {
        isTouching = false;
      }
    };

    const handleTouchEnd = () => {
      if (!isTouching) {
        return;
      }

      isTouching = false;

      /*
       * 閾値を超えていれば、
       * 残りを自動遷移させる。
       *
       * 閾値未満なら、
       * 現在位置に留まる。
       */
      evaluateThreshold(
        touchDirection
      );
    };

    const handleKeyDown = (
      event: KeyboardEvent
    ) => {
      const forwardKeys = [
        "ArrowDown",
        "PageDown",
        " ",
        "Enter",
      ];

      const backwardKeys = [
        "ArrowUp",
        "PageUp",
        "Escape",
      ];

      const isForward =
        forwardKeys.includes(
          event.key
        );

      const isBackward =
        backwardKeys.includes(
          event.key
        );

      if (
        !isForward &&
        !isBackward
      ) {
        return;
      }

      event.preventDefault();

      if (isForward) {
        snapTo(1);
      } else {
        snapTo(0);
      }
    };

    const cleanup = () => {
      cancelRenderFrame();
      cancelSnap();

      window.clearTimeout(
        wheelEndTimer
      );

      window.removeEventListener(
        "wheel",
        handleWheel
      );

      window.removeEventListener(
        "touchstart",
        handleTouchStart
      );

      window.removeEventListener(
        "touchmove",
        handleTouchMove
      );

      window.removeEventListener(
        "touchend",
        handleTouchEnd
      );

      window.removeEventListener(
        "touchcancel",
        handleTouchEnd
      );

      window.removeEventListener(
        "keydown",
        handleKeyDown
      );

      document.removeEventListener(
        "astro:before-swap",
        cleanup
      );
    };

    /*
     * 初期状態。
     *
     * 画像は非表示、
     * 入口ロゴは表示状態から開始する。
     */
    if (lobby) {
      lobby.style.transition = "none";
      lobby.style.opacity = "0";
      lobby.style.transform =
        "scale(0.75)";
    }

    render();
    hideLobbyAndHeader();

    window.addEventListener(
      "wheel",
      handleWheel,
      {
        passive: false,
      }
    );

    window.addEventListener(
      "touchstart",
      handleTouchStart,
      {
        passive: true,
      }
    );

    window.addEventListener(
      "touchmove",
      handleTouchMove,
      {
        passive: false,
      }
    );

    window.addEventListener(
      "touchend",
      handleTouchEnd,
      {
        passive: true,
      }
    );

    window.addEventListener(
      "touchcancel",
      handleTouchEnd,
      {
        passive: true,
      }
    );

    window.addEventListener(
      "keydown",
      handleKeyDown
    );

    document.addEventListener(
      "astro:before-swap",
      cleanup
    );
  }
</script>

<style>
  .entrance-experience {
    --logo-scale: 1;
    --logo-opacity: 1;
    --veil-opacity: 0;

    --desktop-height-px: 620px;
    --desktop-height-vh: 60vh;

    position: fixed;
    inset: 0;
    z-index: 1;

    width: 100%;
    height: 100svh;

    overflow: hidden;
    overscroll-behavior: none;
    touch-action: none;

    background: #fff;
  }

  .entrance-experience__lobby {
    position: absolute;
    inset: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    opacity: 0;
    transform: scale(0.75);
    transform-origin: center;

    background: #fff;

    will-change:
      opacity,
      transform;

    pointer-events: none;
  }

  .entrance-experience__lobby-image {
    display: block;

    width: auto;
    max-width: 100%;

    height: min(
      var(--desktop-height-vh),
      var(--desktop-height-px)
    );

    max-height: 100svh;

    object-fit: contain;

    pointer-events: none;
    user-select: none;
  }

  .entrance-experience__veil {
    position: absolute;
    inset: 0;

    opacity: calc(
      var(--veil-opacity) * 0.1
    );

    background: #fff;

    pointer-events: none;

    will-change: opacity;
  }

  .entrance-experience__logo {
    position: absolute;
    top: 50%;
    left: 50%;

    width: min(
      680px,
      calc(100vw - 48px)
    );

    height: auto;
    overflow: visible;

    opacity:
      var(
        --logo-opacity
      );

    transform:
      translate(-50%, -50%)
      scale(
        var(--logo-scale)
      );

    transform-origin: center;

    pointer-events: none;
    user-select: none;

    will-change:
      transform,
      opacity;
  }

  .entrance-experience__logo-text {
    fill:
      var(
        --navigation-color
      );

    font-family:
      var(
        --site-font-family
      );

    font-size: 34px;
    font-weight: 400;
    letter-spacing: 0.08em;
  }

  /*
   * タブレット・スマホでは、
   * 画像幅100%・高さ自動。
   */
  @media (max-width: 1024px) {
    .entrance-experience__lobby-image {
      width: 100%;
      max-width: none;

      height: auto;
      max-height: 100svh;

      object-fit: contain;
    }
  }

  @media (max-width: 640px) {
    .entrance-experience__logo {
      width: calc(
        100vw - 32px
      );
    }

    .entrance-experience__logo-text {
      font-size: 32px;
    }
  }

  @media (
    prefers-reduced-motion:
    reduce
  ) {
    .entrance-experience__lobby {
      transition-duration: 1ms !important;
    }
  }
</style>